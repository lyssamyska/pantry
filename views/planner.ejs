      font-size: 0.875rem;
      font-weight: 600;
      font-family: 'DM Sans', sans-serif;
      cursor: pointer;
      transition: background 0.2s;
    }
    .btn-use-recipes:hover { background: var(--green-light); }
    .btn-use-recipes:disabled { opacity: 0.4; cursor: not-allowed; }

    /* Import from URL */
    .import-section { margin-top: 16px; }
    .import-toggle {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 14px 20px;
      border-radius: 12px;
      border: 1.5px dashed var(--divider);
      background: var(--cream);
      cursor: pointer;
      font-size: 0.875rem;
      font-weight: 500;
      color: var(--warm-gray);
      font-family: 'DM Sans', sans-serif;
      transition: all 0.2s;
      width: 100%;
      text-align: left;
    }
    .import-toggle:hover { border-color: var(--green); color: var(--green); }
    .import-toggle svg { flex-shrink: 0; }
    .import-toggle.open { border-color: var(--green); background: var(--green-pale); color: var(--green); }

    .import-panel {
      display: none;
      background: white;
      border-radius: 16px;
      border: 1px solid var(--divider);
      padding: 28px;
      margin-top: 12px;
      box-shadow: 0 2px 12px rgba(0,0,0,0.04);
    }
    .import-panel.open { display: block; }

    .import-url-row { display: flex; gap: 12px; }
    .import-url-row input {
      flex: 1;
      padding: 12px 16px;
      border: 1.5px solid var(--divider);
      border-radius: 10px;
      font-size: 0.9rem;
      font-family: 'DM Sans', sans-serif;
      background: var(--cream);
      color: var(--near-black);
    }
    .import-url-row input:focus { outline: none; border-color: var(--green); }
    .btn-import {
      background: var(--sienna);
      color: white;
      border: none;
      padding: 12px 24px;
      border-radius: 10px;
      font-size: 0.9rem;
      font-weight: 600;
      font-family: 'DM Sans', sans-serif;
      cursor: pointer;
      transition: background 0.2s;
      white-space: nowrap;
    }
    .btn-import:hover { background: var(--sienna-light); }
    .btn-import:disabled { opacity: 0.5; cursor: not-allowed; }
    .import-hint { font-size: 0.75rem; color: var(--light-gray); margin-top: 8px; }

    /* Import preview */
    .import-preview { display: none; margin-top: 20px; border-top: 1.5px solid var(--divider); padding-top: 20px; }
    .import-preview.visible { display: block; }
    .import-preview-header { display: flex; align-items: flex-start; gap: 16px; margin-bottom: 16px; }
    .import-preview-img { width: 80px; height: 80px; border-radius: 10px; object-fit: cover; background: var(--cream-dark); flex-shrink: 0; }
    .import-preview-name { font-family: 'Fraunces', serif; font-size: 1.1rem; font-weight: 700; color: var(--near-black); }
    .import-preview-meta { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 6px; }
    .quality-badge {
      font-size: 0.7rem;
      font-weight: 600;
      padding: 3px 8px;
      border-radius: 4px;
    }
    .quality-schema { background: var(--green-pale); color: var(--green); }
    .quality-full { background: #EEF2FF; color: #4338CA; }
    .quality-partial { background: #FDF3E8; color: #9A5220; }
    .quality-microdata { background: var(--green-pale); color: var(--green); }
    .import-compliance { margin-top: 12px; padding: 10px 12px; border-radius: 8px; font-size: 0.85rem; }
    .import-compliance--ok { background: var(--green-pale); color: var(--green); }
    .import-compliance--warn { background: #FDF3E8; color: #9A5220; }
    .import-compliance ul { margin: 6px 0 0 18px; padding: 0; }
    .import-compliance-tags { font-weight: 600; }

    .import-fields { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    .import-field { display: flex; flex-direction: column; gap: 6px; }
    .import-field label { font-size: 0.75rem; font-weight: 600; color: var(--warm-gray); text-transform: uppercase; letter-spacing: 0.05em; }
    .import-field input, .import-field select {
      padding: 10px 12px;
      border: 1.5px solid var(--divider);
      border-radius: 8px;
      font-size: 0.875rem;
      font-family: 'DM Sans', sans-serif;
      background: var(--cream);
    }
    .import-field input:focus, .import-field select:focus { outline: none; border-color: var(--green); }

    .import-ingredients { margin-top: 16px; }
    .import-ingredients label { display: block; font-size: 0.75rem; font-weight: 600; color: var(--warm-gray); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 8px; }
    .ingredient-list { display: flex; flex-direction: column; gap: 6px; max-height: 180px; overflow-y: auto; }
    .ingredient-chip {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 8px 12px;
      background: var(--cream);
      border-radius: 8px;
      font-size: 0.85rem;
    }
    .ingredient-chip .ing-dot { width: 5px; height: 5px; border-radius: 50%; background: var(--green); flex-shrink: 0; }
    .ingredient-chip .ing-text { flex: 1; }

    .import-actions { display: flex; gap: 12px; margin-top: 20px; }
    .btn-save-recipe {
      background: var(--green);
      color: white;
      border: none;
      padding: 12px 28px;
      border-radius: 10px;
      font-size: 0.9rem;
      font-weight: 600;
      font-family: 'DM Sans', sans-serif;
      cursor: pointer;
      transition: background 0.2s;
    }
    .btn-save-recipe:hover { background: var(--green-light); }
    .btn-cancel-import {
      background: white;
      border: 1.5px solid var(--divider);
      color: var(--warm-gray);
      padding: 12px 20px;
      border-radius: 10px;
      font-size: 0.9rem;
      font-weight: 500;
      font-family: 'DM Sans', sans-serif;
      cursor: pointer;
    }
    .btn-cancel-import:hover { border-color: var(--green); color: var(--green); }

    .post-save-prompt {
      display: none;
      align-items: center;
      gap: 12px;
      margin-top: 16px;
      padding: 16px 20px;
      background: var(--green-pale);
      border: 1.5px solid rgba(42,77,30,0.2);
      border-radius: 12px;
      animation: slideIn 0.25s ease;
    }
    .post-save-prompt.visible { display: flex; }
    @keyframes slideIn {
      from { opacity: 0; transform: translateY(-6px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .post-save-prompt-text { font-size: 0.9rem; font-weight: 600; color: var(--green); flex: 1; }
    .btn-add-to-plan {
      background: var(--green);
      color: white;
      border: none;
      padding: 10px 20px;
      border-radius: 8px;
      font-size: 0.85rem;
      font-weight: 600;
      font-family: 'DM Sans', sans-serif;
      cursor: pointer;
      transition: background 0.2s;
    }
    .btn-add-to-plan:hover { background: var(--green-light); }
    .btn-add-to-plan:disabled { background: var(--light-gray); cursor: not-allowed; }
    .btn-dismiss-plan {
      background: white;
      border: 1.5px solid rgba(42,77,30,0.2);
      color: var(--warm-gray);
      padding: 10px 16px;
      border-radius: 8px;
      font-size: 0.85rem;
      font-weight: 500;
      font-family: 'DM Sans', sans-serif;
      cursor: pointer;
    }
    .btn-dismiss-plan:hover { border-color: var(--green); color: var(--green); }

    .import-error {
      padding: 12px 16px;
      background: #FDF3E8;
      border: 1px solid rgba(200,86,26,0.2);
      border-radius: 10px;
      color: var(--sienna);
      font-size: 0.875rem;
      margin-top: 12px;
    }

    .import-loading { display: none; align-items: center; gap: 8px; font-size: 0.875rem; color: var(--warm-gray); margin-top: 8px; }
    .import-loading.visible { display: flex; }

    /* Discover Recipes panel */
    .discovery-section { margin-top: 16px; }
    .discovery-toggle {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 14px 20px;
      border-radius: 12px;
      border: 1.5px dashed var(--divider);
      background: var(--cream);
      cursor: pointer;
      font-size: 0.875rem;
      font-weight: 500;
      color: var(--warm-gray);
      font-family: 'DM Sans', sans-serif;
      transition: all 0.2s;
      width: 100%;
      text-align: left;
    }
    .discovery-toggle:hover { border-color: var(--green); color: var(--green); }
    .discovery-toggle.open { border-color: var(--green); background: var(--green-pale); color: var(--green); }
    .discovery-toggle svg { flex-shrink: 0; }
    .discovery-panel { display: none; }
    .discovery-panel.open { display: block; }
    .recipe-pool-source-bookmark {
      font-size: 0.68rem;
      font-weight: 600;
      padding: 1px 7px;
      border-radius: 4px;
      background: var(--green-pale);
      color: var(--green);
    }
    .discovery-add-btn {
      background: var(--green);
      color: white;
      border: none;
      padding: 8px 16px;
      border-radius: 8px;
      font-size: 0.8rem;
      font-weight: 600;
      font-family: 'DM Sans', sans-serif;
      cursor: pointer;
      transition: background 0.2s;
      flex-shrink: 0;
    }
    .discovery-add-btn:hover { background: var(--green-light); }
    .discovery-add-btn:disabled { opacity: 0.5; cursor: not-allowed; }
    .discovery-empty {
      grid-column: 1/-1;
      text-align: center;
      padding: 40px 20px;
      color: var(--light-gray);
    }
    .discovery-empty strong { display: block; color: var(--warm-gray); font-weight: 600; margin-bottom: 4px; }

    /* Recipe Detail Modal */
    .recipe-modal-overlay {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(26,26,24,0.55);
      backdrop-filter: blur(4px);
      z-index: 200;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }
    .recipe-modal-overlay.open { display: flex; }

    .swap-chooser {
      max-width: 520px;
      padding-bottom: 22px;
    }
    .swap-chooser .recipe-modal-header { padding-bottom: 18px; }
    .swap-option-list { display: grid; gap: 8px; padding: 0 28px; }
    .swap-option {
      width: 100%;
      padding: 12px 14px;
      border: 1px solid var(--divider);
      border-radius: 9px;
      background: white;
      color: var(--near-black);
      text-align: left;
      font: inherit;
      cursor: pointer;
      transition: background 0.2s, border-color 0.2s;
    }
    .swap-option:hover { background: var(--cream); border-color: var(--green-light); }
    .swap-option-name { display: block; font-size: 0.9rem; font-weight: 600; }
    .swap-option-meta { display: block; margin-top: 3px; color: var(--warm-gray); font-size: 0.75rem; }
    .swap-chooser-status { padding: 0 28px 8px; color: var(--warm-gray); font-size: 0.85rem; }
    .swap-chooser-status:empty { display: none; }
    .swap-chooser-status.error { color: var(--sienna); }

    .recipe-modal {
      background: white;
      border-radius: 20px;
      max-width: 600px;
      width: 100%;
      max-height: 85vh;
      overflow-y: auto;
      position: relative;
      box-shadow: 0 24px 60px rgba(0,0,0,0.18);
    }

    .recipe-modal-header {
      padding: 28px 28px 0;
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 16px;
    }
    .recipe-modal-title {
      font-family: 'Fraunces', serif;
      font-size: 1.4rem;
      font-weight: 800;
      color: var(--near-black);
      line-height: 1.2;
    }
    .recipe-modal-close {
      background: none;
      border: none;
      cursor: pointer;
      color: var(--light-gray);
      padding: 4px;
      border-radius: 8px;
      transition: color 0.2s, background 0.2s;
      flex-shrink: 0;
      line-height: 0;
    }
    .recipe-modal-close:hover { color: var(--near-black); background: var(--cream-dark); }
    .recipe-modal-close:focus-visible { outline: 2px solid var(--sienna); outline-offset: 2px; }

    .recipe-modal-meta {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      padding: 12px 28px 0;
      align-items: center;
    }
    .recipe-modal-meta .day-tag { font-size: 0.78rem; }

    .recipe-modal-desc {
      padding: 12px 28px 0;
      font-size: 0.9rem;
      color: var(--warm-gray);
      line-height: 1.5;
    }

    .recipe-modal-divider {
      height: 1px;
      background: var(--divider);
      margin: 20px 28px;
    }

    .recipe-modal-section { padding: 0 28px 20px; }
    .recipe-modal-section-title {
      font-size: 0.72rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--light-gray);
      margin-bottom: 12px;
    }

    .recipe-ingredients-list { display: flex; flex-direction: column; gap: 8px; }
    .recipe-ingredient {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      padding: 8px 12px;
      background: var(--cream);
      border-radius: 8px;
    }
    .recipe-ingredient .ing-dot { width: 5px; height: 5px; border-radius: 50%; background: var(--green); flex-shrink: 0; margin-top: 6px; }
    .recipe-ingredient-name { font-size: 0.9rem; color: var(--near-black); font-weight: 500; }
    .recipe-ingredient-qty { font-size: 0.8rem; color: var(--light-gray); margin-left: auto; white-space: nowrap; }
    .recipe-ingredient-hint { font-size: 0.75rem; color: var(--sienna); font-style: italic; }

    .recipe-steps-list { display: flex; flex-direction: column; gap: 14px; }
    .recipe-step {
      display: flex;
      gap: 14px;
      align-items: flex-start;
    }
    .recipe-step-num {
      width: 28px;
      height: 28px;
      border-radius: 50%;
      background: var(--green);
      color: white;
      font-size: 0.78rem;
      font-weight: 700;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      margin-top: 1px;
    }
    .recipe-step-text { font-size: 0.9rem; color: var(--near-black); line-height: 1.55; padding-top: 3px; }

    .recipe-modal-footer {
      padding: 0 28px 28px;
      display: flex;
      gap: 12px;
      align-items: center;
    }
    .recipe-modal-star {
      background: none;
      border: 1.5px solid var(--divider);
      border-radius: 8px;
      padding: 10px 16px;
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 0.875rem;
      font-weight: 500;
      font-family: 'DM Sans', sans-serif;
      color: var(--warm-gray);
      cursor: pointer;
      transition: all 0.2s;
    }
    .recipe-modal-star:hover { border-color: var(--sienna); color: var(--sienna); }
    .recipe-modal-star.bookmarked { border-color: var(--sienna); color: var(--sienna); background: #FDF3E8; }
    .recipe-modal-star svg { line-height: 0; }

    @media (max-width: 768px) {
      nav { padding: 16px 24px; }
      .planner-hero { padding: 100px 24px 40px; }
      .form-grid { grid-template-columns: 1fr; }
      .results-grid { grid-template-columns: 1fr; }
      .results-header { align-items: flex-start; gap: 16px; }
      .section-header-actions { flex: 1 1 100%; margin-left: 0; }
      .stats-row { flex-wrap: wrap; gap: 8px 12px; }
      .sunday-plan-card { padding: 18px; }
      .sunday-plan-sections { grid-template-columns: 1fr; }
      .planner-form { padding: 24px; }
      .planner-empty-state { padding: 24px; }
      .saved-plans-panel-inner { padding: 18px; }
      .saved-plan-date { max-width: 34vw; white-space: normal; }
      .import-url-row { flex-direction: column; }
      .import-fields { grid-template-columns: 1fr; }
      .pantry-form, .pantry-row { grid-template-columns: 1fr; }
      .pantry-row-actions { justify-content: flex-start; }
      .meal-details { margin-top: 10px; }
      .swap-chooser { max-height: 90vh; }
      .swap-option-list { padding: 0 20px; }
      .swap-chooser .recipe-modal-header { padding: 20px 20px 16px; }
      .swap-chooser-status { padding: 0 20px 8px; }
      .grocery-progress-actions { align-items: flex-start; }
      .grocery-search-input { max-width: none; }
      .grocery-store-header {
        align-items: center;
        min-height: 44px;
        padding: 10px 0;
      }
      .grocery-store-name {
        min-width: 0;
        overflow-wrap: anywhere;
      }
      .grocery-store-subtotal { flex-shrink: 0; }
      .grocery-store-subtotal { max-width: 58%; text-align: right; white-space: normal; }
      .grocery-item { align-items: flex-start; flex-wrap: wrap; }
      .grocery-qty { max-width: 100px; text-align: right; }
      .grocery-price-inline { max-width: 112px; text-align: right; white-space: normal; }
      .grocery-pantry-action {
        flex-basis: 100%;
        margin-left: 26px;
        align-items: flex-start;
      }
      .grocery-pantry-action-error { max-width: none; text-align: left; }
    }

    @media (max-width: 560px) {
      nav { padding: 12px; gap: 4px; }
      .nav-links { gap: 10px; }
      .nav-links a { font-size: 0.74rem; }
      .nav-links li:nth-child(1), .nav-links li:nth-child(2) { display: none; }
      .nav-cta { padding: 7px 8px; font-size: 0.72rem; }
      .saved-plan-button { grid-template-columns: minmax(0, 1fr); }
      .saved-plan-date { max-width: none; text-align: left; }
    }

    @media print {
      @page { margin: 0.5in; }

      body {
        background: white;
        color: #000;
      }
      nav,
      .planner-hero > h1,
      .planner-hero > p,
      #emptyState,
      #plannerForm,
      .csa-section,
      .pantry-section,
      .import-section,
      .my-recipes-section,
      .saved-plans-section,
      .results-header,
      .results-section--meal-plan,
      .sunday-plan-card,
      .grocery-list-actions,
      .grocery-progress-actions,
      .grocery-search-controls,
      .grocery-custom-item-form,
      .grocery-search-no-match,
      .discovery-section,
      .recipe-modal-overlay {
        display: none !important;
      }
      .planner-hero {
        max-width: none;
        padding: 0;
        margin: 0;
      }
      #results,
      #results.visible {
        display: block !important;
      }
      .results-grid {
        display: block;
      }
      .results-section--grocery-list {
        display: block;
      }
      .results-section--grocery-list .section-header {
        padding-bottom: 8px;
        border-bottom-color: #000;
      }
      .results-section--grocery-list .section-icon {
        display: none;
      }
      .grocery-store {
        margin-bottom: 18px;
        break-inside: avoid;
        page-break-inside: avoid;
      }
      .grocery-store-header {
        margin-bottom: 6px;
        padding-bottom: 6px;
        border-bottom-color: #000;
        cursor: default;
        pointer-events: none;
      }
      .grocery-store-toggle-icon { display: none; }
      .grocery-store-items {
        display: block !important;
      }
      .grocery-item,
      .grocery-category {
        break-inside: avoid;
        page-break-inside: avoid;
      }
      .grocery-check { display: none; }
      .grocery-pantry-action { display: none !important; }
      .grocery-note-input { display: none !important; }
      .grocery-note-print:not([hidden]) {
        display: block;
        margin-top: 2px;
        color: #444;
        font-size: 0.78rem;
      }
      .grocery-print-state {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 18px;
        flex: 0 0 18px;
        color: #000;
        font-size: 1rem;
        line-height: 1;
      }
      .grocery-item.grocery-item-checked .grocery-name,
      .grocery-item.grocery-item-checked .grocery-qty,
      .grocery-item.grocery-item-checked .grocery-price-inline {
        opacity: 1;
      }
      #groceryCostSummary {
        display: flex !important;
        break-inside: avoid;
        page-break-inside: avoid;
      }
    }
  </style>
</head>
<body>
  <nav>
    <div class="nav-logo">Pantry<span>.</span></div>
    <ul class="nav-links">
      <li><a href="/#how">How it works</a></li>
      <li><a href="/#this-week">This week's deals</a></li>
      <li><a href="/pantry">Pantry</a></li>
    </ul>
    <% if (userId) { %>
      <a href="/profile" class="nav-cta">Profile</a>
      <button type="button" class="nav-cta" onclick="signOut()">Sign out</button>
    <% } else { %>
      <a href="/?account=1" class="nav-cta">Sign in</a>
    <% } %>
  </nav>

  <div class="planner-hero">
    <h1>Build your <em>week.</em></h1>
    <p>Tell us what you need — we'll generate a 7-day dinner plan and a smart grocery list, quality sourcing built in.</p>

    <div class="planner-form" id="plannerForm" aria-busy="false">
      <div class="form-grid">
        <div class="form-group">
          <label for="dinners">Dinners needed</label>
          <% const configuredDinners = Number(mealCountDefaults && mealCountDefaults.dinners); %>
          <% const defaultDinners = Number.isInteger(configuredDinners) && configuredDinners >= 1 && configuredDinners <= 7 ? configuredDinners : 7; %>
          <select id="dinners">
            <% for (let dinnerCount = 1; dinnerCount <= 7; dinnerCount++) { %>
              <option value="<%= dinnerCount %>" <%= defaultDinners === dinnerCount ? 'selected' : '' %>><%= dinnerCount %> dinners</option>
            <% } %>
          </select>
        </div>
        <div class="form-group">
          <label for="servings">People / servings</label>
          <input type="number" id="servings" min="1" max="12" step="1" value="2" inputmode="numeric">
        </div>
        <div class="form-group">
          <label for="mustHave">Must-have meals (optional)</label>
          <input type="text" id="mustHave" placeholder="e.g. salmon tacos, stir-fry...">
        </div>
        <div class="form-group">
          <label for="mustHaveIngredients">Required ingredients (optional)</label>
          <input type="text" id="mustHaveIngredients" placeholder="e.g. sweet potato meatballs, kale...">
        </div>
        <div class="form-group">
          <label for="weeklyBudgetTarget">Weekly grocery budget (optional)</label>
          <input type="number" id="weeklyBudgetTarget" min="0" step="0.01" inputmode="decimal" placeholder="$150.00">
        </div>
        <div class="form-group full">
          <label>Dietary preferences</label>
          <div class="dietary-flags">
            <label class="flag-chip"><input type="checkbox" value="gluten-free" <%= (dietPreferences && dietPreferences.includes('gluten-free')) ? 'checked' : '' %>> Gluten-free</label>
            <label class="flag-chip"><input type="checkbox" value="dairy-free" <%= (dietPreferences && dietPreferences.includes('dairy-free')) ? 'checked' : '' %>> Dairy-free</label>
            <label class="flag-chip"><input type="checkbox" value="sugar-free" <%= (dietPreferences && dietPreferences.includes('sugar-free')) ? 'checked' : '' %>> Sugar-free</label>
            <label class="flag-chip"><input type="checkbox" value="vegetarian" <%= (dietPreferences && dietPreferences.includes('vegetarian')) ? 'checked' : '' %>> Vegetarian</label>
            <label class="flag-chip"><input type="checkbox" value="vegan" <%= (dietPreferences && dietPreferences.includes('vegan')) ? 'checked' : '' %>> Vegan</label>
          </div>
        </div>
        <div class="form-group full">
          <label for="avoidIngredients">Ingredients to avoid (optional)</label>
          <input type="text" id="avoidIngredients" placeholder="e.g. pork, shellfish, nuts...">
        </div>
        <div class="form-group full">
          <div class="sourcing-row">
            <input type="checkbox" id="preferSourcing" checked>
            <label for="preferSourcing">Prefer grass-fed beef, pastured chicken, and wild-caught fish (Pantry Standard)</label>
          </div>
        </div>
      </div>
      <div style="margin-top: 28px;">
        <button type="button" class="btn-generate" id="generateBtn" onclick="generatePlan()">
          <span class="btn-text">Generate my meal plan</span>
          <span class="loading"><span class="spinner" aria-hidden="true"></span> Building…</span>
        </button>
      </div>
    </div>

    <div class="csa-section">
      <button class="import-toggle" id="csaToggle" onclick="toggleCsa()">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
        This week's CSA box
        <span class="my-recipes-badge" id="csaCount" style="display:none;">0</span>
      </button>

      <div class="import-panel" id="csaPanel">
        <div style="margin-bottom: 14px;">
          <div style="font-family: 'Fraunces', serif; font-size: 1rem; font-weight: 700; color: var(--near-black);">What's coming in your CSA share?</div>
          <div style="font-size: 0.8rem; color: var(--light-gray); margin-top: 4px;">Add produce you're already getting this week — we'll mark matching recipe ingredients as covered.</div>
        </div>
        <div class="import-url-row">
          <input type="text" id="csaItemInput" placeholder="e.g. zucchini, kale, basil" />
          <button class="btn-import" id="csaAddBtn" onclick="addCsaItem()">Add</button>
        </div>
        <div class="csa-error" id="csaError" style="display:none;"></div>
        <div class="csa-chips" id="csaChips"></div>
      </div>
    </div>

    <div class="pantry-section">
      <button class="import-toggle" id="pantryToggle" onclick="togglePantry()" aria-controls="pantryPanel" aria-expanded="false">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 7h16M6 7v12h12V7M9 7V4h6v3M9 11v4M12 11v4M15 11v4"/></svg>
        Pantry inventory
        <span class="my-recipes-badge" id="pantryCount" style="display:none;">0</span>
      </button>

      <div class="import-panel" id="pantryPanel">
        <div style="margin-bottom: 14px;">
          <div style="font-family: 'Fraunces', serif; font-size: 1rem; font-weight: 700; color: var(--near-black);">What do you already have?</div>
          <div style="font-size: 0.8rem; color: var(--light-gray); margin-top: 4px;">Keep your pantry current so matching ingredients stay out of your grocery list.</div>
        </div>
        <form class="pantry-form" id="pantryForm">
          <div class="pantry-field">
            <label for="pantryNameInput">Item name</label>
            <input type="text" id="pantryNameInput" data-pantry-field="name" placeholder="e.g. olive oil" autocomplete="off" />
            <span class="pantry-field-error" id="pantryNameError" hidden></span>
          </div>
          <div class="pantry-field">
            <label for="pantryQuantityInput">Quantity</label>
            <input type="text" id="pantryQuantityInput" data-pantry-field="quantity" placeholder="e.g. 1" autocomplete="off" />
            <span class="pantry-field-error" id="pantryQuantityError" hidden></span>
          </div>
          <div class="pantry-field">
            <label for="pantryUnitInput">Unit</label>
            <input type="text" id="pantryUnitInput" data-pantry-field="unit" placeholder="e.g. bottle" autocomplete="off" />
            <span class="pantry-field-error" id="pantryUnitError" hidden></span>
          </div>
          <button type="submit" class="pantry-add-btn" id="pantryAddBtn">Add item</button>
        </form>
        <div class="pantry-status" id="pantryStatus" aria-live="polite"></div>
        <div class="pantry-list" id="pantryList"></div>
      </div>
    </div>

    <div class="import-section">
      <button class="import-toggle" id="importToggle" onclick="toggleImport()">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
        Import from URL
      </button>

      <div class="import-panel" id="importPanel">
        <div style="margin-bottom: 14px;">
          <div style="font-family: 'Fraunces', serif; font-size: 1rem; font-weight: 700; color: var(--near-black);">Paste a recipe link</div>
          <div style="font-size: 0.8rem; color: var(--light-gray); margin-top: 4px;">Supports NYT Cooking, AllRecipes, Serious Eats, Food Network, and more</div>
        </div>
        <div class="import-url-row">
          <input type="url" id="importUrl" placeholder="https://www.nytimes.com/..." />
          <button class="btn-import" id="importBtn" onclick="importRecipe()">Import</button>
        </div>
        <div class="import-loading" id="importLoading">
          <span class="spinner" style="border-top-color: var(--green); border-color: var(--divider);"></span>
          Fetching and parsing recipe…
        </div>
        <div class="import-hint" id="importHint">Works best with sites that use structured recipe data (most major publishers)</div>
        <div class="import-error" id="importError" style="display:none;"></div>

        <div class="import-preview" id="importPreview">
          <div class="import-preview-header">
            <img class="import-preview-img" id="importImg" src="" alt="Recipe image" style="display:none;" />
            <div>
              <div class="import-preview-name" id="importName"></div>
              <div class="import-preview-meta">
                <span class="quality-badge quality-schema" id="qualityBadge"></span>
                <span style="font-size:0.75rem;color:var(--light-gray);" id="importMeta"></span>
              </div>
            </div>
          </div>

          <div class="import-fields">
            <div class="import-field">
              <label>Recipe name</label>
              <input type="text" id="importNameInput" />
            </div>
            <div class="import-field">
              <label>Prep time (min)</label>
              <input type="number" id="importPrepTime" placeholder="e.g. 15" />
            </div>
            <div class="import-field">
              <label>Cook time (min)</label>
              <input type="number" id="importCookTime" placeholder="e.g. 30" />
            </div>
            <div class="import-field">
              <label>Protein type</label>
              <select id="importProteinType">
                <option value="">— not set —</option>
                <option value="beef">Beef</option>
                <option value="chicken">Chicken</option>
                <option value="pork">Pork</option>
                <option value="fish">Fish / Seafood</option>
                <option value="vegetarian">Vegetarian</option>
              </select>
            </div>
          </div>

          <div class="import-ingredients">
            <label>Ingredients (<span id="ingCount">0</span>)</label>
            <div class="ingredient-list" id="importIngredientsList"></div>
            <div class="import-compliance" id="importCompliance" role="status" style="display:none;"></div>
          </div>

          <div class="import-actions">
            <div class="import-prompt-copy" style="font-size:0.78rem; color: var(--warm-gray); margin-bottom: 10px;">Save this recipe to <strong>My Recipes</strong>, or discard?</div>
            <button class="btn-save-recipe" id="saveImportBtn" onclick="saveImportedRecipe()">Save to My Recipes</button>
            <button class="btn-cancel-import" onclick="cancelImport()">Discard</button>
          </div>

          <div class="post-save-prompt" id="postSavePrompt">
            <span class="post-save-prompt-text" id="postSaveText">Recipe added! Add to this week's meal plan?</span>
            <button class="btn-add-to-plan" id="btnYesAddToPlan" onclick="addLastImportedToPlan()">Yes, add it</button>
            <button class="btn-dismiss-plan" onclick="dismissAddToPlan()">No thanks</button>
          </div>
        </div>
      </div>
    </div>

    <div class="my-recipes-section">
      <button class="my-recipes-toggle" id="myRecipesToggle" onclick="toggleMyRecipes()">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        My Recipes
        <span class="my-recipes-badge" id="myRecipesBadge" style="display:none;">0</span>
      </button>
      <div class="my-recipes-panel" id="myRecipesPanel">
        <div class="my-recipes-panel-inner">
          <div class="my-recipes-header">
            <div>
              <div class="my-recipes-title">Recipe Box</div>
              <div class="my-recipes-subtitle">Select recipes to force-include in your plan</div>
            </div>
            <input type="text" class="my-recipes-search" id="myRecipesSearch" placeholder="Search recipes…" oninput="filterMyRecipes()">
          </div>
          <div class="my-recipes-tabs">
            <button class="my-recipes-tab active" id="tabBookmarked" onclick="switchMyRecipesTab('bookmarked')">Saved</button>
            <button class="my-recipes-tab" id="tabImported" onclick="switchMyRecipesTab('imported')">Imported</button>
          </div>
          <div class="my-recipes-grid" id="myRecipesGrid"></div>
          <div class="my-recipes-footer">
            <span class="my-recipes-count"><strong id="myRecipesSelectedCount">0</strong> selected</span>
            <div style="display:flex;gap:10px;">
              <button class="btn-cancel-import" onclick="clearMyRecipeSelection()">Clear</button>
              <button class="btn-use-recipes" id="btnUseRecipes" disabled onclick="generateWithMyRecipes()">Use selected</button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <% if (userId) { %>
      <div class="saved-plans-section" id="savedPlansSection">
        <div class="saved-plans-panel-inner">
          <div class="saved-plans-header">
            <div class="saved-plans-title">Saved plans</div>
            <div class="saved-plans-subtitle">Reopen a week you've saved</div>
          </div>
          <div class="saved-plans-state" id="savedPlansLoading" role="status" aria-live="polite">Loading saved plans…</div>
          <div class="saved-plans-state" id="savedPlansEmpty" hidden>No saved plans yet</div>
          <div class="saved-plans-state saved-plans-state--error" id="savedPlansError" role="alert" hidden></div>
          <div class="saved-plans-list" id="savedPlansList"></div>
        </div>
      </div>
    <% } %>

    <div id="results">
      <section class="planner-empty-state" id="emptyState" aria-labelledby="emptyStateTitle">
        <h2 id="emptyStateTitle">Build Your Week</h2>
        <p>No weekly plan is saved yet. Choose your preferences below and generate your first 7-day dinner plan and grocery list.</p>
        <p>Pantry handles the recipes, market-aware sourcing, and shopping list so you know what to cook next.</p>
        <ul class="empty-feature-list">
          <li><span><strong>Store-grouped grocery list</strong> — produce, meat, pantry, and frozen each in their own section so you can shop the aisles in one pass.</span></li>
          <li><span><strong>Per-meal cost</strong> — see an estimated price for each dinner based on current Austin market prices.</span></li>
          <li><span><strong>Pantry &amp; CSA exclusions</strong> — anything already in your pantry or arriving in your CSA box is filtered out automatically.</span></li>
        </ul>
        <button type="button" class="btn-start" onclick="document.getElementById('dinners').scrollIntoView({behavior:'smooth', block:'start'});">
          Build Your Week
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </button>
      </section>
      <div class="results-header">
        <div>
          <h2>Your weekly plan</h2>
          <div class="stats-row" id="statsRow"></div>
          <div class="last-generated" id="lastGenerated" hidden></div>
        </div>
        <div class="results-header-actions" style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;justify-content:flex-end;">
          <% if (userId) { %>
            <button class="print-btn" id="btnSavePlan" onclick="saveCurrentMealPlan()" style="display:none;" aria-label="Save weekly meal plan">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
              <span id="btnSavePlanLabel">Save plan</span>
            </button>
            <span class="copy-status" id="savePlanStatus" role="status" aria-live="polite" aria-atomic="true" hidden></span>
          <% } %>
          <button class="print-btn" id="btnExportCsv" onclick="window.location.href='/api/planner/plan/'+window._currentPlanId+'/export?format=csv'" style="display:none;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            CSV
          </button>
          <button class="print-btn" id="btnExportTxt" onclick="copyGroceryList()" style="display:none;" aria-label="Copy store-grouped grocery list to clipboard">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><rect x="8" y="2" width="8" height="4" rx="1" ry="1"/></svg>
            <span id="btnExportTxtLabel" aria-live="polite">Copy list</span>
          </button>
        </div>
      </div>
      <div class="results-grid">
        <div class="results-section results-section--meal-plan">
          <div class="section-header">
            <div class="section-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2A4D1E" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            </div>
            <h3>Dinner Plan</h3>
            <div class="section-header-actions">
              <button type="button" class="print-btn" id="btnCopyMealPlan" onclick="copyMealPlan()" style="display:none;" aria-label="Copy weekly meal plan to clipboard">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><rect x="8" y="2" width="8" height="4" rx="1" ry="1"/></svg>
                <span id="btnCopyMealPlanLabel">Copy meal plan</span>
              </button>
              <span class="copy-status" id="mealPlanCopyStatus" role="status" aria-live="polite" aria-atomic="true" hidden></span>
            </div>
          </div>
          <div id="daysList"></div>
        </div>
        <div class="results-section results-section--grocery-list">
          <div class="section-header">
            <div class="section-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2A4D1E" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
            </div>
            <h3>Grocery List</h3>
          </div>
          <div class="grocery-list-actions">
            <button type="button" class="print-btn" onclick="window.print()" aria-label="Print grocery list">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9V2h12v7M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2M6 14h12v8H6z"/></svg>
              Print grocery list
            </button>
          </div>
          <div class="sunday-plan-card" id="sundayPlanCard" aria-live="polite">
            <div class="sunday-plan-card-header">
              <div>
                <div class="sunday-plan-eyebrow">Sunday preview</div>
                <h4 class="sunday-plan-title">A quick sourcing pass for the week</h4>
                <p class="sunday-plan-intro">See what to pick up at the market, what’s marked down at H-E-B, and what your CSA already covers.</p>
              </div>
              <div class="sunday-plan-mark" aria-hidden="true">
                <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 4h16v16H4z"/><path d="M8 2v4M16 2v4M4 9h16M8 13h2M14 13h2M8 17h2"/></svg>
              </div>
            </div>
            <div class="sunday-plan-sections">
              <section class="sunday-plan-source sunday-plan-source--market" aria-labelledby="sundayPlanBartonHeading">
                <div class="sunday-plan-source-heading">
                  <span class="sunday-plan-source-dot" aria-hidden="true"></span>
                  <h4 class="sunday-plan-source-title" id="sundayPlanBartonHeading">Barton Creek picks</h4>
                </div>
                <div class="sunday-plan-source-items" id="sundayPlanBartonItems">
                  <p class="sunday-plan-state sunday-plan-state--loading">Checking this week’s market picks…</p>
                </div>
              </section>
              <section class="sunday-plan-source sunday-plan-source--heb" aria-labelledby="sundayPlanHebHeading">
                <div class="sunday-plan-source-heading">
                  <span class="sunday-plan-source-dot" aria-hidden="true"></span>
                  <h4 class="sunday-plan-source-title" id="sundayPlanHebHeading">H-E-B markdowns</h4>
                </div>
                <div class="sunday-plan-source-items" id="sundayPlanHebItems">
                  <p class="sunday-plan-state sunday-plan-state--loading">Checking H-E-B deals…</p>
                </div>
              </section>
              <section class="sunday-plan-source sunday-plan-source--csa" aria-labelledby="sundayPlanCsaHeading">
                <div class="sunday-plan-source-heading">
                  <span class="sunday-plan-source-dot" aria-hidden="true"></span>
                  <h4 class="sunday-plan-source-title" id="sundayPlanCsaHeading">CSA-covered ingredients</h4>
                </div>
                <div class="sunday-plan-source-items" id="sundayPlanCsaItems">
                  <p class="sunday-plan-state sunday-plan-state--loading">Checking your CSA coverage…</p>
                </div>
              </section>
            </div>
          </div>
          <div class="grocery-progress-actions">
            <div id="groceryProgress" class="grocery-progress" aria-live="polite">
              <span id="groceryProgressCount">0 of 0 items checked</span>
              <progress id="groceryProgressBar" class="grocery-progress-bar" value="0" max="1" aria-label="Grocery list completion"></progress>
              <span id="groceryProgressComplete" class="grocery-progress-complete" hidden>All items checked!</span>
            </div>
            <div class="grocery-filter-group" role="group" aria-label="Filter grocery items">
              <button type="button" class="grocery-filter-btn" id="groceryFilterAll" aria-pressed="true" aria-controls="groceryList">All items</button>
              <button type="button" class="grocery-filter-btn" id="groceryFilterRemaining" aria-pressed="false" aria-controls="groceryList">Remaining items</button>
            </div>
            <button type="button" class="print-btn grocery-reset-btn" id="resetGroceryProgressBtn" onclick="resetGroceryProgress()" aria-label="Uncheck all grocery items">Uncheck all</button>
          </div>
          <div class="grocery-search-controls">
            <label class="grocery-search-label" for="grocerySearchInput">Search grocery items</label>
            <input class="grocery-search-input" id="grocerySearchInput" type="search" autocomplete="off" aria-controls="groceryList">
          </div>
          <form class="grocery-custom-item-form" id="customGroceryItemForm">
            <div class="grocery-custom-item-field">
              <label class="grocery-search-label" for="customGroceryItemInput">Add an item</label>
              <input class="grocery-search-input" id="customGroceryItemInput" name="itemName" type="text" maxlength="255" autocomplete="off" aria-controls="groceryList" required>
            </div>
            <button type="submit" class="print-btn" id="addCustomGroceryItemBtn">Add</button>
          </form>
          <p class="grocery-search-no-match" id="grocerySearchNoMatch" role="status" aria-live="polite" hidden></p>
          <p class="price-estimate-note" id="priceEstimateNote"><%= priceEstimateNotice %></p>
          <div id="groceryList"></div>
          <div id="groceryCostSummary" class="grocery-cost-summary" style="display:none;"></div>
        </div>
      </div>
    </div>

    <div class="discovery-section">
      <button class="discovery-toggle open" id="discoveryToggle" onclick="toggleDiscovery()">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/></svg>
        Discover Recipes
        <span class="my-recipes-badge" id="discoveryBadge" style="display:none;">0</span>
      </button>
      <div class="discovery-panel open" id="discoveryPanel">
        <div class="my-recipes-panel-inner">
          <div class="my-recipes-header">
            <div>
              <div class="my-recipes-title">Discover Recipes</div>
              <div class="my-recipes-subtitle">Picked for you today · fresh ideas you haven't tried yet</div>
            </div>
            <input type="text" class="my-recipes-search" id="discoverySearch" placeholder="Search recipes…" oninput="filterDiscoveryRecipes()">
          </div>
          <div class="my-recipes-tabs">
            <button class="my-recipes-tab active" id="discoveryTabBookmarked" onclick="switchDiscoveryTab('bookmarked')">Bookmarked</button>
            <button class="my-recipes-tab" id="discoveryTabImported" onclick="switchDiscoveryTab('imported')">Imported</button>
            <button class="my-recipes-tab" id="discoveryTabCurated" onclick="switchDiscoveryTab('curated')">Curated</button>
          </div>
          <div class="my-recipes-grid" id="discoveryGrid"></div>
        </div>
      </div>
    </div>

    <!-- Recipe Detail Modal -->
    <div class="recipe-modal-overlay" id="recipeModalOverlay" onclick="if(event.target===this)closeRecipeModal()">
      <div class="recipe-modal" id="recipeModal">
        <div class="recipe-modal-header">
          <div class="recipe-modal-title" id="modalRecipeTitle"></div>
          <button class="recipe-modal-close" onclick="closeRecipeModal()" aria-label="Close recipe details">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          </button>
        </div>
        <div class="recipe-modal-meta" id="modalRecipeMeta"></div>
        <div class="recipe-modal-desc" id="modalRecipeDesc" style="display:none;"></div>
        <div class="recipe-modal-divider"></div>
        <div class="recipe-modal-section">
          <div class="recipe-modal-section-title">Ingredients</div>
          <div class="recipe-ingredients-list" id="modalIngredients"></div>
        </div>
        <div class="recipe-modal-section">
          <div class="recipe-modal-section-title">Instructions</div>
          <div class="recipe-steps-list" id="modalSteps"></div>
        </div>
        <div class="recipe-modal-footer" id="modalFooter"></div>
      </div>
    </div>

    <!-- Recipe Swap Chooser -->
    <div class="recipe-modal-overlay" id="swapChooserOverlay" onclick="if(event.target===this)closeRecipeSwapChooser()">
      <div class="recipe-modal swap-chooser" id="swapChooserDialog" role="dialog" aria-modal="true" aria-labelledby="swapChooserTitle" tabindex="-1">
        <div class="recipe-modal-header">
          <h2 class="recipe-modal-title" id="swapChooserTitle">Swap recipe</h2>
          <button class="recipe-modal-close" id="swapChooserClose" onclick="closeRecipeSwapChooser()" aria-label="Close recipe swap chooser">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="18" x2="18" y2="6"/></svg>
          </button>
        </div>
        <div class="swap-chooser-status" id="swapChooserStatus" role="status" aria-live="polite">Loading recipes…</div>
        <div class="swap-option-list" id="swapOptionList"></div>
      </div>
    </div>
  </div>

  <script>
    const _supportedAustinStoreNames = new Set(<%- JSON.stringify(supportedAustinStoreNames || []) %>);

    function isSupportedAustinStoreName(name) {
      return _supportedAustinStoreNames.has(String(name || '').trim());
    }

    // Log client-side errors to the browser console. Surfaces err.message so a
    // thrown failure isn't replaced with a generic toast.
    let plannerGenerationInFlight = false;

    function escapeHtml(str) {
      return String(str).replace(/[&<>"']/g, function (c) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
      });
    }

    function setPlannerBusy(isBusy) {
      const form = document.getElementById('plannerForm');
      const btn = document.getElementById('generateBtn');
      const useRecipesBtn = document.getElementById('btnUseRecipes');
      if (form) {
        form.setAttribute('aria-busy', String(isBusy));
        form.querySelectorAll('input, select, textarea').forEach(control => {
          control.disabled = isBusy;
        });
      }
      if (btn) {
        btn.classList.toggle('loading', isBusy);
        btn.disabled = isBusy;
      }
      if (useRecipesBtn) {
        useRecipesBtn.disabled = isBusy || window._selectedRecipeIds.size === 0;
      }
    }

    function plannerReportError(err, source) {
      const message = String((err && (err.message || err)) || 'Unknown error');
      const stack = (err && err.stack) || '';
      console.error('[planner]', source || 'unknown', err);
      return message;
    }

    window.addEventListener('error', e => {
      const msg = plannerReportError(e.error || e.message, 'window.error');
      alert(`Something went wrong:\n\n${msg}\n\nPlease try again.`);
    });
    window.addEventListener('unhandledrejection', e => {
      const msg = plannerReportError(e.reason, 'unhandledrejection');
      alert(`Something went wrong:\n\n${msg}\n\nPlease try again.`);
    });

    // Track current plan id so export buttons know which plan to download
    window._currentPlanId = null;
    let currentMealPlanDays = [];
    let mealPlanCopyFeedbackTimer = null;
    let savePlanInFlight = false;
    let sundayPlanRenderToken = 0;
    let savedPlans = [];
    let savedPlansLoadToken = 0;

    function formatSavedPlanDate(value) {
      const savedAt = new Date(value);
      if (!Number.isFinite(savedAt.getTime())) return 'Saved recently';
      return new Intl.DateTimeFormat(undefined, { dateStyle: 'medium' }).format(savedAt);
    }

    function getSavedPlanDinnerSummary(days) {
      const dinnerNames = (Array.isArray(days) ? days : [])
        .map(day => day && typeof day.meal === 'string' ? day.meal.trim() : '')
        .filter(Boolean);
      const count = dinnerNames.length;
      const countLabel = `${count} dinner${count === 1 ? '' : 's'}`;
      if (!count) return 'No dinners saved';
      const preview = dinnerNames.slice(0, 2).join(' · ');
      const remaining = count > 2 ? ` · +${count - 2} more` : '';
      return `${countLabel} · ${preview}${remaining}`;
    }

    function updateSavedPlansActiveState() {
      const activePlanId = Number(window._currentPlanId);
      document.querySelectorAll('#savedPlansList .saved-plan-button').forEach(button => {
        const isActive = Number(button.dataset.planId) === activePlanId;
        button.classList.toggle('active', isActive);
        if (isActive) button.setAttribute('aria-current', 'true');
        else button.removeAttribute('aria-current');
      });
    }

    function renderSavedPlans(plans) {
      const list = document.getElementById('savedPlansList');
      const loading = document.getElementById('savedPlansLoading');
      const empty = document.getElementById('savedPlansEmpty');
      const error = document.getElementById('savedPlansError');
      if (!list || !loading || !empty || !error) return;

      savedPlans = Array.isArray(plans) ? plans : [];
      loading.hidden = true;
      error.hidden = true;
      if (!savedPlans.length) {
        list.innerHTML = '';
        empty.hidden = false;
        return;
      }

      empty.hidden = true;
      list.innerHTML = savedPlans.map(plan => {
        const planId = Number(plan && plan.id);
        if (!Number.isSafeInteger(planId) || planId <= 0) return '';
        const planName = String(plan.plan_name || 'Weekly Meal Plan');
        const dinnerSummary = getSavedPlanDinnerSummary(plan.days);
        const isActive = planId === Number(window._currentPlanId);
        return `
          <button type="button" class="saved-plan-button${isActive ? ' active' : ''}" data-plan-id="${planId}" onclick="reopenSavedPlan(${planId}, this)" aria-label="Reopen saved plan: ${escapeHtml(planName)}"${isActive ? ' aria-current="true"' : ''}>
            <span class="saved-plan-main">
              <span class="saved-plan-name">${escapeHtml(planName)}</span>
              <span class="saved-plan-preview">${escapeHtml(dinnerSummary)}</span>
            </span>
            <span class="saved-plan-date">${escapeHtml(formatSavedPlanDate(plan.created_at))}</span>
          </button>
        `;
      }).join('');
    }

    async function loadSavedPlans() {
      if (!window._currentUserId) return;
      const loading = document.getElementById('savedPlansLoading');
      const empty = document.getElementById('savedPlansEmpty');
      const error = document.getElementById('savedPlansError');
      const list = document.getElementById('savedPlansList');
      if (!loading || !empty || !error || !list) return;

      const requestToken = ++savedPlansLoadToken;
      loading.hidden = false;
      empty.hidden = true;
      error.hidden = true;
      try {
        const response = await fetch('/api/planner/plans');
        const payload = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(payload.error || `Request failed (${response.status})`);
        if (requestToken !== savedPlansLoadToken) return;
        renderSavedPlans(payload.plans || []);
      } catch (err) {
        if (requestToken !== savedPlansLoadToken) return;
        loading.hidden = true;
        error.textContent = 'Saved plans are unavailable right now.';
        error.hidden = false;
        if (!savedPlans.length) empty.hidden = true;
        plannerReportError(err, 'loadSavedPlans');
        console.error('[loadSavedPlans]', err);
      }
    }

    async function reopenSavedPlan(planId, button) {
      if (!window._currentUserId) return;
      const numericPlanId = Number(planId);
      if (!Number.isSafeInteger(numericPlanId) || numericPlanId <= 0) return;

      const error = document.getElementById('savedPlansError');
      document.querySelectorAll('#savedPlansList .saved-plan-button').forEach(planButton => {
        planButton.disabled = true;
      });
      if (button) button.setAttribute('aria-busy', 'true');
      if (error) error.hidden = true;

      try {
        const response = await fetch(`/api/planner/plan/${encodeURIComponent(numericPlanId)}`);
        const payload = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(payload.error || `Request failed (${response.status})`);
        if (!payload.plan) throw new Error('Saved plan was not found.');

        renderResults({
          plan_id: payload.plan.id,
          days: payload.plan.days,
          grocery_list: payload.groceries || [],
          servings: payload.plan.servings,
          weekly_budget_target: payload.plan.weekly_budget_target,
          created_at: payload.plan.created_at
        }, window._bookmarkedIds || []);
      } catch (err) {
        plannerReportError(err, 'reopenSavedPlan');
        if (error) {
          error.textContent = 'Couldn’t reopen that plan. Please try again.';
          error.hidden = false;
        }
        console.error('[reopenSavedPlan]', err);
      } finally {
        document.querySelectorAll('#savedPlansList .saved-plan-button').forEach(planButton => {
          planButton.disabled = false;
        });
        if (button) button.removeAttribute('aria-busy');
      }
    }

    function normalizePlannerIngredientName(name) {
      return String(name || '').toLowerCase().trim().replace(/\b(maybe|optional|small|medium|large)\b/g, '').trim();
    }

    function normalizeGroceryListPayload(groceryList) {
      if (!Array.isArray(groceryList)) return groceryList || {};
      return groceryList.reduce((byCategory, row) => {
        if (row && row.category) {
          byCategory[row.category] = Array.isArray(row.items) ? row.items : [];
        }
        return byCategory;
      }, {});
    }

    function getGroceryProgress(groceryList) {
      let checked = 0;
      let total = 0;
      for (const items of Object.values(normalizeGroceryListPayload(groceryList))) {
        if (!Array.isArray(items)) continue;
        for (const item of items) {
          if (!item || !item.name) continue;
          total += 1;
          if (item.checked === true) checked += 1;
        }
      }
      return { checked, total };
    }

    function renderGroceryProgress(groceryList) {
      const element = document.getElementById('groceryProgress');
      if (!element) return;
      const { checked, total } = getGroceryProgress(groceryList);
      const countElement = document.getElementById('groceryProgressCount');
      const progressElement = document.getElementById('groceryProgressBar');
      const completeElement = document.getElementById('groceryProgressComplete');
      if (countElement) countElement.textContent = `${checked} of ${total} items checked`;
      if (progressElement) {
        progressElement.max = Math.max(total, 1);
        progressElement.value = checked;
      }
      const isComplete = total > 0 && checked === total;
      if (completeElement) completeElement.hidden = !isComplete;
    }

    function flattenGroceryItems(groceryList) {
      const itemMap = new Map();
      for (const [category, items] of Object.entries(normalizeGroceryListPayload(groceryList))) {
        if (!Array.isArray(items)) continue;
        for (const item of items) {
          if (!item || !item.name) continue;
          const normalizedName = normalizePlannerIngredientName(item.name);
          if (!normalizedName) continue;
          const viewModel = { ...item, category, normalizedName };
          if (viewModel.is_custom) continue;
          const existing = itemMap.get(normalizedName);
          if (!existing || (viewModel.in_csa && !existing.in_csa)
            || (viewModel.in_pantry && !existing.in_pantry && !existing.in_csa)) {
            itemMap.set(normalizedName, viewModel);
          }
        }
      }
      return [...itemMap.values()];
    }

    function renderSundayPlanState(elementId, state, message) {
      const element = document.getElementById(elementId);
      if (!element) return;
      element.innerHTML = `<p class="sunday-plan-state sunday-plan-state--${state}">${escapeHtml(message)}</p>`;
    }

    function formatSundayPrice(price) {
      const amount = Number(price && price.price);
      if (!Number.isFinite(amount)) return '';
      const unit = price && price.unit ? ` / ${escapeHtml(price.unit)}` : '';
      return `$${amount.toFixed(2)}${unit}`;
    }

    function renderSundayPlanItem(item, price, detail, detailClass) {
      const priceText = formatSundayPrice(price);
      const quantity = item.quantity
        ? `<span>${escapeHtml(item.quantity)}</span>`
        : '';
      const detailText = detail
        ? `<span class="${detailClass || ''}">${escapeHtml(detail)}</span>`
        : '';
      const meta = quantity || detailText
        ? `<div class="sunday-plan-item-meta">${quantity}${detailText}</div>`
        : '';
      return `
        <div class="sunday-plan-item">
          <div class="sunday-plan-item-main">
            <span class="sunday-plan-item-name">${escapeHtml(item.name)}</span>
            ${priceText ? `<span class="sunday-plan-item-price">${priceText}</span>` : ''}
          </div>
          ${meta}
        </div>
      `;
    }

    function renderSundayPlanItems(elementId, rows, emptyMessage) {
      const element = document.getElementById(elementId);
      if (!element) return;
      if (!rows.length) {
        element.innerHTML = `<p class="sunday-plan-state sunday-plan-state--empty">${escapeHtml(emptyMessage)}</p>`;
        return;
      }
      element.innerHTML = rows.map(row => renderSundayPlanItem(row.item, row.price, row.detail, row.detailClass)).join('');
    }

    function getSelectedPlanPrice(item, lookup) {
      const allPrices = lookup && Array.isArray(lookup.all_prices) ? lookup.all_prices : [];
      const selectedPrice = allPrices.find(price => price && price.store === item.best_store);
      if (selectedPrice) return selectedPrice;
      if (lookup && lookup.best_store && lookup.best_store === item.best_store) return allPrices[0] || null;
      return null;
    }

    function populateSundayPlanCard(items, lookupResults, renderToken) {
      if (renderToken !== sundayPlanRenderToken) return;

      const lookupByName = new Map();
      for (const result of lookupResults || []) {
        const normalizedName = normalizePlannerIngredientName(result && result.name);
        if (normalizedName) lookupByName.set(normalizedName, result);
      }

      const bartonRows = [];
      const hebRows = [];
      const bartonNames = new Set();
      const hebNames = new Set();
      for (const item of items) {
        if (item.in_pantry || item.in_csa) continue;
        const lookup = lookupByName.get(item.normalizedName);
        if (!lookup) continue;

        const selectedPrice = getSelectedPlanPrice(item, lookup);
        if (item.category === 'Produce' && selectedPrice && selectedPrice.store_slug === 'barton-springs'
          && !bartonNames.has(item.normalizedName)) {
          bartonRows.push({ item, price: selectedPrice });
          bartonNames.add(item.normalizedName);
        }

        const hebDeal = (lookup.all_prices || []).find(price => price && price.store_slug === 'heb' && price.deal === true);
        if (hebDeal && !hebNames.has(item.normalizedName)) {
          hebRows.push({ item, price: hebDeal, detail: hebDeal.deal_description, detailClass: 'sunday-plan-item-deal' });
          hebNames.add(item.normalizedName);
        }
      }

      renderSundayPlanItems('sundayPlanBartonItems', bartonRows, 'No Barton Creek picks in this plan.');
      renderSundayPlanItems('sundayPlanHebItems', hebRows, 'No H-E-B markdowns matched this plan.');
    }

    function renderSundayPlanCard(groceryList) {
      const renderToken = ++sundayPlanRenderToken;
      const items = flattenGroceryItems(groceryList);
      const csaRows = items
        .filter(item => item.in_csa)
        .map(item => ({ item, detail: 'Covered by CSA box', detailClass: 'sunday-plan-item-coverage' }));
      const lookupItems = items
        .filter(item => !item.in_pantry && !item.in_csa)
        .map(item => ({ name: item.name, category: item.category }));

      renderSundayPlanState('sundayPlanBartonItems', 'loading', 'Checking this week’s market picks…');
      renderSundayPlanState('sundayPlanHebItems', 'loading', 'Checking H-E-B deals…');
      if (csaRows.length) {
        renderSundayPlanItems('sundayPlanCsaItems', csaRows, 'No CSA-covered ingredients in this plan.');
      } else {
        renderSundayPlanState('sundayPlanCsaItems', 'empty', 'No CSA-covered ingredients in this plan.');
      }

      if (!lookupItems.length) {
        renderSundayPlanItems('sundayPlanBartonItems', [], 'No Barton Creek picks in this plan.');
        renderSundayPlanItems('sundayPlanHebItems', [], 'No H-E-B markdowns matched this plan.');
        return;
      }

      (async () => {
        try {
          const response = await fetch('/api/prices/lookup', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ items: lookupItems })
          });
          const payload = await response.json();
          if (!response.ok) throw new Error(payload.error || `Request failed (${response.status})`);
          populateSundayPlanCard(items, payload.results || [], renderToken);
        } catch (err) {
          if (renderToken !== sundayPlanRenderToken) return;
          console.error('[sundayPlanCard]', err);
          renderSundayPlanState('sundayPlanBartonItems', 'error', 'Market picks are unavailable right now.');
          renderSundayPlanState('sundayPlanHebItems', 'error', 'H-E-B markdowns are unavailable right now.');
        }
      })();
    }

    function normalizeRecipeDetailList(value) {
      if (Array.isArray(value)) return value;
      if (typeof value !== 'string') return [];
      try {
        const parsed = JSON.parse(value);
        return Array.isArray(parsed) ? parsed : [];
      } catch (err) {
        return [];
      }
    }

    function recipeDetailText(value) {
      if (value && typeof value === 'object') {
        const text = value.text ?? value.instruction ?? value.step ?? value.description ?? value.name ?? value.ingredient ?? value.value;
        return text === null || text === undefined ? '' : String(text);
      }
      return value === null || value === undefined ? '' : String(value);
    }

    function renderMealDetails(day) {
      const ingredients = normalizeRecipeDetailList(day.ingredients).map(ingredient => {
        const isObject = ingredient && typeof ingredient === 'object';
        return {
          name: recipeDetailText(isObject ? (ingredient.name ?? ingredient.text ?? ingredient.ingredient) : ingredient),
          quantity: isObject ? recipeDetailText(ingredient.quantity ?? ingredient.amount) : '',
          sourcingHint: isObject ? recipeDetailText(ingredient.sourcing_hint ?? ingredient.sourcingHint) : ''
        };
      }).filter(ingredient => String(ingredient.name || '').trim());
      const instructions = normalizeRecipeDetailList(day.instructions)
        .map(recipeDetailText)
        .filter(step => String(step || '').trim());

      if (!ingredients.length && !instructions.length) return '';

      const ingredientRows = ingredients.map(ingredient =>
        '<div class="meal-detail-ingredient">' +
          '<div class="meal-detail-ingredient-main">' +
            '<span class="meal-detail-ingredient-name">' + escapeHtml(ingredient.name) + '</span>' +
            (ingredient.sourcingHint ? '<span class="meal-detail-ingredient-hint">' + escapeHtml(ingredient.sourcingHint) + '</span>' : '') +
          '</div>' +
          (ingredient.quantity ? '<span class="meal-detail-ingredient-qty">' + escapeHtml(ingredient.quantity) + '</span>' : '') +
        '</div>'
      ).join('');
      const instructionRows = instructions.map((step, index) =>
        '<div class="meal-detail-step">' +
          '<div class="meal-detail-step-num">' + (index + 1) + '</div>' +
          '<div class="meal-detail-step-text">' + escapeHtml(step) + '</div>' +
        '</div>'
      ).join('');
      const ingredientSection = ingredients.length
        ? '<div class="meal-details-section"><div class="meal-details-section-title">Ingredients</div><div class="meal-detail-ingredients">' + ingredientRows + '</div></div>'
        : '';
      const instructionSection = instructions.length
        ? '<div class="meal-details-section"><div class="meal-details-section-title">Instructions</div><div class="meal-detail-steps">' + instructionRows + '</div></div>'
        : ingredients.length
          ? '<p class="meal-details-unavailable">Preparation instructions are not available for this recipe.</p>'
          : '';
      const summary = ingredients.length && instructions.length
        ? 'View ingredients & instructions'
        : ingredients.length
          ? 'View ingredients'
          : 'View instructions';

      return '<details class="meal-details" onclick="event.stopPropagation()">' +
        '<summary>' + summary + '</summary>' +
        '<div class="meal-details-content">' + ingredientSection + instructionSection + '</div>' +
      '</details>';
    }

    function renderLastGenerated(value) {
      const lastGenerated = document.getElementById('lastGenerated');
      if (!lastGenerated) return;
      if (value === null || value === undefined || value === '') {
        lastGenerated.textContent = '';
        lastGenerated.hidden = true;
        return;
      }

      const generatedAt = new Date(value);
      if (!Number.isFinite(generatedAt.getTime())) {
        lastGenerated.textContent = '';
        lastGenerated.hidden = true;
        return;
      }

      const formatted = new Intl.DateTimeFormat(undefined, {
        dateStyle: 'medium',
        timeStyle: 'short'
      }).format(generatedAt);
      lastGenerated.textContent = `Last generated: ${formatted}`;
      lastGenerated.hidden = false;
    }

    function normalizeWeeklyBudgetTarget(value) {
      if (value === undefined || value === null || (typeof value === 'string' && value.trim() === '')) {
        return null;
      }
      if (typeof value !== 'number' && typeof value !== 'string') {
        return null;
      }
      const parsed = Number(value);
      if (!Number.isFinite(parsed) || parsed < 0) {
        return null;
      }
      const rounded = Math.round((parsed + Number.EPSILON) * 100) / 100;
      return rounded <= 99999999.99 ? (rounded === 0 ? 0 : rounded) : null;
    }

    const PLANNER_PREFERENCES_STORAGE_KEY = 'pantry_planner_preferences';

    function isValidPlannerDinnerCount(value) {
      return typeof value === 'number' && Number.isInteger(value) && value >= 1 && value <= 7;
    }

    function isValidServings(value) {
      return typeof value === 'number' && Number.isInteger(value) && value >= 1 && value <= 12;
    }

    function readPlannerPreferences() {
      try {
        const stored = window.localStorage.getItem(PLANNER_PREFERENCES_STORAGE_KEY);
        if (!stored) return {};
        const parsed = JSON.parse(stored);
        return parsed && typeof parsed === 'object' && !Array.isArray(parsed) ? parsed : {};
      } catch (_err) {
        return {};
      }
    }

    function restorePlannerPreferences() {
      const preferences = readPlannerPreferences();
      const dinnersInput = document.getElementById('dinners');
      if (dinnersInput && isValidPlannerDinnerCount(preferences.dinners)) {
        dinnersInput.value = String(preferences.dinners);
      }

      const servingsInput = document.getElementById('servings');
      if (servingsInput && isValidServings(preferences.servings)) {
        servingsInput.value = String(preferences.servings);
      }

      const budgetInput = document.getElementById('weeklyBudgetTarget');
      const budget = normalizeWeeklyBudgetTarget(preferences.weeklyBudgetTarget);
      if (budgetInput && budget !== null) {
        budgetInput.value = budget.toFixed(2);
      }
    }

    function persistPlannerPreferences(dinners, weeklyBudgetTarget, servings) {
      const stored = readPlannerPreferences();
      const dinnerValue = dinners === undefined
        ? Number(document.getElementById('dinners').value)
        : dinners;
      const budgetValue = weeklyBudgetTarget === undefined
        ? normalizeWeeklyBudgetTarget(document.getElementById('weeklyBudgetTarget').value)
        : weeklyBudgetTarget;
      const servingsValue = servings === undefined
        ? Number(document.getElementById('servings').value)
        : servings;

      if (isValidPlannerDinnerCount(dinnerValue)) {
        stored.dinners = dinnerValue;
      }
      stored.weeklyBudgetTarget = budgetValue;
      if (isValidServings(servingsValue)) stored.servings = servingsValue;

      try {
        window.localStorage.setItem(PLANNER_PREFERENCES_STORAGE_KEY, JSON.stringify(stored));
      } catch (_err) {}
    }

    function setupPlannerPreferencePersistence() {
      const dinnersInput = document.getElementById('dinners');
      const budgetInput = document.getElementById('weeklyBudgetTarget');
      const servingsInput = document.getElementById('servings');
      if (dinnersInput) dinnersInput.addEventListener('change', () => persistPlannerPreferences());
      if (budgetInput) budgetInput.addEventListener('change', () => persistPlannerPreferences());
      if (servingsInput) servingsInput.addEventListener('change', () => persistPlannerPreferences());
    }

    function renderResults(data, bookmarkedIds, shouldScroll = true) {
      document.getElementById('results').classList.add('visible');
      const _es = document.getElementById('emptyState'); if (_es) _es.classList.add('hidden');
      if (shouldScroll) document.getElementById('results').scrollIntoView({ behavior: 'smooth', block: 'start' });
      window._currentPlanId = data.plan_id;
      const budgetInput = document.getElementById('weeklyBudgetTarget');
      if (budgetInput) {
        const target = data.weekly_budget_target;
        budgetInput.value = target === null || target === undefined || target === ''
          ? ''
          : Number(target).toFixed(2);
      }
      const servingsInput = document.getElementById('servings');
      const selectedServings = Number(data.servings);
      if (servingsInput && isValidServings(selectedServings)) servingsInput.value = String(selectedServings);
      document.getElementById('btnExportCsv').style.display = '';
      document.getElementById('btnExportTxt').style.display = '';

      if (Object.prototype.hasOwnProperty.call(data, 'created_at')) {
        renderLastGenerated(data.created_at);
      }

      const statsRow = document.getElementById('statsRow');
      const pantryCount = data.pantry_items_count || 0;
      const csaCount = data.csa_items_count || 0;
      const stats = data.stats || {};
      const days = Array.isArray(data.days) ? data.days : [];
      currentMealPlanDays = days;
      const mealPlanCopyBtn = document.getElementById('btnCopyMealPlan');
      const mealPlanCopyLabel = document.getElementById('btnCopyMealPlanLabel');
      const mealPlanCopyStatus = document.getElementById('mealPlanCopyStatus');
      if (mealPlanCopyFeedbackTimer) {
        clearTimeout(mealPlanCopyFeedbackTimer);
        mealPlanCopyFeedbackTimer = null;
      }
      if (mealPlanCopyBtn) {
        mealPlanCopyBtn.style.display = days.length > 0 ? '' : 'none';
        mealPlanCopyBtn.classList.remove('copied');
      }
      if (mealPlanCopyLabel) mealPlanCopyLabel.textContent = 'Copy meal plan';
      if (mealPlanCopyStatus) {
        mealPlanCopyStatus.textContent = '';
        mealPlanCopyStatus.className = 'copy-status';
        mealPlanCopyStatus.hidden = true;
      }
      const savePlanBtn = document.getElementById('btnSavePlan');
      const savePlanLabel = document.getElementById('btnSavePlanLabel');
      const savePlanStatus = document.getElementById('savePlanStatus');
      savePlanInFlight = false;
      if (savePlanBtn) {
        savePlanBtn.style.display = days.length > 0 ? '' : 'none';
        savePlanBtn.disabled = false;
      }
      if (savePlanLabel) savePlanLabel.textContent = 'Save plan';
      if (savePlanStatus) {
        savePlanStatus.textContent = '';
        savePlanStatus.className = 'copy-status';
        savePlanStatus.hidden = true;
      }
      const dinnersInput = document.getElementById('dinners');
      if (dinnersInput && days.length >= 1 && days.length <= 7) {
        dinnersInput.value = String(days.length);
      }
      const displayedServings = isValidServings(selectedServings) ? selectedServings : Number(servingsInput && servingsInput.value) || 2;
      const bookmarkList = Array.isArray(bookmarkedIds) ? bookmarkedIds : [];
      statsRow.innerHTML = `
        <span class="stat-badge stat-green">${days.length} dinners</span>
        <span class="stat-badge stat-green">${displayedServings} people</span>
        ${stats.avg_prep_time !== undefined && stats.avg_prep_time !== null ? `<span class="stat-badge stat-sienna">Avg ${stats.avg_prep_time} min prep</span>` : ''}
        ${stats.sourcing_compliant !== undefined && stats.sourcing_compliant !== null ? `<span class="stat-badge stat-green">${stats.sourcing_compliant} Pantry Standard</span>` : ''}
        ${pantryCount > 0 ? `<span class="stat-badge stat-green">${pantryCount} from pantry</span>` : ''}
        ${csaCount > 0 ? `<span class="stat-badge stat-green">${csaCount} from CSA box</span>` : ''}
      `;

      const daysList = document.getElementById('daysList');
      const dayClasses = ['day-badge-mon','day-badge-tue','day-badge-wed','day-badge-thu','day-badge-fri','day-badge-sat','day-badge-sun'];
      daysList.innerHTML = days.map((d, i) => {
        const isBookmarked = bookmarkList.includes(d.recipe_id);
        const starClass = isBookmarked ? 'star-btn bookmarked' : 'star-btn';
        return `
        <div class="day-card" data-recipe-id="${d.recipe_id || 0}" onclick="openRecipeModal(${d.recipe_id}, window._currentUserId)">
          <div class="day-badge ${dayClasses[i % 7]}">
            <span class="day-label">${d.day.slice(0,3)}</span>
            <span class="day-num">${i + 1}</span>
          </div>
          <div class="day-info">
            <h4>${d.meal}</h4>
            ${d.pricing && d.pricing.has_pricing ? `<div class="day-pricing">${d.pricing.best_store ? `Best at ${d.pricing.best_store} · ` : ''}${d.pricing.price_is_estimate ? 'Est. ~' : ''}$${d.pricing.total_cost.toFixed(2)}${d.pricing.unpriced_count ? ` · ${d.pricing.unpriced_count} unpriced` : ''}</div>` : ''}
            <div class="day-meta">
              ${d.protein_type ? `<span class="day-tag tag-protein">${d.protein_type}</span>` : ''}
              <span class="day-tag tag-prep">${d.prep_time} min</span>
            </div>
            ${renderMealDetails(d)}
            ${d.recipe_id ? `<button class="swap-recipe-btn" data-day-index="${i}" aria-label="Swap ${d.day} recipe" onclick="event.stopPropagation(); openRecipeSwapChooser(${i}, this)">Swap recipe</button>` : ''}
          </div>
          ${d.recipe_id ? `<button class="${starClass}" onclick="event.stopPropagation(); toggleBookmark(this, window._currentUserId, ${d.recipe_id})" title="${isBookmarked ? 'Remove bookmark' : 'Bookmark recipe'}" aria-label="${isBookmarked ? 'Remove bookmark' : 'Bookmark recipe'}">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="${isBookmarked ? 'currentColor' : 'none'}" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          </button>` : ''}
        </div>
      `}).join('');

      window._currentGroceryList = data.grocery_list || {};
      renderGroceryProgress(window._currentGroceryList);
      renderSundayPlanCard(window._currentGroceryList);

      renderGroceryList(window._currentGroceryList);

      const costSummaryEl = document.getElementById('groceryCostSummary');
      if (costSummaryEl) {
        costSummaryEl.innerHTML = renderStoreBreakdownSummary(window._currentGroceryList, data.weekly_budget_target);
        costSummaryEl.style.display = costSummaryEl.innerHTML ? '' : 'none';
      }
    }

    function getGroceryLineCost(item) {
      const lineTotal = item && item.line_total;
      if (lineTotal !== null && lineTotal !== undefined && lineTotal !== '' && Number.isFinite(Number(lineTotal))) {
        return Number(lineTotal);
      }
      return null;
    }

    function renderGroceryItem(item) {
      const inPantry = !!item.in_pantry;
      const inCsa = !!item.in_csa;
      const hasPantryInventoryMatch = !inPantry && pantryItemNames.has(normalizePantryItemName(item.name));
      const checked = item.checked === true;
      const itemClass = inPantry ? 'grocery-item grocery-item-pantry'
        : inCsa ? 'grocery-item grocery-item-csa'
        : 'grocery-item';
      const namePrefix = inPantry && inCsa ? '<span class="grocery-pantry-tag">✓ covered by pantry + CSA</span> '
        : inPantry ? '<span class="grocery-pantry-tag">✓ in pantry</span> '
        : inCsa ? '<span class="grocery-csa-tag">✓ from CSA</span> '
        : '';
      const inventoryPantryTag = hasPantryInventoryMatch ? ' <span class="grocery-pantry-tag">In pantry</span>' : '';
      const lineCost = getGroceryLineCost(item);
      const hasPrice = lineCost !== null;
      const priceText = hasPrice
        ? `${item.price_is_estimate ? 'Est. ~' : ''}$${lineCost.toFixed(2)}${item.best_store && !inPantry && !inCsa ? ` at ${escapeHtml(item.best_store)}` : ''}`
        : inPantry || inCsa ? '—' : 'Price unavailable';
      const priceClass = hasPrice ? 'grocery-price-inline' : 'grocery-price-inline grocery-price-inline--none';
      const quantity = item.purchase_quantity || item.quantity;
      const accessibleLabel = `${escapeHtml(item.name)}${quantity ? `, quantity ${escapeHtml(quantity)}` : ''}`;
      const canAddToPantry = checked && !inPantry && !hasPantryInventoryMatch;
      const note = typeof item.note === 'string' ? item.note : '';
      const traceText = [
        Array.isArray(item.from_recipes) && item.from_recipes.length ? `For: ${item.from_recipes.join(', ')}` : '',
        item.purchase_quantity && item.required_quantity ? `Recipe needs ${item.required_quantity}` : '',
        item.coverage_note || '',
        item.review_note || ''
      ].filter(Boolean).join(' · ');
      return `
        <div class="${itemClass}${checked ? ' grocery-item-checked' : ''}" data-category="${escapeHtml(item.category)}" data-item-name="${escapeHtml(item.name)}">
          <input class="grocery-check" type="checkbox" ${checked ? 'checked' : ''} onchange="toggleGroceryItem(this)" aria-label="${accessibleLabel}">
          <span class="grocery-print-state" aria-hidden="true">${checked ? '✓' : '□'}</span>
          <div class="grocery-dot"></div>
          <div class="grocery-item-main">
            <span class="grocery-name">${namePrefix}${escapeHtml(item.name)}${inventoryPantryTag}</span>
            ${traceText ? `<span class="grocery-recipes">${escapeHtml(traceText)}</span>` : ''}
            <input class="grocery-note-input" type="text" maxlength="500" value="${escapeHtml(note)}" placeholder="Add a note" aria-label="Note for ${escapeHtml(item.name)}" onchange="saveGroceryItemNote(this)">
            <span class="grocery-note-print"${note.trim() ? '' : ' hidden'}>${escapeHtml(note)}</span>
          </div>
          ${quantity ? `<span class="grocery-qty">${escapeHtml(quantity)}</span>` : ''}
          ${item.is_custom ? '' : `<span class="${priceClass}">${priceText}</span>`}
          ${canAddToPantry ? `<div class="grocery-pantry-action">
            <button type="button" class="grocery-pantry-action-btn" data-grocery-action="add-to-pantry" aria-label="Add ${escapeHtml(item.name)} to pantry">Add to pantry</button>
            <span class="grocery-pantry-action-error" role="status" aria-live="polite" hidden></span>
          </div>` : ''}
        </div>
      `;
    }

    let groceryFilterMode = 'all';
    const pendingGroceryChanges = new Map();

    function groceryItemKey(category, itemName) {
      return `${category || ''}\u0000${itemName || ''}`;
    }

    function findGroceryItem(category, itemName) {
      const items = normalizeGroceryListPayload(window._currentGroceryList)[category];
      return Array.isArray(items) ? items.find(item => item && item.name === itemName) : null;
    }

    async function toggleGroceryItem(checkbox) {
      const row = checkbox && checkbox.closest('.grocery-item');
      if (!row) return;

      const category = row.dataset.category;
      const itemName = row.dataset.itemName;
      const item = findGroceryItem(category, itemName);
      const previousChecked = item ? item.checked === true : !checkbox.checked;
      const checked = checkbox.checked;
      const checkboxHadFocus = document.activeElement === checkbox;
      const pendingKey = groceryItemKey(category, itemName);
      const listElement = document.getElementById('groceryList');
      const checkboxes = listElement ? Array.from(listElement.querySelectorAll('.grocery-check')) : [];
      const checkboxIndex = checkboxes.indexOf(checkbox);

      if (item) {
        pendingGroceryChanges.set(pendingKey, previousChecked);
        item.checked = checked;
      }
      row.classList.toggle('grocery-item-checked', checked);
      renderGroceryProgress(window._currentGroceryList);
      checkbox.disabled = true;

      try {
        const planId = window._currentPlanId;
        if (!planId) throw new Error('No saved meal plan is selected');
        const response = await fetch(`/api/planner/plan/${encodeURIComponent(planId)}/grocery-item`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            category,
            itemName,
            checked,
            userId: window._currentUserId ?? null
          })
        });
        const payload = await response.json();
        if (!response.ok) throw new Error(payload.error || `Request failed (${response.status})`);
        if (item && payload.item && typeof payload.item.checked === 'boolean') {
          item.checked = payload.item.checked;
          checkbox.checked = item.checked;
          row.classList.toggle('grocery-item-checked', item.checked);
          renderGroceryProgress(window._currentGroceryList);
        }
        if (item) pendingGroceryChanges.delete(pendingKey);
        if (groceryFilterMode === 'remaining' && item) {
          renderGroceryList(window._currentGroceryList);
          if (
            checkboxHadFocus &&
            (document.activeElement === document.body || document.activeElement === checkbox)
          ) {
            const nextCheckboxes = listElement ? Array.from(listElement.querySelectorAll('.grocery-check')) : [];
            const focusTarget = nextCheckboxes[Math.min(checkboxIndex, nextCheckboxes.length - 1)];
            (focusTarget || document.getElementById('groceryFilterRemaining'))?.focus();
          }
        }
      } catch (err) {
        if (item) pendingGroceryChanges.delete(pendingKey);
        if (item) item.checked = previousChecked;
        checkbox.checked = previousChecked;
        row.classList.toggle('grocery-item-checked', previousChecked);
        renderGroceryProgress(window._currentGroceryList);
        plannerReportError(err, 'toggleGroceryItem');
        alert(`Could not save that grocery checkoff: ${err.message || err}`);
      } finally {
        checkbox.disabled = false;
        if (
          checkboxHadFocus &&
          checkbox.isConnected &&
          (document.activeElement === document.body || document.activeElement === checkbox)
        ) {
          checkbox.focus();
        }
      }
    }

    async function saveGroceryItemNote(input) {
      const row = input && input.closest('.grocery-item');
      if (!row || !input) return;

      const category = row.dataset.category;
      const itemName = row.dataset.itemName;
      const item = findGroceryItem(category, itemName);
      const previousNote = item && typeof item.note === 'string' ? item.note : '';
      const note = input.value.trim();
      const printNote = row.querySelector('.grocery-note-print');
      const updateNoteDisplay = (value) => {
        if (printNote) {
          printNote.textContent = value;
          printNote.hidden = !value;
        }
      };

      if (note === previousNote) {
        input.value = note;
        return;
      }

      if (item) item.note = note;
      input.value = note;
      updateNoteDisplay(note);
      input.disabled = true;

      try {
        const planId = window._currentPlanId;
        if (!planId) throw new Error('No saved meal plan is selected');
        const response = await fetch(`/api/planner/plan/${encodeURIComponent(planId)}/grocery-item/note`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            category,
            itemName,
            note,
            userId: window._currentUserId ?? null
          })
        });
        const payload = await response.json();
        if (!response.ok) throw new Error(payload.error || `Request failed (${response.status})`);
        if (item && payload.item && typeof payload.item.note === 'string') item.note = payload.item.note;
        input.value = item && typeof item.note === 'string' ? item.note : note;
        updateNoteDisplay(input.value);
      } catch (err) {
        if (item) item.note = previousNote;
        input.value = previousNote;
        updateNoteDisplay(previousNote);
        plannerReportError(err, 'saveGroceryItemNote');
        alert(`Could not save that grocery note: ${err.message || err}`);
      } finally {
        input.disabled = false;
      }
    }

    function bucketGroceryByStore(groceryList) {
      const stores = {};
      const other = [];
      const pantry = [];
      const csa = [];
      const custom = [];
      for (const [cat, items] of Object.entries(normalizeGroceryListPayload(groceryList))) {
        if (!items || items.length === 0) continue;
        for (const item of items) {
          const itemWithCategory = { ...item, category: cat };
          if (itemWithCategory.is_custom) {
            custom.push(itemWithCategory);
            continue;
          }
          if (itemWithCategory.in_pantry) {
            pantry.push(itemWithCategory);
            continue;
          }
          if (itemWithCategory.in_csa) {
            csa.push(itemWithCategory);
            continue;
          }
          if (itemWithCategory.best_store && isSupportedAustinStoreName(itemWithCategory.best_store)) {
            if (!stores[itemWithCategory.best_store]) stores[itemWithCategory.best_store] = [];
            stores[itemWithCategory.best_store].push(itemWithCategory);
          } else {
            other.push(itemWithCategory.best_store ? { ...itemWithCategory, best_store: null } : itemWithCategory);
          }
        }
      }
      return { stores, other, pantry, csa, custom };
    }

    function summarizeGroceryCosts(items) {
      const priced = items.map(item => ({ item, cost: getGroceryLineCost(item) })).filter(entry => entry.cost !== null);
      const total = priced.reduce((sum, entry) => sum + entry.cost, 0);
      return {
        total,
        pricedCount: priced.length,
        unpricedCount: items.length - priced.length,
        estimateCount: priced.filter(entry => entry.item.price_is_estimate).length
      };
    }

    function formatGrocerySubtotal(summary, prefix = 'Subtotal') {
      const unpriced = summary.unpricedCount ? ` · ${summary.unpricedCount} unpriced` : '';
      if (!summary.pricedCount) return `Price unavailable for ${summary.unpricedCount} item${summary.unpricedCount === 1 ? '' : 's'}`;
      const estimate = summary.estimateCount > 0;
      return `${estimate ? 'Estimated subtotal' : prefix}: ${estimate ? '~' : ''}$${summary.total.toFixed(2)}${unpriced}`;
    }

    function groceryItemMatchesSearch(item, query) {
      return !query || String(item && item.name || '').toLowerCase().includes(query);
    }

    function groceryItemMatchesView(item, query) {
      const pendingKey = groceryItemKey(item && item.category, item && item.name);
      const checked = pendingGroceryChanges.has(pendingKey)
        ? pendingGroceryChanges.get(pendingKey)
        : item && item.checked === true;
      return groceryItemMatchesSearch(item, query) && (groceryFilterMode === 'all' || checked !== true);
    }

    function renderGroceryByStore(groceryList, query = '') {
      const { stores, other, pantry, csa, custom } = bucketGroceryByStore(groceryList);
      const storeEntries = Object.entries(stores)
        .map(([name, items]) => ({
          name,
          items: items.filter(item => groceryItemMatchesView(item, query)),
          summary: summarizeGroceryCosts(items)
        }))
        .filter(e => e.items.length > 0)
        .sort((a, b) => b.summary.total - a.summary.total);

      let html = '';
      let storeGroupIndex = 0;
      for (const entry of storeEntries) {
        const subtotal = formatGrocerySubtotal(entry.summary);
        const itemsId = `grocery-store-items-${storeGroupIndex++}`;
        html += `<div class="grocery-store">`;
        html += `<button type="button" class="grocery-store-header" aria-expanded="true" aria-controls="${itemsId}" onclick="toggleGroceryStore(this)"><span class="grocery-store-name">${entry.name}</span><span class="grocery-store-subtotal">${subtotal}</span><span class="grocery-store-toggle-icon" aria-hidden="true"></span></button>`;
        html += `<div class="grocery-store-items" id="${itemsId}">`;
        html += entry.items.map(renderGroceryItem).join('');
        html += `</div>`;
        html += `</div>`;
      }
      const matchingOther = other.filter(item => groceryItemMatchesView(item, query));
      if (matchingOther.length > 0) {
        const otherSummary = summarizeGroceryCosts(other);
        const itemsId = `grocery-store-items-${storeGroupIndex++}`;
        html += `<div class="grocery-store">`;
        html += `<button type="button" class="grocery-store-header" aria-expanded="true" aria-controls="${itemsId}" onclick="toggleGroceryStore(this)"><span class="grocery-store-name">Other</span><span class="grocery-store-subtotal">${formatGrocerySubtotal(otherSummary)}</span><span class="grocery-store-toggle-icon" aria-hidden="true"></span></button>`;
        html += `<div class="grocery-store-items" id="${itemsId}">`;
        html += matchingOther.map(renderGroceryItem).join('');
        html += `</div>`;
        html += `</div>`;
      }
      const matchingCustom = custom.filter(item => groceryItemMatchesView(item, query));
      if (matchingCustom.length > 0) {
        html += `<div class="grocery-category grocery-category-custom"><h4>Custom items</h4>`;
        html += matchingCustom.map(renderGroceryItem).join('');
        html += `</div>`;
      }
      const matchingPantry = pantry.filter(item => groceryItemMatchesView(item, query));
      if (matchingPantry.length > 0) {
        html += `<div class="grocery-category grocery-category-pantry"><h4>In Pantry</h4>`;
        html += matchingPantry.map(renderGroceryItem).join('');
        html += `</div>`;
      }
      const matchingCsa = csa.filter(item => groceryItemMatchesView(item, query));
      if (matchingCsa.length > 0) {
        html += `<div class="grocery-category grocery-category-csa"><h4>From CSA Box</h4>`;
        html += matchingCsa.map(renderGroceryItem).join('');
        html += `</div>`;
      }
      return html;
    }

    function renderGroceryList(groceryList) {
      const groceryListElement = document.getElementById('groceryList');
      if (!groceryListElement) return;
      const searchInput = document.getElementById('grocerySearchInput');
      const query = searchInput ? searchInput.value.trim().toLowerCase() : '';
      const noMatchMessage = document.getElementById('grocerySearchNoMatch');
      const allItems = Object.entries(normalizeGroceryListPayload(groceryList))
        .flatMap(([category, items]) => Array.isArray(items) ? items.map(item => ({ ...item, category })) : []);
      const hasMatchingItems = allItems.some(item => groceryItemMatchesView(item, query));
      const hasNoMatches = Boolean(query) && !hasMatchingItems;
      if (noMatchMessage) {
        noMatchMessage.hidden = !hasNoMatches;
        noMatchMessage.textContent = hasNoMatches
          ? `No ${groceryFilterMode === 'remaining' ? 'remaining ' : ''}grocery items match “${query}”.`
          : '';
      }
      const { stores, other, pantry, csa } = bucketGroceryByStore(groceryList);
      const hasStoreItems = Object.values(stores).some(items => items.length > 0) || other.length > 0;
      const hasMatchingCoveredItems = [...pantry, ...csa].some(item => groceryItemMatchesView(item, query));
      const coveredOnlyMessage = !hasStoreItems && hasMatchingCoveredItems
        ? '<p class="grocery-store-empty-stub">No store purchases this week — see the Sunday preview above for covered ingredients.</p>'
        : '';
      const renderedList = renderGroceryByStore(groceryList, query) + (hasNoMatches ? '' : coveredOnlyMessage);
      groceryListElement.innerHTML = renderedList || (hasNoMatches
        ? ''
        : `<p style="color:var(--light-gray);font-size:0.9rem;">${groceryFilterMode === 'remaining' && allItems.length > 0 ? 'No remaining items. Everything is checked off.' : 'No items yet.'}</p>`);
    }

    function setupGrocerySearch() {
      const searchInput = document.getElementById('grocerySearchInput');
      if (searchInput) {
        searchInput.addEventListener('input', () => renderGroceryList(window._currentGroceryList || {}));
      }
      const filterButtons = [
        { button: document.getElementById('groceryFilterAll'), mode: 'all' },
        { button: document.getElementById('groceryFilterRemaining'), mode: 'remaining' }
      ];
      for (const { button, mode } of filterButtons) {
        if (!button) continue;
        button.addEventListener('click', () => {
          groceryFilterMode = mode;
          for (const filterButton of filterButtons) {
            if (filterButton.button) filterButton.button.setAttribute('aria-pressed', String(filterButton.mode === mode));
          }
          renderGroceryList(window._currentGroceryList || {});
        });
      }
    }

    function setupCustomGroceryItem() {
      const form = document.getElementById('customGroceryItemForm');
      const input = document.getElementById('customGroceryItemInput');
      const button = document.getElementById('addCustomGroceryItemBtn');
      if (!form || !input || !button) return;

      form.addEventListener('submit', async event => {
        event.preventDefault();
        const itemName = input.value.trim();
        if (!itemName) return;

        button.disabled = true;
        try {
          const planId = window._currentPlanId;
          if (!planId) throw new Error('No saved meal plan is selected');
          const response = await fetch(`/api/planner/plan/${encodeURIComponent(planId)}/custom-item`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ itemName, userId: window._currentUserId ?? null })
          });
          const payload = await response.json();
          if (!response.ok) throw new Error(payload.error || `Request failed (${response.status})`);
          if (!payload || payload.category !== 'Custom items' || !payload.item || !payload.item.is_custom) {
            throw new Error('Add response was missing the saved item');
          }

          const groceryList = normalizeGroceryListPayload(window._currentGroceryList);
          if (!Array.isArray(groceryList[payload.category])) groceryList[payload.category] = [];
          groceryList[payload.category].push(payload.item);
          window._currentGroceryList = groceryList;
          input.value = '';
          renderGroceryList(groceryList);
          renderGroceryProgress(groceryList);
        } catch (err) {
          plannerReportError(err, 'addCustomGroceryItem');
          alert(`Could not add that grocery item: ${err.message || err}`);
        } finally {
          button.disabled = false;
        }
      });
    }

    function toggleGroceryStore(toggle) {
      if (!toggle) return;
      const itemsId = toggle.getAttribute('aria-controls');
      const items = itemsId ? document.getElementById(itemsId) : null;
      if (!items) return;

      const isExpanded = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!isExpanded));
      toggle.classList.toggle('collapsed', isExpanded);
      items.hidden = isExpanded;
    }

    async function resetGroceryProgress() {
      const button = document.getElementById('resetGroceryProgressBtn');
      const planId = window._currentPlanId;
      if (!button || !planId) return;

      const currentList = normalizeGroceryListPayload(window._currentGroceryList);
      const snapshot = JSON.parse(JSON.stringify(currentList));
      window._currentGroceryList = currentList;
      for (const items of Object.values(currentList)) {
        if (!Array.isArray(items)) continue;
        for (const item of items) {
          if (item) item.checked = false;
        }
      }

      document.querySelectorAll('#groceryList .grocery-item').forEach(row => {
        const checkbox = row.querySelector('.grocery-check');
        if (checkbox) checkbox.checked = false;
        row.classList.remove('grocery-item-checked');
      });
      renderGroceryProgress(currentList);
      button.disabled = true;

      try {
        const response = await fetch(`/api/planner/plan/${encodeURIComponent(planId)}/reset-grocery-progress`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ userId: window._currentUserId ?? null })
        });
        const payload = await response.json();
        if (!response.ok) throw new Error(payload.error || `Request failed (${response.status})`);
        if (!payload || !Object.prototype.hasOwnProperty.call(payload, 'grocery_list')) {
          throw new Error('Reset response was missing the grocery list');
        }

        window._currentGroceryList = normalizeGroceryListPayload(payload.grocery_list);
        renderGroceryList(window._currentGroceryList);
        renderGroceryProgress(window._currentGroceryList);
      } catch (err) {
        window._currentGroceryList = snapshot;
        renderGroceryList(window._currentGroceryList);
        renderGroceryProgress(window._currentGroceryList);
        plannerReportError(err, 'resetGroceryProgress');
        alert(`Could not uncheck grocery items: ${err.message || err}`);
      } finally {
        button.disabled = false;
      }
    }

    function computeStoreBreakdown(groceryList) {
      const { stores, other } = bucketGroceryByStore(groceryList);
      const byStore = new Map();
      let total = 0;
      let pricedCount = 0;
      let unpricedCount = 0;
      let estimateCount = 0;
      for (const [name, items] of Object.entries(stores)) {
        const summary = summarizeGroceryCosts(items);
        byStore.set(name, summary);
        total += summary.total;
        pricedCount += summary.pricedCount;
        unpricedCount += summary.unpricedCount;
        estimateCount += summary.estimateCount;
      }
      const otherSummary = summarizeGroceryCosts(other);
      total += otherSummary.total;
      pricedCount += otherSummary.pricedCount;
      unpricedCount += otherSummary.unpricedCount;
      estimateCount += otherSummary.estimateCount;
      return { total, byStore, pricedCount, unpricedCount, estimateCount };
    }

    function renderStoreBreakdownSummary(groceryList, weeklyBudgetTarget) {
      const breakdown = computeStoreBreakdown(groceryList);
      if (!groceryList) return '';

      const storeChips = [...breakdown.byStore.entries()]
        .map(([name, summary]) => `${name} ${summary.pricedCount ? `${summary.estimateCount ? '~' : ''}$${summary.total.toFixed(2)}` : `${summary.unpricedCount} unavailable`}`)
        .join(', ');
      const target = weeklyBudgetTarget === null || weeklyBudgetTarget === undefined || weeklyBudgetTarget === ''
        ? null
        : Number(weeklyBudgetTarget);
      const budgetStatus = Number.isFinite(target) && target >= 0
        ? breakdown.unpricedCount > 0
          ? `<span class="grocery-budget-status">Budget check incomplete: ${breakdown.unpricedCount} prices unavailable</span>`
          : target >= breakdown.total
            ? `<span class="grocery-budget-status grocery-budget-status--under">${breakdown.estimateCount ? 'Estimated remaining: ~' : 'Remaining: $'}${breakdown.estimateCount ? '$' : ''}${(target - breakdown.total).toFixed(2)}</span>`
            : `<span class="grocery-budget-status grocery-budget-status--over">${breakdown.estimateCount ? 'Estimated over budget by ~' : 'Over budget by $'}${breakdown.estimateCount ? '$' : ''}${(breakdown.total - target).toFixed(2)}</span>`
        : '';
      const totalText = breakdown.pricedCount
        ? `${breakdown.estimateCount ? 'Estimated ' : ''}priced subtotal: ${breakdown.estimateCount ? '~' : ''}$${breakdown.total.toFixed(2)}${breakdown.unpricedCount ? ` · ${breakdown.unpricedCount} prices unavailable` : ''}`
        : breakdown.unpricedCount
          ? `Package prices unavailable for ${breakdown.unpricedCount} items`
          : 'No store purchases this week';

      return `
        <span class="grocery-cost-summary-total">${totalText}</span>
        ${budgetStatus}
        <span class="grocery-cost-summary-stores">${storeChips}</span>
      `;
    }

    function buildStoreGroupedText(groceryList) {
      const { stores, other, pantry, csa, custom } = bucketGroceryByStore(groceryList || {});
      const storeEntries = Object.entries(stores)
        .map(([name, items]) => ({
          name,
          items,
          summary: summarizeGroceryCosts(items)
        }))
        .filter(e => e.items.length > 0)
        .sort((a, b) => b.summary.total - a.summary.total);
      const otherSummary = summarizeGroceryCosts(other);

      const lines = [];
      lines.push('PANTRY — GROCERY LIST');
      lines.push('');
      let grandTotal = 0;

      for (const entry of storeEntries) {
        lines.push(entry.name.toUpperCase());
        for (const item of entry.items) {
          const qty = item.quantity ? ` (${item.quantity})` : '';
          const lineCost = getGroceryLineCost(item);
          const hasPrice = lineCost !== null;
          const priceLine = hasPrice ? ` — ${item.price_is_estimate ? 'estimated ~' : ''}$${lineCost.toFixed(2)}` : ' — price unavailable';
          const note = typeof item.note === 'string' && item.note.trim() ? ` — note: ${item.note.trim()}` : '';
          lines.push(`  • ${item.name}${qty}${priceLine}${note}`);
        }
        lines.push(`  ${formatGrocerySubtotal(entry.summary)}`);
        lines.push('');
        grandTotal += entry.summary.total;
      }

      if (other.length > 0) {
        lines.push('Other');
        for (const item of other) {
          const qty = item.quantity ? ` (${item.quantity})` : '';
          const lineCost = getGroceryLineCost(item);
          const hasPrice = lineCost !== null;
          const priceLine = hasPrice ? ` — ${item.price_is_estimate ? 'estimated ~' : ''}$${lineCost.toFixed(2)}` : ' — price unavailable';
          const note = typeof item.note === 'string' && item.note.trim() ? ` — note: ${item.note.trim()}` : '';
          lines.push(`  • ${item.name}${qty}${priceLine}${note}`);
        }
        lines.push(`  ${formatGrocerySubtotal(otherSummary)}`);
        lines.push('');
        grandTotal += otherSummary.total;
      }

      if (custom.length > 0) {
        lines.push('Custom items');
        for (const item of custom) {
          const note = typeof item.note === 'string' && item.note.trim() ? ` — note: ${item.note.trim()}` : '';
          lines.push(`  • ${item.name}${note}`);
        }
        lines.push('');
      }

      if (pantry.length > 0) {
        lines.push('In pantry');
        for (const item of pantry) {
          const note = typeof item.note === 'string' && item.note.trim() ? ` — note: ${item.note.trim()}` : '';
          lines.push(`  • ${item.name}${note}`);
        }
        lines.push('');
      }

      if (csa.length > 0) {
        lines.push('From CSA box');
        for (const item of csa) {
          const note = typeof item.note === 'string' && item.note.trim() ? ` — note: ${item.note.trim()}` : '';
          lines.push(`  • ${item.name}${note}`);
        }
        lines.push('');
      }

      const allPurchaseSummary = summarizeGroceryCosts([...storeEntries.flatMap(entry => entry.items), ...other]);
      const shownGrandTotal = allPurchaseSummary.unpricedCount > 0
        ? `TOTAL: partial; ${allPurchaseSummary.unpricedCount} prices unavailable`
        : allPurchaseSummary.pricedCount > 0
          ? `TOTAL: ${allPurchaseSummary.estimateCount ? 'estimated ~' : ''}$${grandTotal.toFixed(2)}`
          : 'TOTAL: no store purchases';
      lines.push(shownGrandTotal);
      return lines.join('\n');
    }

    function buildMealPlanText(days) {
      const lines = ['PANTRY — WEEKLY MEAL PLAN', ''];
      for (const day of Array.isArray(days) ? days : []) {
        lines.push(`${String(day && day.day || '').trim()} — ${String(day && day.meal || '').trim()}`);
      }
      return lines.join('\n');
    }

    async function copyMealPlan() {
      const btn = document.getElementById('btnCopyMealPlan');
      const label = document.getElementById('btnCopyMealPlanLabel');
      const status = document.getElementById('mealPlanCopyStatus');
      const text = buildMealPlanText(currentMealPlanDays);
      const setStatus = (message, type) => {
        if (!status) return;
        status.textContent = message || '';
        status.className = `copy-status${type ? ` copy-status--${type}` : ''}`;
        status.hidden = !message;
      };
      const clearFeedback = () => {
        if (btn) btn.classList.remove('copied');
        if (label) label.textContent = 'Copy meal plan';
        setStatus('', '');
        mealPlanCopyFeedbackTimer = null;
      };

      if (mealPlanCopyFeedbackTimer) clearTimeout(mealPlanCopyFeedbackTimer);

      try {
        if (navigator.clipboard && navigator.clipboard.writeText) {
          await navigator.clipboard.writeText(text);
        } else {
          const ta = document.createElement('textarea');
          ta.value = text;
          ta.style.position = 'fixed';
          ta.style.opacity = '0';
          ta.style.left = '-9999px';
          document.body.appendChild(ta);
          ta.select();
          const ok = document.execCommand('copy');
          document.body.removeChild(ta);
          if (!ok) throw new Error('execCommand copy failed');
        }
        if (btn) btn.classList.add('copied');
        if (label) label.textContent = 'Copied!';
        setStatus('Meal plan copied.', 'success');
        mealPlanCopyFeedbackTimer = setTimeout(clearFeedback, 1800);
      } catch (err) {
        plannerReportError(err, 'copyMealPlan');
        if (btn) btn.classList.remove('copied');
        if (label) label.textContent = 'Copy meal plan';
        setStatus('Couldn\'t copy meal plan. Try again.', 'error');
        mealPlanCopyFeedbackTimer = setTimeout(clearFeedback, 2500);
      }
    }

    async function saveCurrentMealPlan() {
      const btn = document.getElementById('btnSavePlan');
      const label = document.getElementById('btnSavePlanLabel');
      const status = document.getElementById('savePlanStatus');
      const setStatus = (message, type) => {
        if (!status) return;
        status.textContent = message || '';
        status.className = `copy-status${type ? ` copy-status--${type}` : ''}`;
        status.hidden = !message;
      };
      const planId = Number(window._currentPlanId);
      const groceryList = window._currentGroceryList;

      if (savePlanInFlight) return;
      if (!Number.isSafeInteger(planId) || planId <= 0 || !Array.isArray(currentMealPlanDays) || !groceryList || typeof groceryList !== 'object' || Array.isArray(groceryList)) {
        setStatus('There is no plan to save yet.', 'error');
        return;
      }

      savePlanInFlight = true;
      if (btn) btn.disabled = true;
      if (label) label.textContent = 'Saving…';
      setStatus('', '');

      try {
        const response = await fetch(`/api/planner/plan/${planId}/save`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ days: currentMealPlanDays, grocery_list: groceryList })
        });
        const payload = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(payload.error || `Request failed (${response.status})`);
        if (!payload.saved) throw new Error('The meal plan was not saved.');

        if (label) label.textContent = 'Saved!';
        setStatus('Plan saved.', 'success');
        await loadSavedPlans();
      } catch (err) {
        plannerReportError(err, 'saveCurrentMealPlan');
        if (label) label.textContent = 'Save plan';
        setStatus('Couldn\'t save plan. Try again.', 'error');
      } finally {
        savePlanInFlight = false;
        if (btn) btn.disabled = false;
      }
    }

    async function copyGroceryList() {
      const btn = document.getElementById('btnExportTxt');
      const label = document.getElementById('btnExportTxtLabel');
      const text = buildStoreGroupedText(window._currentGroceryList || {});
      const restore = () => {
        if (!btn) return;
        btn.classList.remove('copied');
        if (label) label.textContent = 'Copy list';
      };

      try {
        if (navigator.clipboard && navigator.clipboard.writeText) {
          await navigator.clipboard.writeText(text);
        } else {
          const ta = document.createElement('textarea');
          ta.value = text;
          ta.style.position = 'fixed';
          ta.style.opacity = '0';
          ta.style.left = '-9999px';
          document.body.appendChild(ta);
          ta.select();
          const ok = document.execCommand('copy');
          document.body.removeChild(ta);
          if (!ok) throw new Error('execCommand copy failed');
        }
        if (btn) {
          btn.classList.add('copied');
          if (label) label.textContent = 'Copied!';
          setTimeout(restore, 1800);
        }
      } catch (err) {
        plannerReportError(err, 'copyGroceryList');
        alert(`Couldn't copy to clipboard: ${err.message || err}`);
        restore();
      }
    }

    // Pantry inventory — items the user already has on hand
    let pantryItems = [];
    const pantryItemNames = new Set();

    function normalizePantryItemName(name) {
      return String(name || '').trim().toLowerCase();
    }

    function findMatchingPantryItem(name) {
      const normalizedName = normalizePantryItemName(name);
      if (!normalizedName) return null;
      return pantryItems.find(item => item && item.source !== 'csa' && normalizePantryItemName(item.name) === normalizedName) || null;
    }

    function getGroceryPantryPayload(item) {
      const quantity = item && (item.purchase_quantity || item.quantity);
      return {
        name: String(item && item.name || '').trim(),
        quantity: String(quantity || '1').trim(),
        unit: String(item && item.unit || '').trim() || 'each'
      };
    }

    function refreshPantryItemNames() {
      pantryItemNames.clear();
      pantryItems.forEach(item => {
        const name = normalizePantryItemName(item && item.name);
        if (name && (!item || item.source !== 'csa')) pantryItemNames.add(name);
      });
    }

    function replacePantryItem(updatedItem) {
      if (!updatedItem || updatedItem.id === undefined || updatedItem.id === null) {
        throw new Error('Pantry response was missing the updated item');
      }
      const existingIndex = pantryItems.findIndex(item => String(item && item.id) === String(updatedItem.id));
      if (existingIndex >= 0) {
        pantryItems[existingIndex] = updatedItem;
      } else {
        pantryItems.unshift(updatedItem);
      }
      refreshPantryItemNames();
      renderPantryState('ready');
      rerenderCurrentGroceryList();
    }

    function rerenderCurrentGroceryList() {
      if (window._currentGroceryList) renderGroceryList(window._currentGroceryList);
    }

    function togglePantry() {
      const panel = document.getElementById('pantryPanel');
      const toggle = document.getElementById('pantryToggle');
      if (!panel || !toggle) return;
      const isOpen = panel.classList.toggle('open');
      toggle.classList.toggle('open', isOpen);
      toggle.setAttribute('aria-expanded', String(isOpen));
    }

    function setPantryStatus(message, type) {
      const status = document.getElementById('pantryStatus');
      if (!status) return;
      status.textContent = message || '';
      status.className = `pantry-status${type ? ` pantry-status--${type}` : ''}`;
    }

    function renderPantryRows() {
      const list = document.getElementById('pantryList');
      if (!list) return;
      list.innerHTML = pantryItems.map(item => `
        <div class="pantry-row" data-item-id="${escapeHtml(item.id)}">
          <div class="pantry-row-field">
            <input type="text" data-pantry-field="name" value="${escapeHtml(item.name)}" aria-label="Pantry item name" />
            <span class="pantry-field-error" id="pantry-${escapeHtml(item.id)}-name-error" hidden></span>
          </div>
          <div class="pantry-row-field">
            <input type="text" data-pantry-field="quantity" value="${escapeHtml(item.quantity)}" aria-label="Quantity for ${escapeHtml(item.name)}" />
            <span class="pantry-field-error" id="pantry-${escapeHtml(item.id)}-quantity-error" hidden></span>
          </div>
          <div class="pantry-row-field">
            <input type="text" data-pantry-field="unit" value="${escapeHtml(item.unit)}" aria-label="Unit for ${escapeHtml(item.name)}" />
            <span class="pantry-field-error" id="pantry-${escapeHtml(item.id)}-unit-error" hidden></span>
          </div>
          <div class="pantry-row-actions">
            <button type="button" class="pantry-save-btn" data-pantry-action="save">Save</button>
            <button type="button" class="pantry-remove-btn" data-pantry-action="remove">Remove</button>
          </div>
        </div>
      `).join('');
    }

    function renderPantryState(state, message) {
      const badge = document.getElementById('pantryCount');
      const list = document.getElementById('pantryList');
      if (!badge || !list) return;
      if (state === 'signed-out') {
        pantryItems = [];
        list.innerHTML = '';
        badge.style.display = 'none';
        setPantryStatus(message || 'Sign in to manage your pantry inventory.', 'signed-out');
        return;
      }
      if (state === 'loading') {
        list.innerHTML = '';
        badge.style.display = 'none';
        setPantryStatus('Loading pantry inventory…');
        return;
      }
      if (state === 'error') {
        setPantryStatus(message || 'Unable to load pantry inventory.', 'error');
        return;
      }
      badge.textContent = String(pantryItems.length);
      badge.style.display = pantryItems.length ? '' : 'none';
      renderPantryRows();
      setPantryStatus(
        pantryItems.length ? '' : 'Your pantry is empty. Add an item to keep your grocery list accurate.',
        pantryItems.length ? '' : 'empty'
      );
    }

    async function loadPantryItems() {
      if (!window._currentUserId) {
        pantryItemNames.clear();
        renderPantryState('signed-out');
        rerenderCurrentGroceryList();
        return;
      }
      renderPantryState('loading');
      try {
        const res = await fetch(`/api/pantry?userId=${encodeURIComponent(window._currentUserId)}`);
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || `Request failed (${res.status})`);
        pantryItems = (data.items || []).filter(item => item.source !== 'csa');
        refreshPantryItemNames();
        renderPantryState('ready');
        rerenderCurrentGroceryList();
      } catch (err) {
        pantryItemNames.clear();
        renderPantryState('error', reportPantryError(err, 'loadPantryItems'));
        rerenderCurrentGroceryList();
      }
    }

    function showPantryError(message) {
      setPantryStatus(message || 'Unable to update pantry inventory.', 'error');
    }

    function getPantryFields(container) {
      return {
        name: container.querySelector('[data-pantry-field="name"]'),
        quantity: container.querySelector('[data-pantry-field="quantity"]'),
        unit: container.querySelector('[data-pantry-field="unit"]')
      };
    }

    function validatePantryFields(fields) {
      const values = Object.fromEntries(Object.entries(fields).map(([key, input]) => [key, (input && input.value || '').trim()]));
      const errors = {};
      if (!values.name) errors.name = 'Enter an item name.';
      if (!values.quantity) {
        errors.quantity = 'Enter a valid quantity.';
      } else {
        const fractions = { '½': ' 1/2', '¼': ' 1/4', '⅓': ' 1/3', '⅔': ' 2/3', '¾': ' 3/4' };
        const quantity = values.quantity.replace(/[½¼⅓⅔¾]/g, fraction => fractions[fraction]).trim();
        const number = '(?:\\d+(?:\\.\\d+)?|\\.\\d+)';
        const denominator = '0*[1-9]\\d*';
        const amount = `(?:${number}(?:\\s*-\\s*|\\s+)\\d+\\s*\\/\\s*${denominator}|${number}\\s*\\/\\s*${denominator}|${number})`;
        const quantityPattern = new RegExp(`^${amount}(?:\\s+(?=[^\\n]*\\p{L})[^\\n]+)?$`, 'u');
        const mixedQuantityPattern = new RegExp(`^${number}\\s*-\\s*\\d+\\s*\\/\\s*${denominator}(?:\\s+(?=[^\\n]*\\p{L})[^\\n]+)?$`, 'u');
        const startsWithNumericValue = /^(?:[+\-−])?\s*(?:\d|\.|[½¼⅓⅔¾])/u.test(values.quantity);
        const hasDisallowedSign = /[−–—]/u.test(values.quantity)
          || (values.quantity.includes('-') && !mixedQuantityPattern.test(quantity));
        if (startsWithNumericValue && (!quantityPattern.test(quantity) || hasDisallowedSign)) {
          errors.quantity = 'Enter a valid nonnegative quantity.';
        }
      }
      if (!values.unit) errors.unit = 'Enter a unit.';
      return { values, errors, valid: Object.keys(errors).length === 0 };
    }

    function renderPantryFieldErrors(fields, errors) {
      for (const key of ['name', 'quantity', 'unit']) {
        const input = fields[key];
        if (!input) continue;
        const wrapper = input.closest('.pantry-field, .pantry-row-field');
        const error = wrapper && wrapper.querySelector('.pantry-field-error');
        if (!error) continue;
        error.textContent = errors[key] || '';
        error.hidden = !errors[key];
        if (errors[key]) {
          input.setAttribute('aria-describedby', error.id);
          input.setAttribute('aria-invalid', 'true');
        } else {
          input.removeAttribute('aria-describedby');
          input.removeAttribute('aria-invalid');
        }
      }
    }

    function validatePantryEditor(container) {
      const fields = getPantryFields(container);
      const validation = validatePantryFields(fields);
      renderPantryFieldErrors(fields, validation.errors);
      return validation;
    }

    function reportPantryError(err, source) {
      const form = document.getElementById('plannerForm');
      const plannerWasBusy = form && form.getAttribute('aria-busy') === 'true';
      const message = plannerReportError(err, source);
      if (plannerWasBusy) setPlannerBusy(true);
      return message;
    }

    async function addPantryItem(event) {
      event.preventDefault();
      const nameInput = document.getElementById('pantryNameInput');
      const quantityInput = document.getElementById('pantryQuantityInput');
      const unitInput = document.getElementById('pantryUnitInput');
      const form = document.getElementById('pantryForm');
      form.dataset.validationAttempted = 'true';
      const { values, valid } = validatePantryEditor(form);
      if (!valid) return;
      if (!window._currentUserId) {
        showPantryError('Sign in to manage your pantry inventory.');
        return;
      }
      const button = document.getElementById('pantryAddBtn');
      if (button) button.disabled = true;
      try {
        const res = await fetch('/api/pantry', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ userId: window._currentUserId, ...values })
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || `Request failed (${res.status})`);
        nameInput.value = '';
        quantityInput.value = '';
        unitInput.value = '';
        await loadPantryItems();
      } catch (err) {
        showPantryError(reportPantryError(err, 'addPantryItem'));
      } finally {
        if (button) button.disabled = false;
      }
    }

    async function handlePantryAction(event) {
      const button = event.target.closest('button[data-pantry-action]');
      if (!button) return;
      const row = button.closest('.pantry-row');
      if (!row || !window._currentUserId) return;
      const itemId = row.dataset.itemId;
      let fields;
      if (button.dataset.pantryAction === 'save') {
        row.dataset.validationAttempted = 'true';
        const validation = validatePantryEditor(row);
        if (!validation.valid) return;
        fields = validation.values;
      }
      button.disabled = true;
      try {
        let res;
        if (button.dataset.pantryAction === 'save') {
          res = await fetch(`/api/pantry/${itemId}`, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ userId: window._currentUserId, ...fields })
          });
        } else {
          res = await fetch(`/api/pantry/${itemId}?userId=${encodeURIComponent(window._currentUserId)}`, { method: 'DELETE' });
        }
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || `Request failed (${res.status})`);
        await loadPantryItems();
      } catch (err) {
        showPantryError(reportPantryError(err, 'handlePantryAction'));
      } finally {
        button.disabled = false;
      }
    }

    function setGroceryPantryActionError(row, message) {
      const error = row && row.querySelector('.grocery-pantry-action-error');
      if (!error) return;
      error.textContent = message || '';
      error.hidden = !message;
    }

    async function addCheckedGroceryItemToPantry(button) {
      const row = button && button.closest('.grocery-item');
      if (!row) return;

      setGroceryPantryActionError(row, '');
      const originalLabel = button.textContent;
      const restoreButton = () => {
        button.disabled = false;
        button.removeAttribute('aria-busy');
        button.textContent = originalLabel;
      };
      const fail = err => {
        restoreButton();
        setGroceryPantryActionError(row, plannerReportError(err, 'addCheckedGroceryItemToPantry'));
      };

      if (!window._currentUserId) {
        fail(new Error('Sign in to manage your pantry inventory.'));
        return;
      }

      const category = row.dataset.category;
      const itemName = row.dataset.itemName;
      const groceryItem = findGroceryItem(category, itemName);
      if (!groceryItem || groceryItem.checked !== true || groceryItem.in_pantry) {
        fail(new Error('That checked grocery item is no longer available to add to your pantry.'));
        return;
      }

      const matchingPantryItem = findMatchingPantryItem(groceryItem.name);
      const pantryPayload = getGroceryPantryPayload(groceryItem);
      if (!pantryPayload.name) {
        fail(new Error('That grocery item is missing a name.'));
        return;
      }

      button.disabled = true;
      button.setAttribute('aria-busy', 'true');
      button.textContent = 'Adding…';

      try {
        const response = await fetch(
          matchingPantryItem
            ? `/api/pantry/${encodeURIComponent(matchingPantryItem.id)}`
            : '/api/pantry',
          {
            method: matchingPantryItem ? 'PATCH' : 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ userId: window._currentUserId, ...pantryPayload })
          }
        );
        const data = await response.json();
        if (!response.ok) throw new Error(data.error || `Request failed (${response.status})`);
        replacePantryItem(data && data.item);
      } catch (err) {
        fail(err);
      } finally {
        if (button.isConnected) restoreButton();
      }
    }

    function setupPantryEditor() {
      const panel = document.getElementById('pantryPanel');
      const form = document.getElementById('pantryForm');
      const list = document.getElementById('pantryList');
      const groceryList = document.getElementById('groceryList');
      if (panel && form) panel.addEventListener('submit', addPantryItem);
      if (list) list.addEventListener('click', handlePantryAction);
      if (groceryList) {
        groceryList.addEventListener('click', event => {
          const button = event.target.closest('button[data-grocery-action="add-to-pantry"]');
          if (!button || !groceryList.contains(button)) return;
          event.preventDefault();
          addCheckedGroceryItemToPantry(button);
        });
      }
      const refreshValidation = event => {
        const input = event.target.closest('[data-pantry-field]');
        const container = input && input.closest('#pantryForm, .pantry-row');
        if (!container || container.dataset.validationAttempted !== 'true') return;
        validatePantryEditor(container);
      };
      if (form) form.addEventListener('input', refreshValidation);
      if (list) list.addEventListener('input', refreshValidation);
    }

    // CSA box — weekly produce the user already has coming in
    let csaItems = [];

    function toggleCsa() {
      const panel = document.getElementById('csaPanel');
      const toggle = document.getElementById('csaToggle');
      panel.classList.toggle('open');
      toggle.classList.toggle('open');
      if (panel.classList.contains('open') && window._currentUserId) {
        loadCsaItems();
      }
