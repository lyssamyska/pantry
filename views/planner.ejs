<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..900;1,9..144,300..900&family=DM+Sans:ital,wght@0,300..700;1,300..700&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --cream: #FAF7F2;
      --cream-dark: #F0EBE0;
      --green: #2A4D1E;
      --green-light: #3D6B2D;
      --green-pale: #E8EFDE;
      --sienna: #C8561A;
      --sienna-light: #E07040;
      --near-black: #1A1A18;
      --warm-gray: #5A5449;
      --light-gray: #8C8377;
      --divider: #DDD8CF;
    }
    html { scroll-behavior: smooth; }
    body {
      font-family: 'DM Sans', system-ui, sans-serif;
      background: var(--cream);
      color: var(--near-black);
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
    }
    ::selection { background: var(--green); color: var(--cream); }

    nav {
      position: fixed;
      top: 0; left: 0; right: 0;
      z-index: 100;
      padding: 18px 48px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: rgba(250,247,242,0.92);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--divider);
    }
    .nav-logo {
      font-family: 'Fraunces', serif;
      font-size: 1.4rem;
      font-weight: 700;
      color: var(--green);
      letter-spacing: -0.02em;
    }
    .nav-logo span { color: var(--sienna); }
    .nav-links { display: flex; gap: 36px; list-style: none; }
    .nav-links a { color: var(--warm-gray); text-decoration: none; font-size: 0.875rem; font-weight: 500; transition: color 0.2s; }
    .nav-links a:hover { color: var(--green); }
    .nav-cta {
      background: var(--green);
      color: var(--cream);
      text-decoration: none;
      font-size: 0.8rem;
      font-weight: 600;
      padding: 9px 20px;
      border-radius: 6px;
      letter-spacing: 0.02em;
      transition: background 0.2s;
      border: 0;
      font-family: 'DM Sans', sans-serif;
      cursor: pointer;
    }
    .nav-cta:hover { background: var(--green-light); }

    .planner-hero {
      padding: 120px 80px 60px;
      max-width: 900px;
      margin: 0 auto;
    }
    .planner-hero h1 {
      font-family: 'Fraunces', serif;
      font-size: clamp(2.5rem, 4vw, 3.5rem);
      font-weight: 800;
      letter-spacing: -0.03em;
      color: var(--near-black);
      margin-bottom: 16px;
    }
    .planner-hero h1 em { font-style: italic; color: var(--green); }
    .planner-hero p { font-size: 1.05rem; color: var(--warm-gray); max-width: 520px; line-height: 1.65; margin-bottom: 48px; }

    .planner-form {
      background: white;
      border-radius: 20px;
      padding: 40px;
      border: 1px solid var(--divider);
      box-shadow: 0 4px 20px rgba(0,0,0,0.04);
      margin-bottom: 40px;
    }
    .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
    .form-group { display: flex; flex-direction: column; gap: 8px; }
    .form-group label { font-size: 0.8rem; font-weight: 600; color: var(--warm-gray); text-transform: uppercase; letter-spacing: 0.06em; }
    .form-group input, .form-group select, .form-group textarea {
      padding: 12px 16px;
      border: 1.5px solid var(--divider);
      border-radius: 10px;
      font-size: 0.95rem;
      font-family: 'DM Sans', sans-serif;
      background: var(--cream);
      color: var(--near-black);
      transition: border-color 0.2s;
      appearance: none;
    }
    .form-group input:focus, .form-group select:focus, .form-group textarea:focus {
      outline: none;
      border-color: var(--green);
    }
    .form-group textarea { resize: vertical; min-height: 80px; }
    .form-group.full { grid-column: 1 / -1; }

    .dietary-flags { display: flex; gap: 12px; flex-wrap: wrap; }
    .flag-chip {
      display: flex;
      align-items: center;
      gap: 6px;
      padding: 8px 16px;
      border-radius: 20px;
      border: 1.5px solid var(--divider);
      cursor: pointer;
      font-size: 0.85rem;
      font-weight: 500;
      transition: all 0.2s;
      background: var(--cream);
    }
    .flag-chip input { display: none; }
    .flag-chip:has(input:checked) {
      background: var(--green-pale);
      border-color: var(--green);
      color: var(--green);
    }
    .flag-chip:hover { border-color: var(--green-light); }

    .sourcing-row {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 16px 20px;
      background: var(--green-pale);
      border-radius: 10px;
      border: 1px solid rgba(42,77,30,0.15);
    }
    .sourcing-row input[type="checkbox"] { width: 18px; height: 18px; accent-color: var(--green); }
    .sourcing-row label { font-size: 0.9rem; font-weight: 500; color: var(--green); }

    .btn-generate {
      width: 100%;
      background: var(--green);
      color: var(--cream);
      border: none;
      padding: 16px 32px;
      border-radius: 12px;
      font-size: 1rem;
      font-weight: 700;
      font-family: 'DM Sans', sans-serif;
      cursor: pointer;
      letter-spacing: 0.02em;
      transition: background 0.2s;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
    }
    .btn-generate:hover { background: var(--green-light); }
    .btn-generate:disabled { opacity: 0.6; cursor: not-allowed; }

    .loading { display: none; align-items: center; gap: 8px; }
    .btn-generate.loading .loading { display: flex; }
    .btn-generate.loading .btn-text { display: none; }
    .spinner {
      width: 18px; height: 18px;
      border: 2.5px solid rgba(250,247,242,0.4);
      border-top-color: var(--cream);
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
    }
    @keyframes spin { to { transform: rotate(360deg); } }

    /* First-time empty state — shown in the results area until a plan renders */
    .planner-empty-state {
      background: var(--cream-dark);
      border: 1px solid var(--divider);
      border-radius: 20px;
      padding: 36px 40px;
      margin-bottom: 32px;
    }
    .planner-empty-state h2 {
      font-family: 'Fraunces', serif;
      font-size: clamp(1.75rem, 3vw, 2.25rem);
      font-weight: 700;
      color: var(--green);
      margin-bottom: 12px;
      letter-spacing: -0.01em;
    }
    .planner-empty-state p {
      font-size: 1rem;
      color: var(--warm-gray);
      line-height: 1.65;
      margin-bottom: 14px;
      max-width: 640px;
    }
    .empty-feature-list {
      list-style: none;
      padding: 0;
      margin: 16px 0 24px;
      display: grid;
      grid-template-columns: 1fr;
      gap: 10px;
    }
    .empty-feature-list li {
      display: flex;
      align-items: baseline;
      gap: 10px;
      font-size: 0.95rem;
      color: var(--near-black);
    }
    .empty-feature-list li::before {
      content: '';
      width: 8px; height: 8px;
      border-radius: 50%;
      background: var(--sienna);
      flex: 0 0 auto;
      align-self: center;
    }
    .empty-feature-list li strong {
      font-weight: 600;
      color: var(--green);
    }
    .btn-start {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: var(--green);
      color: var(--cream);
      border: none;
      padding: 12px 22px;
      border-radius: 10px;
      font-size: 1rem;
      font-weight: 600;
      font-family: 'DM Sans', sans-serif;
      cursor: pointer;
      letter-spacing: 0.01em;
      transition: background 0.2s;
      text-decoration: none;
    }
    .btn-start:hover { background: var(--green-light); }
    .planner-empty-state.hidden { display: none; }

    /* Results */
    #results { display: block; }
    #results:not(.visible) > .results-header,
    #results:not(.visible) > .results-grid { display: none; }

    .results-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 32px;
    }
    .results-header h2 {
      font-family: 'Fraunces', serif;
      font-size: 1.8rem;
      font-weight: 700;
      color: var(--near-black);
    }
    .stats-row { display: flex; gap: 16px; }
    .last-generated {
      margin-top: 8px;
      color: var(--light-gray);
      font-size: 0.75rem;
      line-height: 1.4;
    }
    .stat-badge {
      padding: 6px 14px;
      border-radius: 20px;
      font-size: 0.78rem;
      font-weight: 600;
    }
    .stat-green { background: var(--green-pale); color: var(--green); }
    .stat-sienna { background: #FDF3E8; color: #9A5220; }

    .results-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; }
    .results-section { display: flex; flex-direction: column; gap: 16px; }

    .sunday-plan-card {
      background: var(--cream);
      border: 1px solid var(--divider);
      border-radius: 14px;
      padding: 20px;
      box-shadow: 0 2px 12px rgba(0,0,0,0.04);
      min-width: 0;
    }
    .sunday-plan-card-header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 16px;
      padding-bottom: 16px;
      border-bottom: 1.5px solid var(--divider);
    }
    .sunday-plan-eyebrow {
      color: var(--sienna);
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      margin-bottom: 5px;
    }
    .sunday-plan-title {
      color: var(--near-black);
      font-family: 'Fraunces', serif;
      font-size: 1.2rem;
      font-weight: 700;
      line-height: 1.2;
    }
    .sunday-plan-intro {
      color: var(--warm-gray);
      font-size: 0.78rem;
      line-height: 1.5;
      margin-top: 6px;
      max-width: 420px;
    }
    .sunday-plan-mark {
      align-items: center;
      background: var(--green-pale);
      border-radius: 10px;
      color: var(--green);
      display: flex;
      flex: 0 0 auto;
      height: 38px;
      justify-content: center;
      width: 38px;
    }
    .sunday-plan-sections {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 12px;
      margin-top: 16px;
    }
    .sunday-plan-source {
      background: white;
      border-left: 3px solid var(--green);
      border-radius: 8px;
      min-width: 0;
      padding: 12px;
    }
    .sunday-plan-source--market { border-left-color: var(--sienna); }
    .sunday-plan-source--heb { border-left-color: #1A5EA8; }
    .sunday-plan-source--csa { border-left-color: var(--green-light); }
    .sunday-plan-source-heading {
      align-items: flex-start;
      display: flex;
      gap: 7px;
      min-width: 0;
    }
    .sunday-plan-source-dot {
      background: var(--green);
      border-radius: 50%;
      flex: 0 0 auto;
      height: 7px;
      margin-top: 5px;
      width: 7px;
    }
    .sunday-plan-source--market .sunday-plan-source-dot { background: var(--sienna); }
    .sunday-plan-source--heb .sunday-plan-source-dot { background: #1A5EA8; }
    .sunday-plan-source-title {
      color: var(--near-black);
      font-size: 0.78rem;
      font-weight: 700;
      line-height: 1.3;
      overflow-wrap: anywhere;
    }
    .sunday-plan-source-items {
      display: flex;
      flex-direction: column;
      gap: 8px;
      margin-top: 10px;
      min-width: 0;
    }
    .sunday-plan-item {
      border-top: 1px dashed var(--divider);
      min-width: 0;
      padding-top: 8px;
    }
    .sunday-plan-item:first-child { border-top: none; padding-top: 0; }
    .sunday-plan-item-main {
      align-items: flex-start;
      display: flex;
      gap: 8px;
      justify-content: space-between;
      min-width: 0;
    }
    .sunday-plan-item-name {
      color: var(--near-black);
      font-size: 0.82rem;
      line-height: 1.35;
      min-width: 0;
      overflow-wrap: anywhere;
    }
    .sunday-plan-item-price {
      color: var(--green);
      flex: 0 0 auto;
      font-family: 'Fraunces', serif;
      font-size: 0.78rem;
      font-weight: 700;
      line-height: 1.35;
      text-align: right;
      white-space: nowrap;
    }
    .sunday-plan-item-meta {
      color: var(--light-gray);
      display: flex;
      flex-wrap: wrap;
      font-size: 0.7rem;
      gap: 5px 8px;
      line-height: 1.4;
      margin-top: 3px;
      overflow-wrap: anywhere;
    }
    .sunday-plan-item-deal { color: var(--sienna); }
    .sunday-plan-item-coverage { color: var(--green); font-weight: 600; }
    .sunday-plan-state {
      color: var(--light-gray);
      font-size: 0.76rem;
      line-height: 1.45;
      margin: 0;
      overflow-wrap: anywhere;
    }
    .sunday-plan-state--error { color: var(--sienna); }

    .section-header {
      display: flex;
      align-items: center;
      gap: 12px;
      flex-wrap: wrap;
      padding-bottom: 12px;
      border-bottom: 1.5px solid var(--divider);
    }
    .section-header h3 {
      font-family: 'Fraunces', serif;
      font-size: 1.1rem;
      font-weight: 700;
      color: var(--near-black);
    }
    .section-header-actions {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-left: auto;
      min-width: 0;
    }
    .copy-status {
      color: var(--green);
      font-family: 'DM Sans', sans-serif;
      font-size: 0.76rem;
      line-height: 1.35;
      overflow-wrap: anywhere;
    }
    .copy-status--error { color: var(--sienna); }
    .section-icon {
      width: 36px; height: 36px;
      border-radius: 8px;
      background: var(--green-pale);
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .day-card {
      background: white;
      border-radius: 14px;
      padding: 18px 20px;
      border: 1px solid var(--divider);
      display: grid;
      grid-template-columns: 48px 1fr;
      gap: 14px;
      align-items: start;
      transition: transform 0.2s, box-shadow 0.2s;
    }
    .day-card:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(0,0,0,0.06); cursor: pointer; }
    .day-card { position: relative; }
    .star-btn {
      position: absolute;
      top: 14px;
      right: 14px;
      background: none;
      border: none;
      cursor: pointer;
      color: #DDD8CF;
      padding: 4px;
      border-radius: 6px;
      transition: color 0.2s, transform 0.15s;
      line-height: 0;
    }
    .star-btn:hover { color: #C8561A; transform: scale(1.15); }
    .star-btn.bookmarked { color: #C8561A; }
    .star-btn.bookmarked:hover { color: #9A3E12; }
    .day-badge {
      width: 48px;
      height: 48px;
      border-radius: 10px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      line-height: 1.1;
    }
    .day-badge-mon { background: #FDF3E8; color: #9A5220; }
    .day-badge-tue { background: var(--green-pale); color: var(--green); }
    .day-badge-wed { background: #EEF2FF; color: #4338CA; }
    .day-badge-thu { background: #FDF3E8; color: #9A5220; }
    .day-badge-fri { background: #F0FDF4; color: #166534; }
    .day-badge-sat { background: var(--green-pale); color: var(--green); }
    .day-badge-sun { background: #FDF3E8; color: #9A5220; }
    .day-badge .day-label { font-size: 0.6rem; text-transform: uppercase; letter-spacing: 0.08em; }
    .day-badge .day-num { font-size: 1rem; }
    .day-info { min-width: 0; }
    .day-info h4 { font-size: 0.95rem; font-weight: 600; color: var(--near-black); margin-bottom: 4px; }
    .day-pricing {
      font-size: 0.7rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--green);
      margin: 4px 0 6px;
    }
    .day-meta { display: flex; gap: 8px; flex-wrap: wrap; }
    .day-tag {
      font-size: 0.68rem;
      font-weight: 600;
      padding: 2px 8px;
      border-radius: 4px;
    }
    .tag-protein { background: #FDF3E8; color: #9A5220; }
    .tag-prep { background: #EEF2FF; color: #4338CA; }
    .tag-source { background: var(--green-pale); color: var(--green); }
    .meal-details {
      margin-top: 12px;
      padding-top: 10px;
      border-top: 1px solid var(--divider);
    }
    .meal-details summary {
      display: flex;
      align-items: center;
      gap: 6px;
      color: var(--green);
      cursor: pointer;
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      list-style: none;
      overflow-wrap: anywhere;
      text-transform: uppercase;
    }
    .meal-details summary::-webkit-details-marker { display: none; }
    .meal-details summary::before {
      content: '+';
      font-size: 1rem;
      line-height: 0.7;
      width: 12px;
    }
    .meal-details[open] summary::before { content: '−'; }
    .meal-details summary:focus-visible {
      outline: 2px solid var(--green);
      outline-offset: 3px;
      border-radius: 4px;
    }
    .meal-details-content { padding-top: 12px; }
    .swap-recipe-btn {
      margin-top: 12px;
      padding: 7px 11px;
      border: 1px solid var(--divider);
      border-radius: 7px;
      background: white;
      color: var(--green);
      font: 600 0.75rem 'DM Sans', sans-serif;
      cursor: pointer;
      transition: background 0.2s, border-color 0.2s;
    }
    .swap-recipe-btn:hover { background: var(--green-pale); border-color: var(--green-light); }
    .swap-recipe-btn:focus-visible,
    .swap-option:focus-visible { outline: 2px solid var(--sienna); outline-offset: 2px; }
    .swap-recipe-btn:disabled,
    .swap-option:disabled { cursor: wait; opacity: 0.6; }
    .meal-details-section + .meal-details-section { margin-top: 14px; }
    .meal-details-section-title {
      color: var(--light-gray);
      font-size: 0.66rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      margin-bottom: 7px;
      text-transform: uppercase;
    }
    .meal-detail-ingredients { display: flex; flex-direction: column; gap: 6px; }
    .meal-detail-ingredient {
      align-items: flex-start;
      background: var(--cream);
      border-radius: 7px;
      display: flex;
      gap: 8px;
      justify-content: space-between;
      min-width: 0;
      padding: 7px 9px;
    }
    .meal-detail-ingredient-main { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
    .meal-detail-ingredient-name {
      color: var(--near-black);
      font-size: 0.78rem;
      font-weight: 500;
      overflow-wrap: anywhere;
    }
    .meal-detail-ingredient-qty {
      color: var(--light-gray);
      flex-shrink: 0;
      font-size: 0.72rem;
      white-space: nowrap;
    }
    .meal-detail-ingredient-hint {
      color: var(--sienna);
      font-size: 0.68rem;
      font-style: italic;
      overflow-wrap: anywhere;
    }
    .meal-detail-steps { display: flex; flex-direction: column; gap: 8px; }
    .meal-detail-step {
      align-items: flex-start;
      display: grid;
      gap: 8px;
      grid-template-columns: 20px minmax(0, 1fr);
    }
    .meal-detail-step-num {
      align-items: center;
      background: var(--green);
      border-radius: 50%;
      color: white;
      display: flex;
      flex-shrink: 0;
      font-size: 0.66rem;
      font-weight: 700;
      height: 20px;
      justify-content: center;
      line-height: 1;
      width: 20px;
    }
    .meal-detail-step-text {
      color: var(--near-black);
      font-size: 0.78rem;
      line-height: 1.45;
      overflow-wrap: anywhere;
      padding-top: 1px;
    }
    .meal-details-unavailable {
      color: var(--light-gray);
      font-size: 0.76rem;
      line-height: 1.45;
      margin: 8px 0 0;
    }

    .grocery-category { margin-bottom: 20px; }
    .grocery-category h4 {
      font-size: 0.72rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--light-gray);
      margin-bottom: 8px;
      padding-bottom: 6px;
      border-bottom: 1px solid var(--divider);
    }
    .grocery-category.grocery-category-pantry h4 { color: var(--green); border-bottom-color: rgba(42,77,30,0.2); }
    .grocery-item {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 8px 0;
      border-bottom: 1px dashed var(--divider);
    }
    .grocery-item:last-child { border-bottom: none; }
    .grocery-item-main { flex: 1; min-width: 0; }
    .grocery-item-main .grocery-name { display: block; flex: none; }
    .grocery-note-input {
      display: block;
      width: min(100%, 280px);
      margin-top: 3px;
      padding: 2px 0;
      border: 0;
      border-bottom: 1px solid transparent;
      background: transparent;
      color: var(--warm-gray);
      font: 0.76rem 'DM Sans', sans-serif;
    }
    .grocery-note-input::placeholder { color: var(--light-gray); opacity: 1; }
