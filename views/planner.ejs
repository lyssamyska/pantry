    async function loadCsaItems() {
      if (!window._currentUserId) return;
      try {
        const res = await fetch(`/api/pantry/${window._currentUserId}/csa`);
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || `Request failed (${res.status})`);
        csaItems = data.items || [];
        renderCsaChips();
      } catch (err) {
        plannerReportError(err, 'loadCsaItems');
      }
    }

    function renderCsaChips() {
      const chips = document.getElementById('csaChips');
      const badge = document.getElementById('csaCount');
      if (!chips) return;
      if (!csaItems.length) {
        chips.innerHTML = '';
        if (badge) badge.style.display = 'none';
        return;
      }
      chips.innerHTML = csaItems.map(it => `
        <span class="csa-chip">${escapeHtml(it.name)}<button onclick="removeCsaItem(${it.id})" title="Remove" aria-label="Remove ${escapeHtml(it.name)}">×</button></span>
      `).join('');
      if (badge) {
        badge.textContent = String(csaItems.length);
        badge.style.display = '';
      }
    }

    function showCsaError(msg) {
      const el = document.getElementById('csaError');
      if (!el) return;
      el.textContent = msg;
      el.style.display = 'block';
    }
    function hideCsaError() {
      const el = document.getElementById('csaError');
      if (!el) return;
      el.textContent = '';
      el.style.display = 'none';
    }

    async function addCsaItem() {
      hideCsaError();
      const input = document.getElementById('csaItemInput');
      const name = (input && input.value || '').trim();
      if (!name) {
        showCsaError('Please enter a CSA item name.');
        return;
      }
      if (!window._currentUserId) {
        showCsaError('Please sign in to track your CSA box.');
        return;
      }
      const btn = document.getElementById('csaAddBtn');
      btn.disabled = true;
      try {
        const res = await fetch('/api/pantry', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            userId: window._currentUserId,
            name,
            quantity: '1',
            unit: 'box',
            source: 'csa'
          })
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || `Request failed (${res.status})`);
        input.value = '';
        await loadCsaItems();
      } catch (err) {
        showCsaError(err.message || String(err));
      } finally {
        btn.disabled = false;
      }
    }

    async function removeCsaItem(id) {
      try {
        const res = await fetch(`/api/pantry/${id}?userId=${window._currentUserId}`, { method: 'DELETE' });
        const data = await res.json();
        if (!res.ok && res.status !== 404) throw new Error(data.error || `Request failed (${res.status})`);
        await loadCsaItems();
      } catch (err) {
        plannerReportError(err, 'removeCsaItem');
      }
    }

    function escapeHtml(s) {
      return String(s || '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    }

    // Import from URL
    let pendingRecipe = null;

    function toggleImport() {
      const panel = document.getElementById('importPanel');
      const toggle = document.getElementById('importToggle');
      panel.classList.toggle('open');
      toggle.classList.toggle('open');
    }

    async function importRecipe() {
      const url = document.getElementById('importUrl').value.trim();
      if (!url) {
        showImportError('Please paste a recipe URL first.');
        return;
      }
      if (!url.startsWith('http')) {
        showImportError('Please enter a full URL starting with http:// or https://');
        return;
      }

      document.getElementById('importLoading').classList.add('visible');
      document.getElementById('importError').style.display = 'none';
      document.getElementById('importPreview').classList.remove('visible');
      document.getElementById('importBtn').disabled = true;

      try {
        const res = await fetch('/api/recipe-import/preview', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ url }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Import failed');

        pendingRecipe = data.recipe;
        showImportPreview(data.recipe);
      } catch (err) {
        showImportError(err.message);
      } finally {
        document.getElementById('importLoading').classList.remove('visible');
        document.getElementById('importBtn').disabled = false;
      }
    }

    function showImportError(msg) {
      const el = document.getElementById('importError');
      el.textContent = msg;
      el.style.display = 'block';
    }

    function showImportPreview(recipe) {
      const preview = document.getElementById('importPreview');
      const qualityBadge = document.getElementById('qualityBadge');
      const qualityMap = { schema: 'Schema.org', microdata: 'Schema.org microdata', full: 'Full parse', partial: 'Partial — check ingredients' };
      qualityBadge.textContent = qualityMap[recipe.parse_quality] || 'Parsed';
      qualityBadge.className = `quality-badge quality-${recipe.parse_quality || 'partial'}`;

      document.getElementById('importName').textContent = recipe.name || 'Untitled Recipe';
      const total = (recipe.prep_time_minutes || 0) + (recipe.cook_time_minutes || 0);
      document.getElementById('importMeta').textContent = recipe.ingredients?.length
        ? `${recipe.ingredients.length} ingredients${total ? ' · ' + total + ' min' : ''}`
        : (total ? `${total} min total` : '');

      const img = document.getElementById('importImg');
      if (recipe.image_url) {
        img.src = recipe.image_url;
        img.style.display = 'block';
      } else {
        img.style.display = 'none';
      }

      document.getElementById('importNameInput').value = recipe.name || '';
      document.getElementById('importPrepTime').value = recipe.prep_time_minutes || '';
      document.getElementById('importCookTime').value = recipe.cook_time_minutes || '';
      document.getElementById('importProteinType').value = recipe.protein_type || '';

      const ingList = document.getElementById('importIngredientsList');
      ingList.innerHTML = (recipe.ingredients || []).map(ing =>
        `<div class="ingredient-chip"><div class="ing-dot"></div><span class="ing-text">${escapeHtml(ing)}</span></div>`
      ).join('');
      document.getElementById('ingCount').textContent = recipe.ingredients?.length || 0;
      renderImportCompliance(recipe.compliance, recipe.dietary_flags);

      preview.classList.add('visible');
    }

    function renderImportCompliance(compliance, flags) {
      const box = document.getElementById('importCompliance');
      if (!compliance) { box.style.display = 'none'; return; }
      const earned = (flags || []).filter(flag => flag === 'gluten-free' || flag === 'sugar-free');
      const tagLine = earned.length
        ? `<span class="import-compliance-tags">${earned.map(escapeHtml).join(' · ')}</span>`
        : '<span class="import-compliance-tags">Not gluten-free or sugar-free</span>';
      const warnings = compliance.warnings || [];
      box.className = `import-compliance ${warnings.length ? 'import-compliance--warn' : 'import-compliance--ok'}`;
      box.innerHTML = warnings.length
        ? `${tagLine}<ul>${warnings.map(w => `<li>${escapeHtml(w)}</li>`).join('')}</ul>`
        : `${tagLine} — passes Pantry's dietary and sourcing checks.`;
      box.style.display = 'block';
    }

    async function saveImportedRecipe() {
      if (!pendingRecipe) return;
      const saveBtn = document.getElementById('saveImportBtn');
      saveBtn.disabled = true;
      saveBtn.textContent = 'Saving…';

      try {
        const updated = {
          ...pendingRecipe,
          name: document.getElementById('importNameInput').value || pendingRecipe.name,
          prep_time_minutes: parseInt(document.getElementById('importPrepTime').value) || 0,
          cook_time_minutes: parseInt(document.getElementById('importCookTime').value) || 0,
          protein_type: document.getElementById('importProteinType').value || pendingRecipe.protein_type,
        };

        const res = await fetch('/api/recipe-import/save', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ recipe: updated }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Save failed');

        // Hide preview, reset URL field, store recipe ID for the post-save prompt
        document.getElementById('importPreview').classList.remove('visible');
        document.getElementById('importUrl').value = '';
        pendingRecipe = null;
        window._lastImportedRecipeId = data.id;
        window._lastImportedRecipeName = data.name;

        // Refresh the My Recipes panel so the saved imported recipe shows up immediately
        if (typeof loadMyRecipes === 'function') {
          loadMyRecipes();
        }

        // Show the "Add to plan?" prompt
        const prompt = document.getElementById('postSavePrompt');
        document.getElementById('postSaveText').textContent =
          `"${data.name}" saved to My Recipes. Add to this week's meal plan?`;
        prompt.classList.add('visible');

        // Reset save button
        saveBtn.textContent = 'Saved!';
        saveBtn.style.background = 'var(--green)';
        setTimeout(() => {
          saveBtn.textContent = 'Save to My Recipes';
          saveBtn.style.background = '';
          saveBtn.disabled = false;
        }, 2000);
      } catch (err) {
        showImportError(err.message);
        saveBtn.textContent = 'Save to My Recipes';
        saveBtn.disabled = false;
      }
    }

    async function addLastImportedToPlan() {
      const recipeId = window._lastImportedRecipeId;
      const btn = document.getElementById('btnYesAddToPlan');
      if (!recipeId) return;
      btn.disabled = true;
      btn.textContent = 'Adding…';

      try {
        const res = await fetch('/api/recipe-import/add-to-plan', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ recipeId }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Failed to add to plan');

        // Hide prompt
        document.getElementById('postSavePrompt').classList.remove('visible');
        window._lastImportedRecipeId = null;
        window._lastImportedRecipeName = null;

        // Refresh the plan display if results are visible
        if (document.getElementById('results').classList.contains('visible')) {
          const _es = document.getElementById('emptyState'); if (_es) _es.classList.add('hidden');
          const planId = data.plan_id;
          const planRes = await fetch(`/api/planner/plan/${planId}`);
          if (planRes.ok) {
            const planData = await planRes.json();
            renderResults({ plan_id: planData.plan.id, days: planData.plan.days, grocery_list: planData.groceries, servings: planData.plan.servings, weekly_budget_target: planData.plan.weekly_budget_target, created_at: planData.plan.created_at }, []);
          }
        }

        // Show a brief confirmation in place of the prompt
        const prompt = document.getElementById('postSavePrompt');
        const text = document.getElementById('postSaveText');
        prompt.classList.add('visible');
        text.textContent = `Added to your meal plan!`;
        btn.style.display = 'none';
        document.querySelector('.btn-dismiss-plan').style.display = 'none';
        setTimeout(() => {
          prompt.classList.remove('visible');
          btn.style.display = '';
          btn.textContent = 'Yes, add it';
          btn.disabled = false;
          document.querySelector('.btn-dismiss-plan').style.display = '';
        }, 2500);
      } catch (err) {
        console.error('[addLastImportedToPlan]', err);
        btn.disabled = false;
        btn.textContent = 'Yes, add it';
      }
    }

    function dismissAddToPlan() {
      document.getElementById('postSavePrompt').classList.remove('visible');
      window._lastImportedRecipeId = null;
      window._lastImportedRecipeName = null;
    }

    function cancelImport() {
      pendingRecipe = null;
      document.getElementById('importPreview').classList.remove('visible');
