    let swapChooserDayIndex = null;
    let swapChooserOpener = null;
    let swapChooserSaving = false;
    let swapChooserLoadToken = 0;

    function setSwapChooserStatus(message, isError = false) {
      const status = document.getElementById('swapChooserStatus');
      status.textContent = message || '';
      status.classList.toggle('error', isError);
    }

    function setSwapChooserBusy(isBusy) {
      swapChooserSaving = isBusy;
      const dialog = document.getElementById('swapChooserDialog');
      dialog.setAttribute('aria-busy', String(isBusy));
      dialog.querySelectorAll('button').forEach(button => {
        button.disabled = isBusy;
      });
    }

    async function openRecipeSwapChooser(dayIndex, opener) {
      if (!Number.isInteger(dayIndex) || !window._currentPlanId || swapChooserSaving) return;
      const overlay = document.getElementById('swapChooserOverlay');
      const dayCard = opener.closest('.day-card');
      const dayLabel = dayCard ? dayCard.querySelector('.day-badge .day-label') : null;
      const title = document.getElementById('swapChooserTitle');
      const optionList = document.getElementById('swapOptionList');
      const loadToken = ++swapChooserLoadToken;

      swapChooserDayIndex = dayIndex;
      swapChooserOpener = opener;
      title.textContent = 'Swap ' + (dayLabel ? dayLabel.textContent : 'day') + ' recipe';
      optionList.innerHTML = '';
      setSwapChooserStatus('Loading recipes…');
      setSwapChooserBusy(false);
      overlay.classList.add('open');
      document.getElementById('swapChooserClose').focus();

      try {
        const query = new URLSearchParams({
          dayIndex: String(dayIndex),
          userId: String(window._currentUserId || 0)
        });
        const res = await fetch('/api/planner/plan/' + encodeURIComponent(window._currentPlanId) + '/swap-options?' + query);
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Request failed (' + res.status + ')');
        if (loadToken !== swapChooserLoadToken || !overlay.classList.contains('open')) return;

        const options = Array.isArray(data.options) ? data.options : [];
        if (!options.length) {
          setSwapChooserStatus('No other recipes are available to swap in.');
          return;
        }

        setSwapChooserStatus('');
        optionList.innerHTML = options.map(recipe => {
          const prep = Number(recipe.prep_time_minutes) || 0;
          const cook = Number(recipe.cook_time_minutes) || 0;
          const details = [
            recipe.protein_type,
            prep + ' min prep',
            cook ? cook + ' min cook' : '',
            recipe.sourcing_standard ? 'Pantry Standard' : ''
          ].filter(Boolean).join(' · ');
          return '<button type="button" class="swap-option" data-recipe-id="' + Number(recipe.id) + '" aria-label="Swap to ' + escapeHtml(recipe.name) + '" onclick="submitRecipeSwap(Number(this.dataset.recipeId))">' +
            '<span class="swap-option-name">' + escapeHtml(recipe.name) + '</span>' +
            '<span class="swap-option-meta">' + escapeHtml(details) + '</span>' +
            '</button>';
        }).join('');
      } catch (err) {
        if (loadToken !== swapChooserLoadToken || !overlay.classList.contains('open')) return;
        setSwapChooserStatus(err.message || 'Could not load recipes. Please try again.', true);
        plannerReportError(err, 'openRecipeSwapChooser');
      }
    }

    function closeRecipeSwapChooser(restoreFocus = true) {
      if (swapChooserSaving) return;
      document.getElementById('swapChooserOverlay').classList.remove('open');
      document.getElementById('swapOptionList').innerHTML = '';
      setSwapChooserStatus('');
      swapChooserLoadToken += 1;
      const opener = swapChooserOpener;
      swapChooserDayIndex = null;
      swapChooserOpener = null;
      if (restoreFocus && opener && opener.isConnected) opener.focus();
    }

    async function submitRecipeSwap(recipeId) {
      if (swapChooserSaving || swapChooserDayIndex === null || !window._currentPlanId) return;
      if (!Number.isInteger(recipeId) || recipeId <= 0) return;
      const dayIndex = swapChooserDayIndex;
      setSwapChooserBusy(true);
      setSwapChooserStatus('Saving recipe and refreshing groceries…');

      try {
        const res = await fetch('/api/planner/plan/' + encodeURIComponent(window._currentPlanId) + '/swap-recipe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            dayIndex,
            recipeId,
            userId: window._currentUserId || 0
          })
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Request failed (' + res.status + ')');

        setSwapChooserBusy(false);
        closeRecipeSwapChooser(false);
        renderResults(data, window._bookmarkedIds || [], false);
        const replacementButton = document.querySelector('.swap-recipe-btn[data-day-index="' + dayIndex + '"]');
        if (replacementButton) replacementButton.focus();
      } catch (err) {
        setSwapChooserBusy(false);
        setSwapChooserStatus(err.message || 'Could not swap this recipe. Please try again.', true);
        plannerReportError(err, 'submitRecipeSwap');
      }
    }

    function handleSwapChooserKeydown(event) {
      const overlay = document.getElementById('swapChooserOverlay');
      if (!overlay.classList.contains('open')) return;
      if (event.key === 'Escape') {
        event.preventDefault();
        closeRecipeSwapChooser();
        return;
      }
      if (event.key !== 'Tab') return;

      const dialog = document.getElementById('swapChooserDialog');
      const controls = [...dialog.querySelectorAll('button:not(:disabled)')];
      if (!controls.length) {
        event.preventDefault();
        dialog.focus();
        return;
      }
      const first = controls[0];
      const last = controls[controls.length - 1];
      if (!dialog.contains(document.activeElement)) {
        event.preventDefault();
        (event.shiftKey ? last : first).focus();
      } else if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    }

    document.addEventListener('keydown', handleSwapChooserKeydown);

    async function openRecipeModal(recipeId, userId) {
      if (!recipeId) return;
      try {
        const res = await fetch(`/api/recipes/${recipeId}`);
        if (!res.ok) return;
        const data = await res.json();
        const recipe = data.recipe;
        if (!recipe) return;

        document.getElementById('modalRecipeTitle').textContent = recipe.name;
        document.getElementById('modalRecipeDesc').textContent = recipe.description || '';
        document.getElementById('modalRecipeDesc').style.display = recipe.description ? 'block' : 'none';

        // Meta badges
        const meta = document.getElementById('modalRecipeMeta');
        const totalTime = (recipe.prep_time_minutes || 0) + (recipe.cook_time_minutes || 0);
        let metaHtml = recipe.protein_type ? `<span class="day-tag tag-protein">${recipe.protein_type}</span>` : '';
        metaHtml += `<span class="day-tag tag-prep">${totalTime} min</span>`;
        if (recipe.sourcing_standard) metaHtml += `<span class="day-tag tag-source">Pantry Standard</span>`;
        meta.innerHTML = metaHtml;

        // Ingredients
        const ingredients = typeof recipe.ingredients === 'string' ? JSON.parse(recipe.ingredients) : (recipe.ingredients || []);
        const ingList = document.getElementById('modalIngredients');
        if (ingredients.length > 0 && typeof ingredients[0] === 'object') {
          ingList.innerHTML = ingredients.map(ing => `
            <div class="recipe-ingredient">
              <div class="ing-dot"></div>
              <div style="flex:1;">
                <div class="recipe-ingredient-name">${ing.name || ing}</div>
                ${ing.sourcing_hint ? `<div class="recipe-ingredient-hint">${ing.sourcing_hint}</div>` : ''}
              </div>
              ${ing.quantity ? `<span class="recipe-ingredient-qty">${ing.quantity}</span>` : ''}
            </div>
          `).join('');
        } else {
          ingList.innerHTML = ingredients.map(ing =>
            `<div class="recipe-ingredient"><div class="ing-dot"></div><div class="recipe-ingredient-name">${ing}</div></div>`
          ).join('');
        }

        // Instructions
        const instructions = typeof recipe.instructions === 'string' ? JSON.parse(recipe.instructions) : (recipe.instructions || []);
        document.getElementById('modalSteps').innerHTML = instructions.map((step, i) => `
          <div class="recipe-step">
            <div class="recipe-step-num">${i + 1}</div>
            <div class="recipe-step-text">${step}</div>
          </div>
        `).join('');

        // Dietary flags tags
        const flags = recipe.dietary_flags;
        if (flags && flags.length > 0) {
          const extraTags = flags.map(f => `<span class="day-tag tag-prep">${f}</span>`).join('');
          meta.innerHTML += extraTags;
        }

        // Footer with bookmark button
        const footer = document.getElementById('modalFooter');
        const isBookmarked = window._bookmarkedIds ? window._bookmarkedIds.includes(recipeId) : false;
        footer.innerHTML = recipeId ? `
          <button class="recipe-modal-star ${isBookmarked ? 'bookmarked' : ''}" onclick="toggleBookmark(this, window._currentUserId, ${recipeId})">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="${isBookmarked ? 'currentColor' : 'none'}" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            ${isBookmarked ? 'Saved' : 'Save recipe'}
          </button>
        ` : '';

        document.getElementById('recipeModalOverlay').classList.add('open');
      } catch (err) {
        console.error('[openRecipeModal]', err);
      }
    }

    function closeRecipeModal() {
      document.getElementById('recipeModalOverlay').classList.remove('open');
    }

    // My Recipes
    window._myRecipesData = null;
    window._selectedRecipeIds = new Set();
    window._myRecipesTab = 'bookmarked';
    window._myRecipesSearch = '';

    function toggleMyRecipes() {
      const panel = document.getElementById('myRecipesPanel');
      const toggle = document.getElementById('myRecipesToggle');
      const isOpen = panel.classList.toggle('open');
      toggle.classList.toggle('open', isOpen);
      if (isOpen && !window._myRecipesData) {
        loadMyRecipes();
      } else if (isOpen) {
        renderMyRecipesGrid();
      }
    }

    async function loadMyRecipes() {
      try {
        const res = await fetch('/api/my-recipes/' + window._currentUserId);
        if (!res.ok) return;
        const data = await res.json();
        window._myRecipesData = data;
        updateMyRecipesBadge(data);
        renderMyRecipesGrid();
      } catch (err) {
        console.error('[loadMyRecipes]', err);
      }
    }

    function updateMyRecipesBadge(data) {
      const total = (data.bookmarked?.length || 0) + (data.imported?.length || 0);
      const badge = document.getElementById('myRecipesBadge');
      if (total > 0) {
        badge.textContent = total;
        badge.style.display = '';
      } else {
        badge.style.display = 'none';
      }
    }

    function switchMyRecipesTab(tab) {
      window._myRecipesTab = tab;
      document.getElementById('tabBookmarked').classList.toggle('active', tab === 'bookmarked');
      document.getElementById('tabImported').classList.toggle('active', tab === 'imported');
      renderMyRecipesGrid();
    }

    function filterMyRecipes() {
      window._myRecipesSearch = document.getElementById('myRecipesSearch').value.toLowerCase().trim();
      renderMyRecipesGrid();
    }

    function getCurrentPlanRecipeIds() {
      const cards = document.querySelectorAll('.day-card');
      return [...cards].map(c => {
        const id = parseInt(c.getAttribute('data-recipe-id'));
        return isNaN(id) ? null : id;
      }).filter(Boolean);
    }

    function renderMyRecipesGrid() {
      const grid = document.getElementById('myRecipesGrid');
      const data = window._myRecipesData;
      const tab = window._myRecipesTab;
      const search = window._myRecipesSearch;
      const selectedIds = window._selectedRecipeIds;

      const tabLabel = { bookmarked: 'Saved', imported: 'Imported' };
      const items = tab === 'bookmarked'
        ? (data?.bookmarked || [])
        : (data?.imported || []);

      const filtered = items.filter(item => {
        if (!search) return true;
        const name = item.name || '';
        return name.toLowerCase().includes(search);
      });

      if (filtered.length === 0) {
        grid.innerHTML = `
          <div class="my-recipes-empty" style="grid-column: 1/-1;">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            <strong>No ${tabLabel[tab]} recipes yet</strong>
            ${tab === 'bookmarked' ? 'Star recipes from your plan to save them here.' : 'Import recipes from URL to see them here.'}
          </div>`;
        return;
      }

      grid.innerHTML = filtered.map(item => {
        const id = item.recipe_id || item.id;
        const isSelected = selectedIds.has(id);
        const isImported = !!item.source_url || !!item.imported_at;
        const totalTime = (item.prep_time_minutes || 0) + (item.cook_time_minutes || 0);
        const selectedClass = isSelected ? 'selected' : '';

        return `
        <div class="recipe-pool-card ${selectedClass}" data-recipe-id="${id}" onclick="toggleRecipeSelection(${id}, ${isSelected})">
          <div class="recipe-pool-check">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
          </div>
          <div class="recipe-pool-info">
            <div class="recipe-pool-name">${item.name}</div>
            <div class="recipe-pool-meta">
              ${isImported ? '<span class="recipe-pool-source">Imported</span>' : ''}
              ${item.protein_type ? `<span class="day-tag tag-protein">${item.protein_type}</span>` : ''}
              ${totalTime > 0 ? `<span class="day-tag tag-prep">${totalTime} min</span>` : ''}
            </div>
          </div>
        </div>`;
      }).join('');

      updateMyRecipesSelectedCount();
    }

    function toggleRecipeSelection(id, currentlySelected) {
      if (currentlySelected) {
        window._selectedRecipeIds.delete(id);
      } else {
        window._selectedRecipeIds.add(id);
      }
      // Re-render card state without full reload
      const card = document.querySelector(`[data-recipe-id="${id}"]`);
      if (card) card.classList.toggle('selected', !currentlySelected);
      updateMyRecipesSelectedCount();
    }

    function updateMyRecipesSelectedCount() {
      const count = window._selectedRecipeIds.size;
      document.getElementById('myRecipesSelectedCount').textContent = count;
      document.getElementById('btnUseRecipes').disabled = plannerGenerationInFlight || count === 0;
    }

    function clearMyRecipeSelection() {
      window._selectedRecipeIds.clear();
      renderMyRecipesGrid();
    }

    // Discover Recipes
    window._discoveryData = null;
    window._discoveryTab = 'bookmarked';
    window._discoverySearch = '';

    function toggleDiscovery() {
      const panel = document.getElementById('discoveryPanel');
      const toggle = document.getElementById('discoveryToggle');
      const isOpen = panel.classList.toggle('open');
      toggle.classList.toggle('open', isOpen);
      if (isOpen && !window._discoveryData) {
        loadDiscoveryRecipes();
      } else if (isOpen) {
        renderDiscoveryGrid();
      }
    }

    async function loadDiscoveryRecipes() {
      try {
        const res = await fetch('/api/discovery/' + (window._currentUserId || 0));
        if (!res.ok) return;
        const data = await res.json();
        window._discoveryData = data;
        updateDiscoveryBadge(data);
        renderDiscoveryGrid();
      } catch (err) {
        console.error('[loadDiscoveryRecipes]', err);
      }
    }

    function updateDiscoveryBadge(data) {
      const total = (data.bookmarked?.length || 0) + (data.imported?.length || 0) + (data.curated?.length || 0);
      const badge = document.getElementById('discoveryBadge');
      if (total > 0) {
        badge.textContent = total;
        badge.style.display = '';
      } else {
        badge.style.display = 'none';
      }
    }

    function switchDiscoveryTab(tab) {
      window._discoveryTab = tab;
      document.getElementById('discoveryTabBookmarked').classList.toggle('active', tab === 'bookmarked');
      document.getElementById('discoveryTabImported').classList.toggle('active', tab === 'imported');
      document.getElementById('discoveryTabCurated').classList.toggle('active', tab === 'curated');
      renderDiscoveryGrid();
    }

    function filterDiscoveryRecipes() {
      window._discoverySearch = document.getElementById('discoverySearch').value.toLowerCase().trim();
      renderDiscoveryGrid();
    }

    const DISCOVERY_TAB_LABELS = { bookmarked: 'Saved', imported: 'Imported', curated: 'Curated' };

    function renderDiscoveryGrid() {
      const grid = document.getElementById('discoveryGrid');
      const data = window._discoveryData;
      const tab = window._discoveryTab;
      const search = window._discoverySearch;
      const items = data ? (data[tab] || []) : [];

      const filtered = items.filter(item => {
        if (!search) return true;
        const name = item.name || '';
        return name.toLowerCase().includes(search);
      });

      if (filtered.length === 0) {
        const hint = tab === 'bookmarked'
          ? 'Star recipes from your plan to see them here.'
          : tab === 'imported'
            ? 'Import recipes from URL to surface them here.'
            : 'Bookmark or import recipes to fill this tab with your favorites.';
        grid.innerHTML = `
          <div class="my-recipes-empty" style="grid-column: 1/-1;">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="9"/><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/></svg>
            <strong>No ${DISCOVERY_TAB_LABELS[tab]} recipes yet</strong>
            ${hint}
          </div>`;
        return;
      }

      const bookmarkedIds = window._bookmarkedIds || [];

      grid.innerHTML = filtered.map(item => {
        const id = item.id;
        const origin = item.origin || tab;
        const totalTime = (item.prep_time_minutes || 0) + (item.cook_time_minutes || 0);
        const isBookmarked = origin === 'bookmark' || bookmarkedIds.includes(id);

        let originBadge = '';
        if (origin === 'bookmark') {
          originBadge = '<span class="recipe-pool-source-bookmark">Saved</span>';
        } else if (origin === 'import') {
          originBadge = '<span class="recipe-pool-source">Imported</span>';
        }

        return `
        <div class="recipe-pool-card" data-recipe-id="${id}" onclick="openRecipeModal(${id}, window._currentUserId)">
          <div class="recipe-pool-info">
            <div class="recipe-pool-name">${item.name}</div>
            <div class="recipe-pool-meta">
              ${originBadge}
              ${item.protein_type ? `<span class="day-tag tag-protein">${item.protein_type}</span>` : ''}
              ${totalTime > 0 ? `<span class="day-tag tag-prep">${totalTime} min</span>` : ''}
            </div>
          </div>
          <div style="display:flex;gap:6px;align-items:center;flex-shrink:0;">
            <button class="star-btn ${isBookmarked ? 'bookmarked' : ''}" onclick="event.stopPropagation(); toggleBookmark(this, window._currentUserId, ${id})" title="${isBookmarked ? 'Remove bookmark' : 'Bookmark recipe'}" aria-label="${isBookmarked ? 'Remove bookmark' : 'Bookmark recipe'}">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="${isBookmarked ? 'currentColor' : 'none'}" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            </button>
            <button class="discovery-add-btn" onclick="event.stopPropagation(); useDiscoveryInPlan(${id}, this)" title="Add to today's plan">Add to today's plan</button>
          </div>
        </div>`;
      }).join('');
    }

    async function useDiscoveryInPlan(recipeId, btn) {
      if (!recipeId) return;
      const original = btn ? btn.textContent : null;
      if (btn) {
        btn.disabled = true;
        btn.textContent = 'Adding…';
      }
      try {
        const res = await fetch('/api/recipe-import/add-to-plan', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ recipeId }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Failed to add to plan');

        if (btn) {
          btn.textContent = 'Added!';
          btn.style.background = 'var(--sienna)';
        }

        // Refresh plan display if visible
        if (document.getElementById('results').classList.contains('visible') && data.plan_id) {
          const _es = document.getElementById('emptyState'); if (_es) _es.classList.add('hidden');
          const planRes = await fetch(`/api/planner/plan/${data.plan_id}`);
          if (planRes.ok) {
            const planData = await planRes.json();
            renderResults({ plan_id: planData.plan.id, days: planData.plan.days, grocery_list: planData.groceries, servings: planData.plan.servings, weekly_budget_target: planData.plan.weekly_budget_target, created_at: planData.plan.created_at }, window._bookmarkedIds || []);
          }
        }

        if (btn) {
          setTimeout(() => {
            btn.textContent = original || "Add to today's plan";
            btn.style.background = '';
            btn.disabled = false;
          }, 2000);
        }
      } catch (err) {
        console.error('[useDiscoveryInPlan]', err);
        if (btn) {
          btn.textContent = 'Failed';
          setTimeout(() => {
            btn.textContent = original || "Add to today's plan";
            btn.disabled = false;
          }, 2000);
        }
      }
    }

    async function generateWithMyRecipes() {
      if (plannerGenerationInFlight) return;
      plannerGenerationInFlight = true;
      setPlannerBusy(true);
      try {
        const ids = [...window._selectedRecipeIds];
        if (ids.length === 0) return;

        // Store current plan recipe IDs to highlight later
        const currentPlanIds = [...document.querySelectorAll('.day-card')]
          .map(card => {
            const id = parseInt(card.getAttribute('data-recipe-id'));
            return isNaN(id) ? null : id;
          })
          .filter(Boolean);

        // Call generate with selected recipe IDs
        await generatePlanWithRecipeIds(ids, currentPlanIds);
      } finally {
        plannerGenerationInFlight = false;
        setPlannerBusy(false);
      }
    }

    async function generatePlan() {
      if (plannerGenerationInFlight) return;
      // If user has made a selection, generateWithMyRecipes handles it
      if (window._selectedRecipeIds.size > 0) {
        await generateWithMyRecipes();
        return;
      }
      plannerGenerationInFlight = true;
      setPlannerBusy(true);

      try {
        const dinners = parseInt(document.getElementById('dinners').value);
        const servings = Number(document.getElementById('servings').value);
        const mustHave = document.getElementById('mustHave').value.split(',').map(s => s.trim()).filter(Boolean);
        const mustHaveIngredients = document.getElementById('mustHaveIngredients').value.split(',').map(s => s.trim()).filter(Boolean);
        const dietary = [...document.querySelectorAll('.flag-chip input:checked')].map(i => i.value);
        const avoidIngredients = document.getElementById('avoidIngredients').value.split(',').map(s => s.trim()).filter(Boolean);
        const preferSourcing = document.getElementById('preferSourcing').checked;
        const weeklyBudgetTarget = normalizeWeeklyBudgetTarget(document.getElementById('weeklyBudgetTarget').value);
        persistPlannerPreferences(dinners, weeklyBudgetTarget, servings);

        const res = await fetch('/api/planner/generate', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ dinnersNeeded: dinners, servings, mustHaveRecipes: mustHave, mustHaveIngredients, avoidIngredients, excludeDietary: dietary, preferSourcingStandard: preferSourcing, weeklyBudgetTarget })
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || `Request failed (${res.status})`);
        // Pass current plan recipe ids so we can mark in-plan recipes
        renderResults(data, data.bookmarked_recipe_ids || []);
        await loadSavedPlans();
      } catch (err) {
        plannerReportError(err, 'generatePlan (override)');
        alert(`Something went wrong: ${err.message || err}\n\nPlease try again.`);
      } finally {
        plannerGenerationInFlight = false;
        setPlannerBusy(false);
      }
    }

    async function generatePlanWithRecipeIds(recipeIds, currentPlanIds) {
      try {
        const dinners = parseInt(document.getElementById('dinners').value);
        const servings = Number(document.getElementById('servings').value);
        const mustHave = document.getElementById('mustHave').value.split(',').map(s => s.trim()).filter(Boolean);
        const mustHaveIngredients = document.getElementById('mustHaveIngredients').value.split(',').map(s => s.trim()).filter(Boolean);
        const dietary = [...document.querySelectorAll('.flag-chip input:checked')].map(i => i.value);
        const avoidIngredients = document.getElementById('avoidIngredients').value.split(',').map(s => s.trim()).filter(Boolean);
        const preferSourcing = document.getElementById('preferSourcing').checked;
        const weeklyBudgetTarget = normalizeWeeklyBudgetTarget(document.getElementById('weeklyBudgetTarget').value);
        persistPlannerPreferences(dinners, weeklyBudgetTarget, servings);

        const res = await fetch('/api/planner/generate', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            dinnersNeeded: dinners,
            servings,
            mustHaveRecipes: mustHave,
            mustHaveRecipeIds: recipeIds,
            mustHaveIngredients,
            avoidIngredients,
            excludeDietary: dietary,
            preferSourcingStandard: preferSourcing,
            weeklyBudgetTarget
          })
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || `Request failed (${res.status})`);

        // Check which selected recipe IDs made it into the plan
        const selectedIds = new Set(recipeIds);
        const inPlanIds = data.days
          .map(d => d.recipe_id)
          .filter(id => selectedIds.has(id));

        renderResults(data, data.bookmarked_recipe_ids || []);
        await loadSavedPlans();

        // Show confirmation if any selected recipes are already in plan
        if (inPlanIds.length > 0) {
          // Find the day cards and highlight them
          setTimeout(() => {
            inPlanIds.forEach(id => {
              const card = document.querySelector(`[data-recipe-id="${id}"]`);
              if (card) card.classList.add('in-plan');
            });
          }, 100);
        }

        // Clear selection after generation
        window._selectedRecipeIds.clear();
        updateMyRecipesSelectedCount();
      } catch (err) {
        plannerReportError(err, 'generatePlanWithRecipeIds');
        alert(`Something went wrong: ${err.message || err}\n\nPlease try again.`);
      }
    }

    // Keep bookmarked IDs available for modal + re-fetch Discovery after plan changes
    const _originalRenderResults = renderResults;
    window._currentUserId = <%= userId || 0 %>;
    async function signOut() {
      try {
        const response = await fetch('/auth/logout', { method: 'POST' });
        if (!response.ok) throw new Error('Sign-out failed. Please try again.');
        window.location.href = '/';
      } catch (error) {
        alert(error.message || 'Sign-out failed. Please try again.');
      }
    }
    setupPantryEditor();
    renderResults = function(data, bookmarkedIds, shouldScroll = true) {
      window._bookmarkedIds = bookmarkedIds || [];
      _originalRenderResults(data, bookmarkedIds, shouldScroll);
      updateSavedPlansActiveState();
      if (window._discoveryData) loadDiscoveryRecipes();
    };

    async function loadLatestPlan() {
      try {
        const res = await fetch('/api/planner/latest');
        if (res.status === 404) return;
        if (!res.ok) throw new Error(`Request failed (${res.status})`);

        const data = await res.json();
        renderResults(data, data.bookmarked_recipe_ids || [], false);
      } catch (err) {
        plannerReportError(err, 'loadLatestPlan');
        console.error('[loadLatestPlan]', err);
      }
    }

    setupPlannerPreferencePersistence();
    setupGrocerySearch();
    setupCustomGroceryItem();
    restorePlannerPreferences();
    loadPantryItems();
    loadLatestPlan();
    loadSavedPlans();
    loadDiscoveryRecipes();
  </script>
</body>
</html>
