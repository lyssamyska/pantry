<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..900;1,9..144,300..900&family=DM+Sans:ital,wght@0,300..700;1,300..700&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    :root { --cream: #FAF7F2; --green: #2A4D1E; --green-light: #3D6B2D; --sienna: #C8561A; --near-black: #1A1A18; --warm-gray: #5A5449; --divider: #DDD8CF; }
    body { min-height: 100vh; margin: 0; background: var(--cream); color: var(--near-black); font-family: 'DM Sans', system-ui, sans-serif; line-height: 1.6; }
    nav { min-height: 64px; padding: 12px 32px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--divider); background: rgba(250,247,242,0.96); }
    .nav-logo { color: var(--green); font: 700 1.4rem 'Fraunces', serif; text-decoration: none; }
    .nav-logo span { color: var(--sienna); }
    nav a:not(.nav-logo) { color: var(--warm-gray); font-size: 0.9rem; font-weight: 600; text-decoration: none; }
    nav a:hover { color: var(--green); }
    a:focus-visible, button:focus-visible { outline: 3px solid var(--sienna); outline-offset: 3px; }
    main { width: min(100% - 32px, 560px); margin: 0 auto; padding: 112px 0 64px; }
    .success-card { padding: 36px 32px; border: 1px solid var(--divider); border-radius: 18px; background: #fff; box-shadow: 0 4px 20px rgba(0,0,0,0.04); }
    h1 { margin: 0 0 10px; color: var(--near-black); font: 800 clamp(2rem, 5vw, 2.8rem)/1.15 'Fraunces', serif; letter-spacing: -0.03em; }
    h1 em { color: var(--green); font-weight: 600; }
    p { margin: 0 0 22px; color: var(--warm-gray); }
    .status { min-height: 28px; color: var(--green); }
    .status.error { color: #b42318; }
    .retry { min-height: 44px; padding: 10px 18px; border: 0; border-radius: 9px; background: var(--green); color: #fff; font: 700 0.95rem 'DM Sans', sans-serif; cursor: pointer; }
    .retry:hover { background: var(--green-light); }
    .back-link { display: inline-block; margin-top: 22px; color: var(--green); font-weight: 700; text-decoration: none; }
    @media (max-width: 560px) { nav { padding: 12px 16px; } main { padding-top: 84px; } .success-card { padding: 26px 20px; } }
  </style>
</head>
<body>
  <nav aria-label="Main navigation">
    <a class="nav-logo" href="/planner">Pantry<span>.</span></a>
    <a href="/profile">Profile</a>
  </nav>
  <main>
    <section class="success-card" aria-labelledby="paymentTitle">
      <h1 id="paymentTitle">Confirming your <em>purchase.</em></h1>
      <p id="paymentStatus" class="status" role="status" aria-live="polite">We’re checking the payment record. This can take a moment.</p>
      <button id="retryButton" class="retry" type="button" hidden>Try again</button>
      <a class="back-link" href="/profile">Return to your profile</a>
    </section>
  </main>
  <script>
    const sessionId = new URL(window.location.href).searchParams.get('session_id');
    const statusElement = document.getElementById('paymentStatus');
    const retryButton = document.getElementById('retryButton');
    const maxAttempts = 15;
    const pollIntervalMs = 2000;
    let attempts = 0;
    let polling = false;

    function showError(message) {
      statusElement.textContent = message;
      statusElement.classList.add('error');
      retryButton.hidden = false;
    }

    async function pollPayment() {
      if (polling) return;
      polling = true;
      retryButton.hidden = true;
      statusElement.classList.remove('error');
      if (!sessionId) {
        showError('This checkout return is missing its session. No access was changed.');
        polling = false;
        return;
      }
      while (attempts < maxAttempts) {
        attempts += 1;
        try {
          const response = await fetch('/payments/poll?session_id=' + encodeURIComponent(sessionId), { headers: { Accept: 'application/json' } });
          const data = await response.json();
          if (response.ok && data.verified === true && data.accessGranted === true) {
            statusElement.textContent = 'Your paid access is ready.';
            polling = false;
            return;
          }
          if (!response.ok && response.status !== 404 && response.status !== 503) {
            throw new Error(data.message || 'We could not verify this checkout.');
          }
        } catch (error) {
          if (attempts >= maxAttempts) {
            showError(error.message || 'We could not verify this checkout. No access was changed.');
            polling = false;
            return;
          }
        }
        await new Promise((resolve) => setTimeout(resolve, pollIntervalMs));
      }
      showError('Payment confirmation is taking longer than expected. No access was changed.');
      polling = false;
    }

    retryButton.addEventListener('click', function () {
      attempts = 0;
      pollPayment();
    });
    pollPayment();
  </script>
</body>
</html>
