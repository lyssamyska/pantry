<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Pantry — Smart Meal Planning</title>
  <meta name="description" content="Smart meal planning that finds the best prices and respects quality sourcing standards. Plan your week around H-E-B deals, farmers markets, and CSA pickups.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..900;1,9..144,300..900&family=DM+Sans:ital,wght@0,300..700;1,300..700&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --white: #FFFFFF;
      --white-warm: #FAFAF8;
      --white-cool: #F8F8F6;
      --green: #2A4D1E;
      --green-light: #3D6B2D;
      --green-pale: #EDF4E3;
      --sienna: #C8561A;
      --sienna-light: #E07040;
      --near-black: #1A1A1A;
      --warm-gray: #5A5449;
      --light-gray: #8C8377;
      --divider: #EDEDEA;
    }

    html { scroll-behavior: smooth; }

    body {
      font-family: 'DM Sans', system-ui, sans-serif;
      background: var(--white);
      color: var(--near-black);
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
    }

    ::selection { background: var(--green); color: var(--white); }

    /* ── NAV ── */
    nav {
      position: fixed;
      top: 0; left: 0; right: 0;
      z-index: 100;
      padding: 20px 48px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: rgba(255,255,255,0.96);
      backdrop-filter: blur(16px);
      border-bottom: 1px solid var(--divider);
    }
    .nav-logo {
      font-family: 'Fraunces', serif;
      font-size: 1.4rem;
      font-weight: 700;
      color: var(--green);
      letter-spacing: -0.02em;
    }
    .nav-logo span { color: var(--sienna); }
    .nav-links {
      display: flex;
      gap: 36px;
      list-style: none;
    }
    .nav-links a {
      color: var(--warm-gray);
      text-decoration: none;
      font-size: 0.875rem;
      font-weight: 500;
      transition: color 0.2s;
    }
    .nav-links a:hover { color: var(--green); }
    .nav-cta {
      background: var(--near-black);
      color: var(--white);
      text-decoration: none;
      font-size: 0.8rem;
      font-weight: 600;
      padding: 9px 20px;
      border-radius: 6px;
      letter-spacing: 0.02em;
      transition: background 0.2s;
      border: none;
      cursor: pointer;
    }
    .nav-cta:hover { background: #333333; }
    .nav-actions { display: flex; align-items: center; gap: 10px; }
    .nav-account {
      padding: 9px 8px; border: 0; background: transparent; color: var(--warm-gray);
      font: 600 0.8rem 'DM Sans', sans-serif; cursor: pointer;
    }
    .nav-account:hover { color: var(--green); }
    #otp-modal {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.55);
      z-index: 1000;
      align-items: center;
      justify-content: center;
    }
    .otp-card {
      background: #fff;
      border-radius: 12px;
      padding: 36px 32px 28px;
      width: min(100% - 32px, 380px);
      position: relative;
      font-family: 'DM Sans', sans-serif;
    }
    .otp-card h2 { font-family: 'Fraunces', serif; font-size: 1.4rem; color: #1a1a1a; margin: 0 0 6px; }
    .otp-card p { font-size: 0.85rem; color: #555; margin: 0 0 20px; }
    .otp-card input {
      width: 100%;
      padding: 10px 12px;
      border: 1.5px solid #ddd;
      border-radius: 6px;
      font-size: 1rem;
      box-sizing: border-box;
      margin-bottom: 10px;
    }
    .otp-card input:focus { outline: none; border-color: #2A4D1E; }
    .otp-card input:focus-visible, .otp-btn:focus-visible, .otp-close:focus-visible { outline: 3px solid #C8561A; outline-offset: 3px; }
    .otp-btn {
      width: 100%;
      background: #2A4D1E;
      color: #fff;
      border: none;
      border-radius: 6px;
      padding: 11px;
      font-size: 0.95rem;
      font-weight: 600;
      cursor: pointer;
      margin-top: 4px;
    }
    .otp-btn:hover { background: #1e3a15; }
    .otp-error { color: #c0392b; font-size: 0.8rem; min-height: 18px; margin-bottom: 4px; }
    .otp-close {
      position: absolute;
      top: 12px; right: 16px;
      background: none; border: none;
      font-size: 1.4rem; cursor: pointer; color: #888;
    }

    /* ── HERO ── */
    .hero {
      min-height: 100vh;
      display: grid;
      grid-template-columns: 1fr 1fr;
      align-items: center;
      padding: 120px 80px 80px;
      gap: 60px;
      max-width: 1400px;
      margin: 0 auto;
    }
    .hero-content { padding-right: 20px; }
    .hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: var(--green-pale);
      color: var(--green);
      font-size: 0.75rem;
      font-weight: 600;
      padding: 5px 12px;
      border-radius: 20px;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      margin-bottom: 28px;
    }
    .hero-badge svg { flex-shrink: 0; }
    .hero h1 {
      font-family: 'Fraunces', serif;
      font-size: clamp(3rem, 5.5vw, 5.5rem);
      font-weight: 800;
      line-height: 1.05;
      letter-spacing: -0.03em;
      color: var(--near-black);
      margin-bottom: 24px;
    }
    .hero h1 em {
      font-style: italic;
      color: var(--green);
    }
    .hero-sub {
      font-size: 1.15rem;
      color: var(--warm-gray);
      line-height: 1.65;
      max-width: 440px;
      margin-bottom: 40px;
    }
    .hero-deal {
      background: linear-gradient(135deg, #1A1A18 0%, #2A2A26 100%);
      border-radius: 14px;
      padding: 24px 28px;
      display: inline-flex;
      align-items: center;
      gap: 20px;
    }
    .deal-icon {
      width: 52px;
      height: 52px;
      border-radius: 12px;
      background: var(--sienna);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
    .deal-text { color: var(--white); }
    .deal-label {
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: rgba(255,255,255,0.5);
      margin-bottom: 2px;
    }
    .deal-item {
      font-family: 'Fraunces', serif;
      font-size: 0.95rem;
      font-weight: 600;
      color: var(--white);
    }
    .deal-meta { font-size: 0.75rem; color: rgba(255,255,255,0.55); margin-top: 2px; }

    /* ── HERO ILLUSTRATION ── */
    .hero-illustration {
      position: relative;
      height: 560px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    /* App window browser chrome */
    .app-window {
      width: 420px;
      border-radius: 14px;
      background: #fff;
      box-shadow: 0 8px 40px rgba(0,0,0,0.18), 0 2px 8px rgba(0,0,0,0.08);
      overflow: hidden;
      transform: rotate(-1.5deg);
      position: relative;
    }
    .app-bar {
      background: #F4F2ED;
      padding: 10px 14px;
      display: flex;
      align-items: center;
      gap: 8px;
      border-bottom: 1px solid #E8E4DC;
    }
    .app-dot {
      width: 10px; height: 10px;
      border-radius: 50%;
      flex-shrink: 0;
    }
    .app-url-bar {
      flex: 1;
      margin-left: 6px;
      background: white;
      border: 1px solid #E8E4DC;
      border-radius: 6px;
      padding: 4px 10px;
      font-family: 'DM Sans', sans-serif;
      font-size: 0.62rem;
      color: var(--light-gray);
      text-align: center;
    }
    .app-body {
      display: grid;
      grid-template-columns: 110px 1fr 100px;
      min-height: 320px;
    }
    .app-sidebar {
      background: #F8F8F6;
      padding: 14px 10px;
      border-right: 1px solid #E8E4DC;
    }
    .app-logo-sm {
      display: flex;
      align-items: center;
      gap: 5px;
      margin-bottom: 16px;
    }
    .sidebar-label {
      font-size: 0.55rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--light-gray);
      margin-bottom: 8px;
      padding-left: 2px;
    }
    .sidebar-item {
      display: grid;
      grid-template-columns: 26px 1fr;
      grid-template-rows: auto auto;
      gap: 1px 4px;
      padding: 5px 4px;
      border-radius: 6px;
      margin-bottom: 2px;
    }
    .sidebar-item.active { background: #E8EFDE; }
    .si-day { font-size: 0.55rem; font-weight: 700; color: var(--light-gray); text-transform: uppercase; letter-spacing: 0.04em; grid-row: 1 / 3; display: flex; align-items: center; }
    .si-meal { font-size: 0.58rem; font-weight: 500; color: var(--near-black); grid-column: 2; }
    .si-tag {
      display: inline-block;
      font-size: 0.48rem;
      font-weight: 700;
      padding: 1px 5px;
      border-radius: 3px;
      grid-column: 2;
    }
    .si-tag--green { background: var(--green-pale); color: var(--green); }
    .si-tag--farm { background: #FDF3E8; color: #9A5220; }

    .app-main {
      padding: 14px 12px;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .app-week-label {
      font-size: 0.58rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--light-gray);
      margin-bottom: 4px;
      padding-bottom: 6px;
      border-bottom: 1px solid var(--divider);
    }
    .app-meal-card {
      background: var(--white);
      border-radius: 8px;
      padding: 10px 10px 10px 8px;
      display: grid;
      grid-template-columns: 36px 1fr auto;
      gap: 8px;
      align-items: center;
      border: 1px solid var(--divider);
    }
    .amc-left {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 3px;
    }
    .amc-day {
      font-size: 0.55rem;
      font-weight: 800;
      text-transform: uppercase;
      color: var(--green);
      letter-spacing: 0.06em;
    }
    .amc-icon { display: flex; }
    .amc-title {
      font-family: 'Fraunces', serif;
      font-size: 0.78rem;
      font-weight: 700;
      color: var(--near-black);
      margin-bottom: 1px;
    }
    .amc-sub { font-size: 0.58rem; color: var(--light-gray); margin-bottom: 4px; }
    .amc-tags { display: flex; gap: 4px; flex-wrap: wrap; }
    .amc-tag {
      font-size: 0.52rem;
      font-weight: 600;
      padding: 2px 5px;
      border-radius: 3px;
      background: var(--white-cool);
      color: var(--warm-gray);
    }
    .amc-tag--savings { background: var(--green-pale); color: var(--green); }
    .amc-tag--farm { background: #FDF8F4; color: #9A5220; }
    .amc-meta { text-align: right; }
    .amc-price {
      font-family: 'Fraunces', serif;
      font-size: 0.9rem;
      font-weight: 800;
      color: var(--green);
    }
    .amc-time { font-size: 0.55rem; color: var(--light-gray); margin-top: 1px; }

    .app-list-panel {
      background: #F8F8F6;
      padding: 12px 8px;
      border-left: 1px solid #E8E4DC;
    }
    .alp-title {
      font-size: 0.6rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--near-black);
      margin-bottom: 8px;
    }
    .alp-section-label {
      font-size: 0.5rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--light-gray);
      margin: 8px 0 4px;
    }
    .alp-item {
      display: flex;
      align-items: center;
      gap: 5px;
      font-size: 0.6rem;
      color: var(--near-black);
      padding: 3px 0;
      border-bottom: 1px dashed rgba(0,0,0,0.06);
    }
    .alp-dot {
      width: 6px; height: 6px;
      border-radius: 50%;
      flex-shrink: 0;
    }

    /* floating cards */
    .float-card {
      position: absolute;
      border-radius: 12px;
      box-shadow: 0 8px 30px rgba(0,0,0,0.12);
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 10px 14px;
      background: white;
      z-index: 10;
    }
    .float-tomato {
      top: 10px; right: -8px;
      animation: float1 4s ease-in-out infinite;
    }
    .float-herb {
      bottom: 30px; right: -8px;
      animation: float2 5s ease-in-out infinite;
    }
    @keyframes float1 { 0%,100% { transform: translateY(0) rotate(3deg); } 50% { transform: translateY(-8px) rotate(3deg); } }
    @keyframes float2 { 0%,100% { transform: translateY(0) rotate(-2deg); } 50% { transform: translateY(-6px) rotate(-2deg); } }

    /* ── MARGIN SECTION ── */
    .margin-strip {
      background: var(--near-black);
      padding: 48px 80px;
    }
    .margin-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 0;
      max-width: 1400px;
      margin: 0 auto;
      border-left: 1px solid rgba(255,255,255,0.08);
    }
    .margin-stat {
      padding: 0 40px;
      border-right: 1px solid rgba(255,255,255,0.08);
    }
    .margin-stat:first-child { padding-left: 0; }
    .margin-stat:last-child { border-right: none; }
    .margin-number {
      font-family: 'Fraunces', serif;
      font-size: 2.8rem;
      font-weight: 800;
      color: var(--white);
      line-height: 1;
      margin-bottom: 4px;
    }
    .margin-label {
      font-size: 0.8rem;
      color: rgba(255,255,255,0.4);
      line-height: 1.4;
    }

    /* ── HOW IT WORKS ── */
    .section { padding: 100px 80px; max-width: 1400px; margin: 0 auto; }
    .section-tag {
      font-size: 0.72rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--sienna);
      margin-bottom: 14px;
    }
    .section-title {
      font-family: 'Fraunces', serif;
      font-size: clamp(2rem, 3.5vw, 3rem);
      font-weight: 700;
      line-height: 1.15;
      letter-spacing: -0.02em;
      color: var(--near-black);
      max-width: 560px;
      margin-bottom: 16px;
    }
    .section-title em { font-style: italic; color: var(--green); }
    .section-desc {
      font-size: 1rem;
      color: var(--warm-gray);
      max-width: 480px;
      line-height: 1.65;
      margin-bottom: 60px;
    }

    .steps {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 40px;
    }
    .step { position: relative; }
    .step-number {
      font-family: 'Fraunces', serif;
      font-size: 4rem;
      font-weight: 800;
      color: var(--green-pale);
      line-height: 1;
      margin-bottom: 20px;
      display: block;
    }
    .step h3 {
      font-family: 'Fraunces', serif;
      font-size: 1.2rem;
      font-weight: 700;
      color: var(--near-black);
      margin-bottom: 10px;
    }
    .step p { font-size: 0.9rem; color: var(--warm-gray); line-height: 1.6; }

    /* ── MARKET INTELLIGENCE ── */
    .market-section {
      background: var(--white-cool);
      padding: 100px 80px;
    }
    .market-inner { max-width: 1400px; margin: 0 auto; }
    .market-header { display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 56px; }
    .market-header-text { max-width: 520px; }
    .market-deals {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }
    .deal-card {
      background: white;
      border-radius: 16px;
      overflow: hidden;
      border: 1px solid var(--divider);
      transition: transform 0.25s, box-shadow 0.25s;
    }
    .deal-card:hover { transform: translateY(-4px); box-shadow: 0 16px 40px rgba(0,0,0,0.08); }
    .deal-visual {
      height: 120px;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      overflow: hidden;
    }
    .dv-heb { background: linear-gradient(135deg, #1A5EA8 0%, #0D3F7A 100%); }
    .dv-farmers { background: linear-gradient(135deg, #2A4D1E 0%, #1A3510 100%); }
    .dv-csa { background: linear-gradient(135deg, #7A4A1E 0%, #5C3412 100%); }
    .deal-visual-icon { font-size: 3rem; }
    .deal-store-badge {
      position: absolute;
      top: 12px; left: 12px;
      background: rgba(255,255,255,0.2);
      backdrop-filter: blur(8px);
      color: white;
      font-size: 0.65rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      padding: 4px 10px;
      border-radius: 6px;
    }
    .deal-body { padding: 20px 24px 24px; }
    .deal-name {
      font-family: 'Fraunces', serif;
      font-size: 1.05rem;
      font-weight: 700;
      color: var(--near-black);
      margin-bottom: 6px;
    }
    .deal-desc { font-size: 0.82rem; color: var(--warm-gray); line-height: 1.5; margin-bottom: 14px; }
    .deal-highlight {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 12px 14px;
      background: var(--green-pale);
      border-radius: 8px;
    }
    .deal-highlight-text { font-size: 0.78rem; font-weight: 600; color: var(--green); }
    .deal-highlight-val {
      font-family: 'Fraunces', serif;
      font-size: 1.2rem;
      font-weight: 800;
      color: var(--green);
    }

    /* ── THE PANTRY STANDARD ── */
    .standard-section { padding: 100px 80px; max-width: 1400px; margin: 0 auto; }
    .standard-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 80px;
      align-items: center;
    }
    .standard-content .section-tag { margin-bottom: 12px; }
    .standard-content .section-title { font-size: clamp(1.8rem, 3vw, 2.6rem); margin-bottom: 20px; }
    .standard-content .section-desc { margin-bottom: 36px; }
    .standard-list { list-style: none; display: flex; flex-direction: column; gap: 16px; }
    .standard-list li {
      display: flex;
      align-items: flex-start;
      gap: 14px;
      font-size: 0.92rem;
      color: var(--near-black);
      line-height: 1.5;
    }
    .check-icon {
      width: 22px;
      height: 22px;
      border-radius: 50%;
      background: var(--green);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      margin-top: 1px;
    }
    .standard-image {
      border-radius: 20px;
      overflow: hidden;
      aspect-ratio: 4/3;
      background: linear-gradient(160deg, #E8EFDE 0%, #C8DDB8 50%, #A8C898 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
    }
    .std-grid-art {
      display: grid;
      grid-template-columns: 1fr 1fr;
      grid-template-rows: 1fr 1fr;
      gap: 16px;
      padding: 40px;
      width: 100%;
      height: 100%;
    }
    .std-cell {
      border-radius: 14px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 20px;
      text-align: center;
    }
    .std-cell-icon { font-size: 2.2rem; }
    .std-cell-label { font-size: 0.72rem; font-weight: 600; color: rgba(0,0,0,0.55); text-transform: uppercase; letter-spacing: 0.06em; }
    .sc1 { background: rgba(255,255,255,0.7); }
    .sc2 { background: rgba(42,77,30,0.08); }
    .sc3 { background: rgba(200,86,26,0.08); }
    .sc4 { background: rgba(255,255,255,0.5); }

    /* ── CLOSING ── */
    .closing-section {
      background: var(--near-black);
      padding: 120px 80px;
      text-align: center;
    }
    .closing-inner { max-width: 680px; margin: 0 auto; }
    .closing-icon {
      font-size: 4rem;
      margin-bottom: 28px;
      display: block;
    }
    .closing-title {
      font-family: 'Fraunces', serif;
      font-size: clamp(2.2rem, 4vw, 3.8rem);
      font-weight: 800;
      color: var(--white);
      line-height: 1.1;
      letter-spacing: -0.03em;
      margin-bottom: 24px;
    }
    .closing-title em { color: var(--sienna-light); font-style: italic; }
    .closing-sub {
      font-size: 1.05rem;
      color: rgba(255,255,255,0.45);
      line-height: 1.65;
      margin-bottom: 48px;
    }
    .closing-rule {
      width: 48px;
      height: 2px;
      background: var(--sienna);
      margin: 0 auto 48px;
      border-radius: 2px;
    }
    .closing-values {
      display: flex;
      gap: 32px;
      justify-content: center;
      flex-wrap: wrap;
    }
    .closing-value {
      display: flex;
      align-items: center;
      gap: 8px;
      color: rgba(255,255,255,0.3);
      font-size: 0.8rem;
    }

    /* ── FOOTER ── */
    footer {
      background: #141412;
      padding: 28px 80px;
      display: flex;
      align-items: center;
      justify-content: space-between;
