  <script>
    const accountModal = document.getElementById('otp-modal');
    const accountEmail = document.getElementById('otp-email');

    function openAccountDialog() {
      accountModal.style.display = 'flex';
      accountModal.setAttribute('aria-hidden', 'false');
      if (document.getElementById('otp-step-code').style.display === 'block') {
        document.getElementById('otp-code').focus();
      } else {
        accountEmail.focus();
      }
    }

    function closeAccountDialog() {
      accountModal.style.display = 'none';
      accountModal.setAttribute('aria-hidden', 'true');
    }

    async function requestOtp(email, isResend) {
      const button = document.getElementById(isResend ? 'otp-resend-button' : 'otp-request-button');
      const error = document.getElementById(isResend ? 'otp-code-error' : 'otp-email-error');
      button.disabled = true;
      error.textContent = '';
      try {
        const response = await fetch('/auth/otp/request', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email })
        });
        const data = await response.json();
        if (!response.ok || !data.success) throw new Error(data.message || 'Could not send a code. Please try again.');
        if (isResend) {
          error.textContent = 'A new sign-in code is on its way.';
        } else {
          document.getElementById('otp-sent-email').textContent = email;
          document.getElementById('otp-step-email').style.display = 'none';
          document.getElementById('otp-step-code').style.display = 'block';
          document.getElementById('otp-code-error').textContent = 'A sign-in code is on its way.';
          document.getElementById('otp-code').focus();
        }
      } catch (error) {
        document.getElementById(isResend ? 'otp-code-error' : 'otp-email-error').textContent = error.message || 'Network error. Please try again.';
      } finally {
        button.disabled = false;
      }
    }

    document.getElementById('otp-email-form').addEventListener('submit', function (event) {
      event.preventDefault();
      if (!accountEmail.reportValidity()) return;
      requestOtp(accountEmail.value.trim().toLowerCase());
    });

    document.getElementById('otp-code-form').addEventListener('submit', async function (event) {
      event.preventDefault();
      const codeInput = document.getElementById('otp-code');
      const code = codeInput.value.trim();
      const button = document.getElementById('otp-verify-button');
      const error = document.getElementById('otp-code-error');
      error.textContent = '';
      if (!/^[0-9]{6}$/.test(code)) {
        error.textContent = 'Enter the six-digit code from your email.';
        return;
      }
      button.disabled = true;
      try {
        const response = await fetch('/auth/otp/verify', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: accountEmail.value.trim().toLowerCase(), code })
        });
        const data = await response.json();
        if (!response.ok || !data.success) throw new Error(data.message || 'Verification failed. Please try again.');
        window.location.href = '/planner';
      } catch (error) {
        document.getElementById('otp-code-error').textContent = error.message || 'Network error. Please try again.';
      } finally {
        button.disabled = false;
      }
    });

    document.getElementById('otp-resend-button').addEventListener('click', function () {
      requestOtp(accountEmail.value.trim().toLowerCase(), true);
    });
    document.getElementById('otp-back-button').addEventListener('click', function () {
      document.getElementById('otp-step-code').style.display = 'none';
      document.getElementById('otp-step-email').style.display = 'block';
      document.getElementById('otp-email-error').textContent = '';
      accountEmail.focus();
    });
    accountModal.addEventListener('click', function (event) {
      if (event.target === accountModal) closeAccountDialog();
    });
    document.addEventListener('keydown', function (event) {
      if (event.key === 'Escape' && accountModal.style.display === 'flex') closeAccountDialog();
    });
    if (new URLSearchParams(window.location.search).get('account') === '1') openAccountDialog();
  </script>
