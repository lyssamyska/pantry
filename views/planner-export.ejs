<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..900;1,9..144,300..900&family=DM+Sans:ital,wght@0,300..700;1,300..700&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --cream: #FAF7F2;
      --cream-dark: #F0EBE0;
      --green: #2A4D1E;
      --green-light: #3D6B2D;
      --green-pale: #E8EFDE;
      --sienna: #C8561A;
      --sienna-light: #E07040;
      --near-black: #1A1A18;
      --warm-gray: #5A5449;
      --light-gray: #8C8377;
      --divider: #DDD8CF;
    }
    html { scroll-behavior: smooth; }
    body {
      font-family: 'DM Sans', system-ui, sans-serif;
      background: var(--cream);
      color: var(--near-black);
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
      max-width: 800px;
      margin: 0 auto;
      padding: 48px 56px;
    }
    ::selection { background: var(--green); color: var(--cream); }

    .export-header {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 16px;
      margin-bottom: 28px;
      padding-bottom: 18px;
      border-bottom: 2px solid var(--divider);
      flex-wrap: wrap;
    }
    .export-title {
      font-family: 'Fraunces', serif;
      font-size: 1.8rem;
      font-weight: 700;
      letter-spacing: -0.02em;
      color: var(--near-black);
    }
    .export-title .nav-logo {
      display: inline-block;
      font-family: 'Fraunces', serif;
      font-size: 1.4rem;
      font-weight: 700;
      color: var(--green);
      letter-spacing: -0.02em;
      margin-left: 6px;
    }
    .export-title .nav-logo span { color: var(--sienna); }

    .print-toolbar {
      display: flex;
      gap: 10px;
      align-items: center;
    }
    .print-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: white;
      border: 1.5px solid var(--divider);
      color: var(--warm-gray);
      padding: 10px 20px;
      border-radius: 8px;
      font-size: 0.85rem;
      font-weight: 500;
      cursor: pointer;
      font-family: 'DM Sans', sans-serif;
      transition: all 0.2s;
    }
    .print-btn:hover { border-color: var(--green); color: var(--green); }
    .print-btn--copied { border-color: var(--green) !important; color: var(--green) !important; }
    .print-btn--instacart { background: var(--green); border-color: var(--green); color: var(--cream); }
    .print-btn--instacart:hover { background: var(--green-light); border-color: var(--green-light); color: var(--cream); }
    .print-btn--instacart.print-btn--copied { background: white; }
    .print-btn--instacart:disabled { opacity: 0.5; cursor: not-allowed; }

    .grocery-category { margin-bottom: 20px; }
    .grocery-category h4 {
      font-size: 0.72rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--light-gray);
      margin-bottom: 8px;
      padding-bottom: 6px;
      border-bottom: 1px solid var(--divider);
    }
    .grocery-category.grocery-category-pantry h4 { color: var(--green); border-bottom-color: rgba(42,77,30,0.2); }
    .grocery-category.grocery-category-csa h4 { color: var(--green); border-bottom-color: rgba(42,77,30,0.2); }
    .grocery-item {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 8px 0;
      border-bottom: 1px dashed var(--divider);
    }
    .grocery-item:last-child { border-bottom: none; }
    .grocery-dot {
      width: 6px; height: 6px;
      border-radius: 50%;
      background: var(--green);
      flex-shrink: 0;
    }
    .grocery-item.grocery-item-pantry .grocery-dot { background: var(--green-light); }
    .grocery-item.grocery-item-csa .grocery-dot { background: var(--green-light); }
    .grocery-name { font-size: 0.9rem; color: var(--near-black); flex: 1; }
    .grocery-item.grocery-item-pantry .grocery-name { color: var(--warm-gray); }
    .grocery-item.grocery-item-csa .grocery-name { color: var(--warm-gray); }
    .grocery-note-print {
      display: block;
      margin-top: 2px;
      color: var(--warm-gray);
      font-size: 0.76rem;
      font-weight: 400;
    }
    .grocery-pantry-tag {
      font-size: 0.7rem;
      font-weight: 600;
      color: var(--green);
      background: var(--green-pale);
      padding: 2px 8px;
      border-radius: 10px;
      white-space: nowrap;
    }
    .grocery-csa-tag {
      font-size: 0.7rem;
      font-weight: 600;
      color: var(--green);
      background: var(--green-pale);
      padding: 2px 8px;
      border-radius: 10px;
      white-space: nowrap;
    }
    .grocery-qty { font-size: 0.8rem; color: var(--light-gray); font-weight: 500; }
    .grocery-price-inline {
      font-size: 0.8rem;
      color: var(--green);
      font-weight: 600;
      font-family: 'Fraunces', serif;
      white-space: nowrap;
    }
    .grocery-price-inline--none {
      color: var(--light-gray);
      font-weight: 500;
    }

    .grocery-store { margin-bottom: 22px; page-break-inside: avoid; break-inside: avoid; }
    .grocery-store-header {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 12px;
      padding-bottom: 8px;
      border-bottom: 1.5px solid var(--divider);
      margin-bottom: 8px;
    }
    .grocery-store-name {
      font-size: 0.72rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--light-gray);
    }
    .grocery-store-subtotal {
      font-family: 'Fraunces', serif;
      font-size: 0.95rem;
      color: var(--green);
      font-weight: 600;
      white-space: nowrap;
    }
    .grocery-store-empty-stub {
      font-size: 0.85rem;
      color: var(--light-gray);
      font-style: italic;
      padding: 6px 0;
    }
    .grocery-store + .grocery-store { page-break-before: auto; }

    .empty-state {
      padding: 40px 24px;
      background: white;
      border: 1px dashed var(--divider);
      border-radius: 12px;
      color: var(--warm-gray);
      font-size: 1rem;
      text-align: center;
    }
    .empty-state a { color: var(--green); text-decoration: underline; font-weight: 600; }

    @media print {
      body { background: white; color: black; font-size: 11pt; padding: 24px 18px; max-width: none; }
      .print-toolbar { display: none !important; }
      .export-header { border-bottom: 2px solid #000; margin-bottom: 18px; }
      a { color: inherit; text-decoration: none; }
      .grocery-store { page-break-inside: avoid; break-inside: avoid; }
      .empty-state { border: none; padding: 0; text-align: left; }
    }
  </style>
</head>
<body>
  <header class="export-header">
    <div class="export-title">
      Grocery list
      <span class="nav-logo">Pantry<span>.</span></span>
    </div>
    <div class="print-toolbar">
      <button class="print-btn" onclick="window.print()" type="button">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9V2h12v7M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2M6 14h12v8H6z"/></svg>
        Print list
      </button>
      <button class="print-btn" id="copy-btn" onclick="copyList()" type="button">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
        Copy list
      </button>
      <button class="print-btn print-btn--instacart" id="instacart-btn" onclick="downloadInstacartCsv()" type="button" <%= !hasPlan ? 'disabled' : '' %>>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="20" r="1"/><circle cx="19" cy="20" r="1"/><path d="M3 4h2l2.4 11.5a2 2 0 0 0 2 1.5h7.7a2 2 0 0 0 1.9-1.4L21 8H6"/></svg>
        Order on Instacart
      </button>
    </div>
  </header>

<script>
  const _rawByStore = <%- hasPlan ? JSON.stringify(byStore) : 'null' %>;
  const _supportedAustinStoreNames = new Set(<%- JSON.stringify(supportedAustinStoreNames || []) %>);
  const _planId = <%- JSON.stringify(planId) %>;

  function isSupportedAustinStoreName(name) {
    return _supportedAustinStoreNames.has(String(name || '').trim());
  }

  function normalizeStoreBuckets(rawByStore) {
    if (!rawByStore) return null;
    const stores = {};
    const other = [];
    for (const [name, items] of Object.entries(rawByStore.stores || {})) {
      for (const item of items || []) {
        const itemStore = item && item.best_store;
        if (isSupportedAustinStoreName(name) && (!itemStore || isSupportedAustinStoreName(itemStore))) {
          if (!stores[name]) stores[name] = [];
          stores[name].push(item);
        } else {
          other.push(itemStore ? { ...item, best_store: null } : item);
        }
      }
    }
    for (const item of rawByStore.other || []) {
      other.push(item && item.best_store ? { ...item, best_store: null } : item);
    }
    return { stores, other, pantry: rawByStore.pantry || [], csa: rawByStore.csa || [] };
  }

  const _byStore = normalizeStoreBuckets(_rawByStore);

  function getGroceryLineCost(item) {
    const lineTotal = item && item.line_total;
    if (lineTotal !== null && lineTotal !== undefined && lineTotal !== '' && Number.isFinite(Number(lineTotal))) {
      return Number(lineTotal);
    }
    const price = Number(item && item.best_price);
    if (!Number.isFinite(price)) return 0;
    const match = String((item && item.quantity) || '').match(/^[\/\\.0-9]+/);
    const quantity = match ? parseFloat(match[0]) : 1;
    return price * (Number.isFinite(quantity) ? quantity : 1);
  }

  function hasNumericValue(value) {
    return value !== null && value !== undefined && value !== '' && Number.isFinite(Number(value));
  }

  function copyList() {
    if (!_byStore) return;
    const fmtPrice = (n) => '$' + Number(n || 0).toFixed(2);
    const lines = [];
    let grandTotal = 0;

    const storeEntries = Object.entries(_byStore.stores || {})
      .map(([name, items]) => ({ name, items, subtotal: items.reduce((s, i) => s + getGroceryLineCost(i), 0) }))
      .filter(e => e.items && e.items.length > 0)
      .sort((a, b) => b.subtotal - a.subtotal);

    for (const entry of storeEntries) {
      lines.push(entry.name.toUpperCase() + ' — Subtotal: ' + fmtPrice(entry.subtotal));
      for (const item of entry.items) {
        const qty = item.quantity ? ' (' + item.quantity + ')' : '';
        const hasPrice = Boolean(item.best_price) && Number.isFinite(Number(item.best_price));
        const price = hasPrice ? '  ' + fmtPrice(getGroceryLineCost(item)) : '';
        const note = typeof item.note === 'string' && item.note.trim() ? ' — note: ' + item.note.trim() : '';
        lines.push('• ' + item.name + qty + price + note);
      }
      lines.push('');
      grandTotal += entry.subtotal;
    }

    const other = _byStore.other || [];
    const otherSubtotal = other.reduce((s, i) => s + getGroceryLineCost(i), 0);
    if (other.length > 0) {
      lines.push('OTHER');
      for (const item of other) {
        const qty = item.quantity ? ' (' + item.quantity + ')' : '';
        const hasPrice = Boolean(item.best_price) && Number.isFinite(Number(item.best_price));
        const price = hasPrice ? '  ' + fmtPrice(getGroceryLineCost(item)) : '';
        const note = typeof item.note === 'string' && item.note.trim() ? ' — note: ' + item.note.trim() : '';
        lines.push('• ' + item.name + qty + price + note);
      }
      lines.push('Subtotal: ' + fmtPrice(otherSubtotal));
      lines.push('');
      grandTotal += otherSubtotal;
    }

    const pantry = _byStore.pantry || [];
    if (pantry.length > 0) {
      lines.push('IN PANTRY');
      for (const item of pantry) {
        const qty = item.quantity ? ' (' + item.quantity + ')' : '';
        const note = typeof item.note === 'string' && item.note.trim() ? ' — note: ' + item.note.trim() : '';
        lines.push('✓ ' + item.name + qty + note);
      }
      lines.push('');
    }

    const csa = _byStore.csa || [];
    if (csa.length > 0) {
      lines.push('FROM CSA BOX');
      for (const item of csa) {
        const qty = item.quantity ? ' (' + item.quantity + ')' : '';
        const note = typeof item.note === 'string' && item.note.trim() ? ' — note: ' + item.note.trim() : '';
        lines.push('✓ ' + item.name + qty + note);
      }
      lines.push('');
    }

    lines.push('TOTAL: ' + fmtPrice(grandTotal));

    const text = lines.join('\n').trim();
    navigator.clipboard.writeText(text).then(() => {
      const btn = document.getElementById('copy-btn');
      const original = btn.innerHTML;
      btn.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg> Copied!';
      btn.classList.add('print-btn--copied');
      setTimeout(() => { btn.innerHTML = original; btn.classList.remove('print-btn--copied'); }, 2000);
    });
  }

  function downloadInstacartCsv() {
    if (!_byStore || !_planId) return;

    const escapeCsv = (value) => {
      const text = String(value ?? '');
      return /[",\n\r]/.test(text) ? '"' + text.replace(/"/g, '""') + '"' : text;
    };
    const rows = [['Item', 'Quantity', 'Store', 'Unit Price', 'Line Total']];
    const storeEntries = Object.entries(_byStore.stores || {})
      .map(([name, items]) => ({ name, items, subtotal: items.reduce((s, i) => s + getGroceryLineCost(i), 0) }))
      .filter(e => e.items && e.items.length > 0)
      .sort((a, b) => b.subtotal - a.subtotal);

    const addItems = (items, bucketName) => {
      for (const item of items || []) {
        const hasLineTotal = hasNumericValue(item && item.line_total);
        const hasUnitPrice = hasNumericValue(item && item.best_price);
        rows.push([
          item && item.name ? String(item.name) : '',
          item && item.quantity ? String(item.quantity) : '',
          bucketName === 'Other' ? 'Other' : (isSupportedAustinStoreName(item && item.best_store) ? String(item.best_store) : bucketName),
          hasUnitPrice ? Number(item.best_price).toFixed(2) : '',
          hasLineTotal || hasUnitPrice ? getGroceryLineCost(item).toFixed(2) : ''
        ].map(escapeCsv));
      }
    };

    for (const entry of storeEntries) addItems(entry.items, entry.name);
    addItems(_byStore.other || [], 'Other');

    const csv = rows.map(row => row.join(',')).join('\n');
    const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.href = url;
    link.download = 'pantry-instacart-list-' + _planId + '.csv';
    document.body.appendChild(link);
    link.click();
    link.remove();
    URL.revokeObjectURL(url);

    const btn = document.getElementById('instacart-btn');
    if (!btn) return;
    const original = btn.innerHTML;
    btn.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg> CSV downloaded';
    btn.classList.add('print-btn--copied');
    setTimeout(() => { btn.innerHTML = original; btn.classList.remove('print-btn--copied'); }, 2000);
  }
</script>

  <% if (!hasPlan) { %>
    <div class="empty-state">
      No plan yet &mdash; generate one on <a href="/planner">/planner</a> to build your grocery list.
    </div>
  <% } else { %>
    <%- include('partials/planner-export-grocery', { byCategory, byStore }) %>
  <% } %>
</body>
</html>
